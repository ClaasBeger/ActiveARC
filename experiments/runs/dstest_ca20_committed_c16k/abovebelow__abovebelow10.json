          "name": "propose_hypotheses",
          "arguments": "{\"hypotheses\":[{\"nl\":\"Gravity down: in each column, all 9s fall to the bottom.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    R=len(g); C=len(g[0])\\n    for c in range(C):\\n        vals=[g[r][c] for r in range(R) if g[r][c]!=0]\\n        for r in range(R): g[r][c]=0\\n        for i,v in enumerate(vals):\\n            g[R-len(vals)+i][c]=v\\n    return g\"},{\"nl\":\"Copy each 9 to the cell directly below it.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    R=len(g); C=len(g[0])\\n    for r in range(R):\\n        for c in range(C):\\n            if grid[r][c]!=0 and r+1<R:\\n                g[r+1][c]=grid[r][c]\\n    return g\"},{\"nl\":\"Copy each 9 to the cell directly to its left.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    R=len(g); C=len(g[0])\\n    for r in range(R):\\n        for c in range(C):\\n            if grid[r][c]!=0 and c-1>=0:\\n                g[r][c-1]=grid[r][c]\\n    return g\"},{\"nl\":\"Copy each 9 to the cell diagonally down-left.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    R=len(g); C=len(g[0])\\n    for r in range(R):\\n        for c in range(C):\\n            if grid[r][c]!=0 and r+1<R and c-1>=0:\\n                g[r+1][c-1]=grid[r][c]\\n    return g\"},{\"nl\":\"Copy each 9 to the cell diagonally down-right.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    R=len(g); C=len(g[0])\\n    for r in range(R):\\n        for c in range(C):\\n            if grid[r][c]!=0 and r+1<R and c+1<C:\\n                g[r+1][c+1]=grid[r][c]\\n    return g\"},{\"nl\":\"For each 9, fill the cell below and the cell to its left (L-shape).\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    R=len(g); C=len(g[0])\\n    for r in range(R):\\n        for c in range(C):\\n            if grid[r][c]!=0:\\n                if r+1<R: g[r+1][c]=grid[r][c]\\n                if c-1>=0: g[r][c-1]=grid[r][c]\\n    return g\"},{\"nl\":\"Copy each 9 to the cell directly below only if that cell is empty.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    R=len(g); C=len(g[0])\\n    for r in range(R):\\n        for c in range(C):\\n            if grid[r][c]!=0 and r+1<R and g[r+1][c]==0:\\n                g[r+1][c]=grid[r][c]\\n    return g\"},{\"nl\":\"For each 9 at (r,c), fill the lower-left rectangle of cells (r'>=r, c'<=c).\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    R=len(g); C=len(g[0])\\n    for r in range(R):\\n        for c in range(C):\\n            if grid[r][c]!=0:\\n                for r2 in range(r,R):\\n                    for c2 in range(0,c+1):\\n                        g[r2][c2]=grid[r][c]\\n    return g\"}]}"
