          "id": "call_01a0c76a50fc76abb971ddd4",
          "name": "propose_hypotheses",
          "arguments": "{\"hypotheses\":[{\"nl\":\"Keep cells that lie in a fully-1 row or a fully-1 column (the cross of all-ones lines).\",\"code\":\"def transform(grid):\\n    R=len(grid); C=len(grid[0])\\n    fr=[r for r in range(R) if all(grid[r][c]==1 for c in range(C))]\\n    fc=[c for c in range(C) if all(grid[r][c]==1 for r in range(R))]\\n    return [[1 if (r in fr or c in fc) else 0 for c in range(C)] for r in range(R)]\"},{\"nl\":\"Output is the union of the all-ones row and the all-ones column, everything else zeroed.\",\"code\":\"def transform(grid):\\n    R=len(grid); C=len(grid[0])\\n    fr=[r for r in range(R) if sum(grid[r])==C]\\n    fc=[c for c in range(C) if sum(grid[r][c] for r in range(R))==R]\\n    out=[[0]*C for _ in range(R)]\\n    for r in fr:\\n        for c in range(C): out[r][c]=1\\n    for c in fc:\\n        for r in range(R): out[r][c]=1\\n    return out\"},{\"nl\":\"Zero out every 1 that is not part of a complete horizontal or vertical line of 1s.\",\"code\":\"def transform(grid):\\n    R=len(grid); C=len(grid[0])\\n    out=[[0]*C for _ in range(R)]\\n    for r in range(R):\\n        for c in range(C):\\n            if grid[r][c]==1 and (all(grid[r][k]==1 for k in range(C)) or all(grid[k][c]==1 for k in range(R))):\\n                out[r][c]=1\\n    return out\"},{\"nl\":\"Find the row with the most 1s and the column with the most 1s and draw their cross.\",\"code\":\"def transform(grid):\\n    R=len(grid); C=len(grid[0])\\n    br=max(range(R), key=lambda r: sum(grid[r]))\\n    bc=max(range(C), key=lambda c: sum(grid[r][c] for r in range(R)))\\n    return [[1 if (r==br or c==bc) else 0 for c in range(C)] for r in range(R)]\"},{\"nl\":\"Keep only the longest horizontal run and longest vertical run of 1s as a cross.\",\"code\":\"def transform(grid):\\n    R=len(grid); C=len(grid[0])\\n    fr=[r for r in range(R) if all(grid[r][c]==1 for c in range(C))]\\n    fc=[c for c in range(C) if all(grid[r][c]==1 for r in range(R))]\\n    out=[[0]*C for _ in range(R)]\\n    for r in range(R):\\n        for c in range(C):\\n            if r in fr or c in fc: out[r][c]=1\\n    return out\"},{\"nl\":\"Output keeps only rows and columns that are entirely 1, filling them completely.\",\"code\":\"def transform(grid):\\n    R=len(grid); C=len(grid[0])\\n    out=[[0]*C for _ in range(R)]\\n    for r in range(R):\\n        if all(grid[r][c]==1 for c in range(C)):\\n            for c in range(C): out[r][c]=1\\n    for c in range(C):\\n        if all(grid[r][c]==1 for r in range(R)):\\n            for r in range(R): out[r][c]=1\\n    return out\"},{\"nl\":\"Keep the single fully-filled row and fully-filled column, zeroing all other cells.\",\"code\":\"def transform(grid):\\n    R=len(grid); C=len(grid[0])\\n    fr=[r for r in range(R) if all(v==1 for v in grid[r])]\\n    fc=[c for c in range(C) if all(grid[r][c]==1 for r in range(R))]\\n    return [[1 if (r in fr or c in fc) else 0 for c in range(C)] for r in range(R)]\"},{\"nl\":\"Remove all 1s except those sharing a row or column with a complete line of 1s.\",\"code\":\"def transform(grid):\\n    R=len(grid); C=len(grid[0])\\n    fr=set(r for r in range(R) if all(grid[r][c]==1 for c in range(C)))\\n    fc=set(c for c in range(C) if all(grid[r][c]==1 for r in range(R)))\\n    return [[grid[r][c] if (r in fr or c in fc) else 0 for c in range(C)] for r in range(R)]\"}]}"
