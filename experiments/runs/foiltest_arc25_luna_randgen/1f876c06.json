          {
            "arguments": "{\"code\":\"import random\\n\\ndef generate(rng):\\n    n = 10\\n    g = [[0]*n for _ in range(n)]\\n    # Create 2-4 pairs of colored endpoints, each pair on a 45-degree diagonal.\\n    colors = rng.sample([2,3,4,5,6,7,8,9], rng.randint(2,4))\\n    occupied = set()\\n    for c in colors:\\n        choices=[]\\n        for r in range(n):\\n            for col in range(n):\\n                for dr,dc in [(1,1),(1,-1)]:\\n                    r2,col2=r+dr*rng.randint(2,5),col+dc*rng.randint(2,5)\\n                    if 0<=r2<n and 0<=col2<n:\\n                        choices.append((r,col,r2,col2))\\n        rng.shuffle(choices)\\n        for r,col,r2,col2 in choices:\\n            if (r,col) not in occupied and (r2,col2) not in occupied:\\n                g[r][col]=c; g[r2][col2]=c\\n                occupied.update([(r,col),(r2,col2)])\\n                break\\n    return g\"}",
