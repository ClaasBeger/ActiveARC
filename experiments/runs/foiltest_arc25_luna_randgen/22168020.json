            "arguments": "{\"code\":\"import random\\n\\ndef generate(rng):\\n    H=W=10\\n    g=[[0]*W for _ in range(H)]\\n    colors=rng.sample([1,2,3,4,5,6,7,8,9], rng.randint(1,3))\\n    # place non-overlapping copies of the characteristic object in varied orientations/locations\\n    for col in colors:\\n        for _ in range(30):\\n            r=rng.randint(0, H-3); c=rng.randint(0,W-4)\\n            cells=[(r,c),(r,c+3),(r+1,c+1),(r+1,c+2),(r+2,c+1),(r+2,c+2)]\\n            if all(g[y][x]==0 for y,x in cells):\\n                for y,x in cells:g[y][x]=col\\n                break\\n    return g\"}",
