[c] for c in range(len(grid[0]))] for r in range(len(grid))]\"},{\"nl\":\"Replace any non-7/3 cell with the column-based stripe value, but only if the cell is in one of the columns that contained an anomaly in the example (columns 1,7,8,9,10,11).\",\"code\":\"def transform(grid):\\n    cols={1,7,8,9,10,11}\\n    return [[(7 if c%2==0 else 3) if (grid[r][c] not in (7,3) and c in cols) else grid[r][c] for c in range(len(grid[0]))] for r in range(len(grid))]\"},{\"nl\":\"Replace any non-7/3 cell with the column-based stripe value, but only if the cell's value is 4 or 5 and it is adjacent (including diagonally) to at least one 7.\",\"code\":\"def transform(grid):\\n    R=len(grid); C=len(grid[0])\\n    out=[row[:] for row in grid]\\n    for r in range(R):\\n        for c in range(C):\\n            if grid[r][c] in (4,5):\\n                adj=False\\n                for dr in (-1,0,1):\\n                    for dc in (-1,0,1):\\n                        if dr==0 and dc==0: continue\\n                        nr,nc=r+dr,c+dc\\n                        if 0<=nr<R and 0<=nc<C and grid[nr][nc]==7:\\n                            adj=True\\n                if adj:\\n                    out[r][c]=7 if c%2==0 else 3\\n    return out\"}]}"
