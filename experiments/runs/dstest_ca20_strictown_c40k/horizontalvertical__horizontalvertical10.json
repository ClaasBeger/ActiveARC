          "arguments": "{\"hypotheses\":[{\"nl\":\"Set the entire top row to 8, leave everything else unchanged.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    if g:\\n        g[0]=[8]*len(g[0])\\n    return g\"},{\"nl\":\"If the grid contains any nonzero cell, set the top row to 8; otherwise leave unchanged.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    if any(v!=0 for row in g for v in row):\\n        g[0]=[8]*len(g[0])\\n    return g\"},{\"nl\":\"If there is a 2-row-tall nonzero object, set the top row to 8.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    h=len(g); w=len(g[0]) if h else 0\\n    rows=[r for r in range(h) if any(g[r][c]!=0 for c in range(w))]\\n    if rows and max(rows)-min(rows)+1==2:\\n        g[0]=[8]*w\\n    return g\"},{\"nl\":\"If there is a nonzero object of width 4, set the top row to 8.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    h=len(g); w=len(g[0]) if h else 0\\n    cols=[c for c in range(w) if any(g[r][c]!=0 for r in range(h))]\\n    if cols and max(cols)-min(cols)+1==4:\\n        g[0]=[8]*w\\n    return g\"},{\"nl\":\"If the nonzero object contains exactly 4 distinct colors, set the top row to 8.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    colors={v for row in g for v in row if v!=0}\\n    if len(colors)==4:\\n        g[0]=[8]*len(g[0])\\n    return g\"},{\"nl\":\"If the topmost nonzero row is row 6, set the top row to 8.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    h=len(g); w=len(g[0]) if h else 0\\n    rows=[r for r in range(h) if any(g[r][c]!=0 for c in range(w))]\\n    if rows and min(rows)==6:\\n        g[0]=[8]*w\\n    return g\"},{\"nl\":\"If the maximum nonzero color is 7, set the top row to 8.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    vals=[v for row in g for v in row if v!=0]\\n    if vals and max(vals)==7:\\n        g[0]=[8]*len(g[0])\\n    return g\"},{\"nl\":\"If the nonzero object has exactly 8 cells, set the top row to 8.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    n=sum(1 for row in g for v in row if v!=0)\\n    if n==8:\\n        g[0]=[8]*len(g[0])\\n    return g\"}]}"
