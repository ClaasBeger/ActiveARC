          "id": "call_01a0c99c054375f0951beb87",
          "name": "propose_hypotheses",
          "arguments": "{\"hypotheses\":[{\"nl\":\"Remove every cell of color 8, regardless of position.\",\"code\":\"def transform(grid):\\n    return [[0 if c==8 else c for c in row] for row in grid]\"},{\"nl\":\"Remove every cell located strictly below the horizontal dashed line of 4s.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    line=None\\n    for r in range(len(g)):\\n        if 4 in g[r]:\\n            line=r; break\\n    if line is None: return g\\n    for r in range(line+1,len(g)):\\n        for c in range(len(g[0])):\\n            g[r][c]=0\\n    return g\"},{\"nl\":\"Remove color 8 only when it lies below the 4-line (keep 8s above the line).\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    line=None\\n    for r in range(len(g)):\\n        if 4 in g[r]:\\n            line=r; break\\n    for r in range(len(g)):\\n        for c in range(len(g[0])):\\n            if g[r][c]==8 and (line is None or r>line):\\n                g[r][c]=0\\n    return g\"},{\"nl\":\"Keep only colors 4 and 5; zero out everything else.\",\"code\":\"def transform(grid):\\n    return [[c if c in (4,5) else 0 for c in row] for row in grid]\"},{\"nl\":\"Remove all cells below the 4-line AND all 8s anywhere.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    line=None\\n    for r in range(len(g)):\\n        if 4 in g[r]:\\n            line=r; break\\n    for r in range(len(g)):\\n        for c in range(len(g[0])):\\n            if g[r][c]==8 or (line is not None and r>line):\\n                g[r][c]=0\\n    return g\"},{\"nl\":\"Remove any color that appears only below the 4-line.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    line=None\\n    for r in range(len(g)):\\n        if 4 in g[r]:\\n            line=r; break\\n    above=set(); below=set()\\n    for r in range(len(g)):\\n        for c in range(len(g[0])):\\n            v=g[r][c]\\n            if v==0: continue\\n            if line is not None and r>line: below.add(v)\\n            else: above.add(v)\\n    rem=below-above\\n    return [[0 if c in rem else c for c in row] for row in grid]\"},{\"nl\":\"Remove connected objects that lie entirely below the 4-line.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    R=len(g); C=len(g[0])\\n    line=None\\n    for r in range(R):\\n        if 4 in g[r]:\\n            line=r; break\\n    if line is None: return g\\n    seen=[[False]*C for _ in range(R)]\\n    for r in range(R):\\n        for c in range(C):\\n            if g[r][c]!=0 and not seen[r][c]:\\n                stack=[(r,c)]; comp=[]; seen[r][c]=True\\n                while stack:\\n                    x,y=stack.pop(); comp.append((x,y))\\n                    for dx,dy in((1,0),(-1,0),(0,1),(0,-1)):\\n                        nx,ny=x+dx,y+dy\\n                        if 0<=nx<R and 0<=ny<C and not seen[nx][ny] and g[nx][ny]==g[r][c]:\\n                            seen[nx][ny]=True; stack.append((nx,ny))\\n                if all(x>line for x,y in comp):\\n                    for x,y in comp: g[x][y]=0\\n    return g\"},{\"nl\":\"Remove the color that appears in the bottom half of the grid (below the 4-line) but not above.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    R=len(g)\\n    line=None\\n    for r in range(R):\\n        if 4 in g[r]:\\n            line=r; break\\n    if line is None: return g\\n    above=set(); below=set()\\n    for r in range(R):\\n        for c in range(len(g[0])):\\n            v=g[r][c]\\n            if v==0: continue\\n            if r>line: below.add(v)\\n            else: above.add(v)\\n    rem=below-above\\n    return [[0 if c in rem else c for c in row] for row in grid]\"}]}"
