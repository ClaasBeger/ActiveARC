          "name": "propose_hypotheses",
          "arguments": "{\"hypotheses\":[{\"nl\":\"Each row is replaced by its most frequent value (mode), tie-break smallest.\",\"code\":\"from collections import Counter\\ndef transform(grid):\\n    out=[]\\n    for row in grid:\\n        c=Counter(row)\\n        m=max(c.values())\\n        val=min(k for k,v in c.items() if v==m)\\n        out.append([val]*len(row))\\n    return out\"},{\"nl\":\"Each row is replaced by the mode of its non-noise values (ignoring 3 and 4).\",\"code\":\"from collections import Counter\\ndef transform(grid):\\n    out=[]\\n    for row in grid:\\n        vals=[x for x in row if x not in (3,4)]\\n        if not vals: vals=row\\n        c=Counter(vals)\\n        m=max(c.values())\\n        val=min(k for k,v in c.items() if v==m)\\n        out.append([val]*len(row))\\n    return out\"},{\"nl\":\"Output is always alternating rows 1,2,1,2,... regardless of input.\",\"code\":\"def transform(grid):\\n    return [[1 if i%2==0 else 2]*len(row) for i,row in enumerate(grid)]\"},{\"nl\":\"Each row is replaced by its median value.\",\"code\":\"def transform(grid):\\n    out=[]\\n    for row in grid:\\n        s=sorted(row)\\n        val=s[len(s)//2]\\n        out.append([val]*len(row))\\n    return out\"},{\"nl\":\"Each row is replaced by the first value that is not 3 or 4.\",\"code\":\"def transform(grid):\\n    out=[]\\n    for row in grid:\\n        val=next((x for x in row if x not in (3,4)), row[0])\\n        out.append([val]*len(row))\\n    return out\"},{\"nl\":\"Each row is replaced by the mode among values 1 and 2 only.\",\"code\":\"from collections import Counter\\ndef transform(grid):\\n    out=[]\\n    for row in grid:\\n        vals=[x for x in row if x in (1,2)]\\n        if not vals: vals=row\\n        c=Counter(vals)\\n        m=max(c.values())\\n        val=min(k for k,v in c.items() if v==m)\\n        out.append([val]*len(row))\\n    return out\"},{\"nl\":\"Each row is replaced by its strict-majority value if one exists, else its mode.\",\"code\":\"from collections import Counter\\ndef transform(grid):\\n    out=[]\\n    for row in grid:\\n        c=Counter(row)\\n        n=len(row)\\n        maj=[k for k,v in c.items() if v>n/2]\\n        if maj:\\n            val=min(maj)\\n        else:\\n            m=max(c.values())\\n            val=min(k for k,v in c.items() if v==m)\\n        out.append([val]*len(row))\\n    return out\"},{\"nl\":\"Each row is replaced by the first value that is not the row maximum.\",\"code\":\"def transform(grid):\\n    out=[]\\n    for row in grid:\\n        mx=max(row)\\n        val=next((x for x in row if x!=mx), row[0])\\n        out.append([val]*len(row))\\n    return out\"}]}"
