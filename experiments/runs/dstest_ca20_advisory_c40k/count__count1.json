          "arguments": "{\"hypotheses\":[{\"nl\":\"Count 4-connected non-zero components; output a 1xN row of 4s.\",\"code\":\"def transform(grid):\\n    h=len(grid); w=len(grid[0])\\n    seen=[[False]*w for _ in range(h)]\\n    n=0\\n    for i in range(h):\\n        for j in range(w):\\n            if grid[i][j]!=0 and not seen[i][j]:\\n                n+=1\\n                st=[(i,j)]; seen[i][j]=True\\n                while st:\\n                    x,y=st.pop()\\n                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\\n                        nx,ny=x+dx,y+dy\\n                        if 0<=nx<h and 0<=ny<w and grid[nx][ny]!=0 and not seen[nx][ny]:\\n                            seen[nx][ny]=True; st.append((nx,ny))\\n    return [[4]*n]\"},{\"nl\":\"Count distinct non-zero colors; output a 1xN row of 4s.\",\"code\":\"def transform(grid):\\n    s=set()\\n    for row in grid:\\n        for c in row:\\n            if c!=0: s.add(c)\\n    return [[4]*len(s)]\"},{\"nl\":\"Count 4-connected components; output a 1xN row of the smallest color not present.\",\"code\":\"def transform(grid):\\n    h=len(grid); w=len(grid[0])\\n    seen=[[False]*w for _ in range(h)]\\n    n=0; s=set()\\n    for i in range(h):\\n        for j in range(w):\\n            if grid[i][j]!=0:\\n                s.add(grid[i][j])\\n                if not seen[i][j]:\\n                    n+=1\\n                    st=[(i,j)]; seen[i][j]=True\\n                    while st:\\n                        x,y=st.pop()\\n                        for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\\n                            nx,ny=x+dx,y+dy\\n                            if 0<=nx<h and 0<=ny<w and grid[nx][ny]!=0 and not seen[nx][ny]:\\n                                seen[nx][ny]=True; st.append((nx,ny))\\n    f=1\\n    while f in s: f+=1\\n    return [[f]*n]\"},{\"nl\":\"Count distinct non-zero colors; output a 1xN row of the smallest color not present.\",\"code\":\"def transform(grid):\\n    s=set()\\n    for row in grid:\\n        for c in row:\\n            if c!=0: s.add(c)\\n    f=1\\n    while f in s: f+=1\\n    return [[f]*len(s)]\"},{\"nl\":\"Count 4-connected components; output a 1xN row of (N-2) where N is the component count.\",\"code\":\"def transform(grid):\\n    h=len(grid); w=len(grid[0])\\n    seen=[[False]*w for _ in range(h)]\\n    n=0\\n    for i in range(h):\\n        for j in range(w):\\n            if grid[i][j]!=0 and not seen[i][j]:\\n                n+=1\\n                st=[(i,j)]; seen[i][j]=True\\n                while st:\\n                    x,y=st.pop()\\n                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\\n                        nx,ny=x+dx,y+dy\\n                        if 0<=nx<h and 0<=ny<w and grid[nx][ny]!=0 and not seen[nx][ny]:\\n                            seen[nx][ny]=True; st.append((nx,ny))\\n    return [[max(n-2,0)]*n]\"},{\"nl\":\"Count distinct non-zero colors; output a 1xN row of (M-2) where M is the distinct color count.\",\"code\":\"def transform(grid):\\n    s=set()\\n    for row in grid:\\n        for c in row:\\n            if c!=0: s.add(c)\\n    return [[max(len(s)-2,0)]*len(s)]\"},{\"nl\":\"Count 4-connected components; output a 1xN row of 4s where N is the number of symmetric components.\",\"code\":\"def transform(grid):\\n    h=len(grid); w=len(grid[0])\\n    seen=[[False]*w for _ in range(h)]\\n    comps=[]\\n    for i in range(h):\\n        for j in range(w):\\n            if grid[i][j]!=0 and not seen[i][j]:\\n                st=[(i,j)]; seen[i][j]=True; cells=[]\\n                while st:\\n                    x,y=st.pop(); cells.append((x,y))\\n                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\\n                        nx,ny=x+dx,y+dy\\n                        if 0<=nx<h and 0<=ny<w and grid[nx][ny]!=0 and not seen[nx][ny]:\\n                            seen[nx][ny]=True; st.append((nx,ny))\\n                comps.append(cells)\\n    def sym(cells):\\n        rs=[r for r,c in cells]; cs=[c for r,c in cells]\\n        r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)\\n        S=set(cells)\\n        hs=all((r,c0+c1-c) in S for r,c in cells)\\n        vs=all((r0+r1-r,c) in S for r,c in cells)\\n        return hs or vs\\n    n=sum(1 for c in comps if sym(c))\\n    return [[4]*n]\"},{\"nl\":\"Output is always a 1x6 row of 4s regardless of input.\",\"code\":\"def transform(grid):\\n    return [[4]*6]\"}]}"
