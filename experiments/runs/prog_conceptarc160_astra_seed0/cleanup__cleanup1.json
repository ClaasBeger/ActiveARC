    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    from collections import Counter\n    h,w=len(grid),len(grid[0])\n    # Find the repeating horizontal or vertical stripe pattern best supported by the intact cells.\n    candidates=[]\n    for axis in (0,1):\n        n=h if axis==0 else w\n        for period in range(1,n+1):\n            groups=[Counter() for _ in range(period)]\n            for r in range(h):\n                for c in range(w):\n                    groups[(r if axis==0 else c)%period][grid[r][c]]+=1\n            vals=[g.most_common(1)[0][0] for g in groups]\n            out=[[vals[(r if axis==0 else c)%period] for c in range(w)] for r in range(h)]\n            errors=sum(out[r][c]!=grid[r][c] for r in range(h) for c in range(w))\n            candidates.append((errors+0.15*period,period,out))\n    return min(candidates,key=lambda x:(x[0],x[1]))[2]",
