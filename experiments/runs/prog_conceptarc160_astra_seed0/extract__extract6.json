        "output": [
          {
            "arguments": "{\"code\":\"from collections import Counter\\n\\ndef transform(grid):\\n    h,w=len(grid),len(grid[0])\\n    def extract(g):\\n        H,W=len(g),len(g[0])\\n        colors=set(sum(g,[]))\\n        candidates=[]\\n        for c in colors:\\n            pts=[(r,k) for r in range(H) for k in range(W) if g[r][k]==c]\\n            a,b=min(r for r,k in pts),max(r for r,k in pts)\\n            l,t=min(k for r,k in pts),max(k for r,k in pts)\\n            if b-a<2 or t-l<2: continue\\n            if all(g[r][k]==c for r in range(a,b+1) for k in range(l,t+1) if r in (a,b) or k in (l,t)) and len(set(g[r][k] for r in range(a+1,b) for k in range(l+1,t)))==1 and g[a+1][l+1]!=c:\\n                candidates.append(( (b-a+1)*(t-l+1),a,b,l,t,c))\\n        if candidates:\\n            _,a,b,l,t,c=min(candidates)\\n        else:\\n            edge=[g[r][k] for r in range(H) for k in range(W) if r in (0,H-1) or k in (0,W-1)]\\n            bg=Counter(edge).most_common(1)[0][0]\\n            pts=[(r,k) for r in range(H) for k in range(W) if g[r][k]!=bg]\\n            a,b=min(r for r,k in pts),max(r for r,k in pts)\\n            l,t=min(k for r,k in pts),max(k for r,k in pts)\\n            c=g[pts[0][0]][pts[0][1]]\\n        return [[g[r][k] if g[r][k]==c else 0 for k in range(l,t+1)] for r in range(a,b+1)]\\n    for vertical in (True,False):\\n        g=grid if vertical else list(map(list,zip(*grid)))\\n        H,W=len(g),len(g[0])\\n        for j in range(1,W-1):\\n            c=g[0][j]\\n            if not all(row[j]==c for row in g):continue\\n            if any(row[k]==c for row in g for k in range(W) if k!=j):continue\\n            left=[row[:j] for row in g];right=[row[j+1:] for row in g]\\n            if len(set(sum(left,[])))<2 or len(set(sum(right,[])))<2:continue\\n            a,b=extract(left),extract(right)\\n            out=[x+y for x,y in zip(a,b)]\\n            return out if vertical else list(map(list,zip(*out)))\\n    return grid\"}",
