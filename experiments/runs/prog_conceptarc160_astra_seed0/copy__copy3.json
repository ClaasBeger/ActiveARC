    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    pts=[(r,c,grid[r][c]) for r in range(h) for c in range(w) if grid[r][c]]\n    best=None\n    for color in set(p[2] for p in pts):\n        anchors=[p for p in pts if p[2]==color]\n        other=[p for p in pts if p[2]!=color]\n        if len(anchors)<2 or not other: continue\n        for a in anchors:\n            src=other+[a]\n            r0=min(p[0] for p in src); r1=max(p[0] for p in src)\n            c0=min(p[1] for p in src); c1=max(p[1] for p in src)\n            targets=[p for p in anchors if p!=a]\n            if any(r0<=p[0]<=r1 and c0<=p[1]<=c1 for p in targets): continue\n            area=(r1-r0+1)*(c1-c0+1)\n            dist=sum(abs(a[0]-p[0])+abs(a[1]-p[1]) for p in other)\n            score=(area,dist)\n            if best is None or score<best[0]: best=(score,src,a,targets)\n    out=[row[:] for row in grid]\n    if best:\n        _,src,a,targets=best\n        for t in targets:\n            dr,dc=t[0]-a[0],t[1]-a[1]\n            for r,c,v in src:\n                rr,cc=r+dr,c+dc\n                if 0<=rr<h and 0<=cc<w: out[rr][cc]=v\n    return out",
