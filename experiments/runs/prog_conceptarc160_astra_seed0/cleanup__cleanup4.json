    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[[0]*w for _ in range(h)]\n    colors=set(v for row in grid for v in row)-{0}\n    for c in colors:\n        cells={(r,s) for r in range(h) for s in range(w) if grid[r][s]==c}\n        groups=[cells]\n        unseen=set(cells)\n        while unseen:\n            p=unseen.pop(); comp={p}; stack=[p]\n            while stack:\n                r,s=stack.pop()\n                for q in ((r-1,s),(r+1,s),(r,s-1),(r,s+1)):\n                    if q in unseen:\n                        unseen.remove(q);comp.add(q);stack.append(q)\n            groups.append(comp)\n        boxes=set()\n        for comp in groups:\n            if len(comp)<5: continue\n            a=min(r for r,s in comp);b=max(r for r,s in comp)\n            l=min(s for r,s in comp);t=max(s for r,s in comp)\n            if b-a<2 or t-l<2: continue\n            border={(r,s) for r in range(a,b+1) for s in range(l,t+1) if r in (a,b) or s in (l,t)}\n            n=len(border & cells)\n            if n < .65*len(border): continue\n            if any(a<r<b and l<s<t for r,s in cells): continue\n            boxes.add((a,b,l,t))\n        for a,b,l,t in boxes:\n            for r in range(a,b+1):\n                for s in range(l,t+1):\n                    if r in (a,b) or s in (l,t): out[r][s]=c\n    return out",
