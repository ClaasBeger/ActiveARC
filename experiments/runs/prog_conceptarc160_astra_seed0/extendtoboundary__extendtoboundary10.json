            "arguments": "{\"code\":\"def transform(grid):\\n    from collections import Counter\\n    h,w=len(grid),len(grid[0])\\n    out=[r[:] for r in grid]\\n    counts=Counter(v for row in grid for v in row if v)\\n    if not counts: return out\\n    wall=counts.most_common(1)[0][0]\\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==wall]\\n    top=min(r for r,c in pts); bottom=max(r for r,c in pts)\\n    left=min(c for r,c in pts); right=max(c for r,c in pts)\\n    for r in range(h):\\n        for c in range(w):\\n            color=grid[r][c]\\n            if not color or color==wall: continue\\n            dr=dc=0\\n            if c<left and top<=r<=bottom: dc=1\\n            elif c>right and top<=r<=bottom: dc=-1\\n            elif r<top and left<=c<=right: dr=1\\n            elif r>bottom and left<=c<=right: dr=-1\\n            if dr==dc==0: continue\\n            rr,cc=r+dr,c+dc\\n            while 0<=rr<h and 0<=cc<w and grid[rr][cc]!=wall:\\n                out[rr][cc]=color\\n                rr+=dr;cc+=dc\\n    return out\"}",
