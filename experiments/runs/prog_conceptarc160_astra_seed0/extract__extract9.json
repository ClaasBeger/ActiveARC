    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    colors={v for row in grid for v in row if v!=0}\n    boxes={}\n    for v in colors:\n        pts=[(r,c) for r,row in enumerate(grid) for c,x in enumerate(row) if x==v]\n        boxes[v]=(min(r for r,c in pts),max(r for r,c in pts),min(c for r,c in pts),max(c for r,c in pts))\n    outer=max(colors,key=lambda v:(boxes[v][1]-boxes[v][0]+1)*(boxes[v][3]-boxes[v][2]+1))\n    pts=[(r,c) for r,row in enumerate(grid) for c,x in enumerate(row) if x!=0 and x!=outer]\n    if not pts: return [row[:] for row in grid]\n    a,b=min(r for r,c in pts),max(r for r,c in pts)\n    l,h=min(c for r,c in pts),max(c for r,c in pts)\n    return [[0 if grid[r][c]==outer else grid[r][c] for c in range(l,h+1)] for r in range(a,b+1)]",
