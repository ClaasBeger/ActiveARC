          {
            "arguments": "{\"code\":\"def transform(grid):\\n    from collections import defaultdict\\n    h,w=len(grid),len(grid[0])\\n    seen=set(); shapes=defaultdict(list)\\n    for r in range(h):\\n        for c in range(w):\\n            if not grid[r][c] or (r,c) in seen: continue\\n            color=grid[r][c]; todo=[(r,c)]; seen.add((r,c)); pts=[]\\n            while todo:\\n                x,y=todo.pop(); pts.append((x,y))\\n                for a,b in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):\\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==color:\\n                        seen.add((a,b)); todo.append((a,b))\\n            x0=min(x for x,y in pts); y0=min(y for x,y in pts)\\n            key=tuple(sorted((x-x0,y-y0) for x,y in pts))\\n            shapes[key].append(pts)\\n    out=[[0]*w for _ in range(h)]\\n    for group in shapes.values():\\n        if len(group)>1:\\n            for pts in group:\\n                for x,y in pts: out[x][y]=grid[x][y]\\n    return out\"}",
