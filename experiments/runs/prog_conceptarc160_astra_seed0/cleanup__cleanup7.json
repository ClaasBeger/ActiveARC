    "program_source": "def transform(grid):\n from collections import Counter\n h=len(grid); w=len(grid[0]); out=[[0 if x==8 else x for x in row] for row in grid]\n seen=set(); comps=[]\n for r in range(h):\n  for c in range(w):\n   if grid[r][c] in (0,8) or (r,c) in seen: continue\n   color=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); pts=[]\n   while stack:\n    a,b=stack.pop(); pts.append((a,b))\n    for x,y in ((a-1,b),(a+1,b),(a,b-1),(a,b+1)):\n     if 0<=x<h and 0<=y<w and (x,y) not in seen and grid[x][y]==color:\n      seen.add((x,y)); stack.append((x,y))\n   ar=min(a for a,b in pts); ac=min(b for a,b in pts)\n   shape=tuple(sorted((a-ar,b-ac) for a,b in pts)); comps.append((color,shape,pts))\n if not comps:return out\n counts=Counter((color,shape) for color,shape,pts in comps)\n color,shape=max(counts,key=lambda k:(len(k[1]),counts[k]))\n sh=set(shape); bh=max(a for a,b in shape)+1; bw=max(b for a,b in shape)+1\n candidates=[]\n for r in range(h-bh+1):\n  for c in range(w-bw+1):\n   good=True; visible=0; hidden=[]\n   for a in range(bh):\n    for b in range(bw):\n     v=grid[r+a][c+b]; expected=color if (a,b) in sh else 0\n     if v!=8 and v!=expected:good=False\n     if expected and v==color:visible+=1\n     if expected and v==8:hidden.append((r+a,c+b))\n   if good and visible and hidden:\n    candidates.append((visible,hidden))\n for _,hidden in sorted(candidates,reverse=True):\n  for r,c in hidden:out[r][c]=color\n return out",
