    "program_source": "def transform(grid):\n    from collections import deque\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    # Each color bounds regions; invert their interiors while retaining outlines.\n    for color in set(sum(grid,[]))-{0}:\n        outside=set()\n        q=deque()\n        for r in range(-1,h+1):\n            for c in (-1,w):\n                outside.add((r,c)); q.append((r,c))\n        for c in range(w):\n            for r in (-1,h):\n                outside.add((r,c)); q.append((r,c))\n        while q:\n            r,c=q.popleft()\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                a,b=r+dr,c+dc\n                if 0<=a<h and 0<=b<w and (a,b) not in outside and grid[a][b]!=color:\n                    outside.add((a,b)); q.append((a,b))\n        shape={(r,c) for r in range(h) for c in range(w) if (r,c) not in outside}\n        for r,c in shape:\n            if all((r+dr,c+dc) in shape for dr,dc in ((1,0),(-1,0),(0,1),(0,-1))):\n                out[r][c]=0 if grid[r][c]==color else color\n    return out",
