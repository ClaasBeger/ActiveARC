    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    h=len(grid); w=len(grid[0])\n    colors=set(v for row in grid for v in row)-{0,9}\n    for color in colors:\n        pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==color]\n        if not pts: continue\n        r0=min(r for r,c in pts); r1=max(r for r,c in pts)\n        c0=min(c for r,c in pts); c1=max(c for r,c in pts)\n        for r in range(r0,r1+1):\n            vals=grid[r][c0:c1+1]\n            if color in vals and all(v in (color,9) for v in vals):\n                for c in range(c0,c1+1):\n                    if grid[r][c]==9: out[r][c]=color\n        for c in range(c0,c1+1):\n            vals=[grid[r][c] for r in range(r0,r1+1)]\n            if color in vals and all(v in (color,9) for v in vals):\n                for r in range(r0,r1+1):\n                    if grid[r][c]==9: out[r][c]=color\n    return out",
