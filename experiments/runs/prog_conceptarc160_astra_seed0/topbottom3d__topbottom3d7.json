    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    candidates=[]\n    for axis in (0,1):\n        lines=([list(grid[r]) for r in range(h)] if axis==0 else [[grid[r][c] for r in range(h)] for c in range(w)])\n        colors=set(v for line in lines for v in line if v!=0)\n        for color in colors:\n            full=sum(all(v==color for v in line) for line in lines)\n            if full:\n                relevant=[line for line in lines if color in line]\n                purity=sum(line.count(color)/len(line) for line in relevant)/len(relevant)\n                candidates.append((purity,full,axis,color))\n    if not candidates:\n        return out\n    _,_,axis,color=max(candidates)\n    if axis==1:\n        for c in range(w):\n            if any(grid[r][c]==color for r in range(h)):\n                for r in range(h): out[r][c]=color\n    else:\n        for r in range(h):\n            if color in grid[r]: out[r]=[color]*w\n    return out",
