    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            color=grid[r][c]\n            if color==0 or (r,c) in seen: continue\n            stack=[(r,c)]; seen.add((r,c)); cells=[]\n            while stack:\n                y,x=stack.pop(); cells.append((y,x))\n                for yy,xx in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                    if 0<=yy<h and 0<=xx<w and (yy,xx) not in seen and grid[yy][xx]==color:\n                        seen.add((yy,xx)); stack.append((yy,xx))\n            a,b=min(y for y,x in cells),max(y for y,x in cells)\n            l,t=min(x for y,x in cells),max(x for y,x in cells)\n            if len(cells)<(b-a+1)*(t-l+1):\n                return [[color]]\n    return [[0]]",
