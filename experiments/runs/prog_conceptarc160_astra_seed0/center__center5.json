            "arguments": "{\"code\":\"def transform(grid):\\n    out=[row[:] for row in grid]\\n    h,w=len(grid),len(grid[0])\\n    seen=set()\\n    for r in range(h):\\n        for c in range(w):\\n            if not grid[r][c] or (r,c) in seen: continue\\n            comp={(r,c)}; seen.add((r,c)); todo=[(r,c)]\\n            while todo:\\n                y,x=todo.pop()\\n                for dy,dx in [(1,0),(-1,0),(0,1),(0,-1)]:\\n                    a,b=y+dy,x+dx\\n                    if 0<=a<h and 0<=b<w and grid[a][b] and (a,b) not in seen:\\n                        seen.add((a,b));comp.add((a,b));todo.append((a,b))\\n            colors={grid[y][x] for y,x in comp}\\n            candidates=[]\\n            for color in colors:\\n                pts=[(y,x) for y,x in comp if grid[y][x]==color]\\n                if len(pts)>1 and (len({y for y,x in pts})==1 or len({x for y,x in pts})==1):\\n                    candidates.append((len(pts),color,pts))\\n            if not candidates: continue\\n            _,color,pts=max(candidates)\\n            rest=[(y,x) for y,x in comp if grid[y][x]!=color]\\n            if not rest: continue\\n            vertical=len({x for y,x in pts})==1\\n            axis=0 if vertical else 1\\n            mid=(min(p[axis] for p in pts)+max(p[axis] for p in pts))//2\\n            old=(min(p[axis] for p in rest)+max(p[axis] for p in rest))//2\\n            for y,x in rest: out[y][x]=0\\n            for y,x in rest:\\n                a,b=(y+mid-old,x) if vertical else (y,x+mid-old)\\n                if 0<=a<h and 0<=b<w: out[a][b]=grid[y][x]\\n    return out\"}",
