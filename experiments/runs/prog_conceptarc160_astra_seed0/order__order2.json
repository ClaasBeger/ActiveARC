    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    seen=set(); sizes=[]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] and (r,c) not in seen:\n                stack=[(r,c)]; seen.add((r,c)); n=0\n                while stack:\n                    a,b=stack.pop(); n+=1\n                    for x,y in ((a-1,b),(a+1,b),(a,b-1),(a,b+1)):\n                        if 0<=x<h and 0<=y<w and grid[x][y] and (x,y) not in seen:\n                            seen.add((x,y)); stack.append((x,y))\n                sizes.append(n)\n    out=[[0]*w for _ in range(h)]\n    for c,n in enumerate(sorted(sizes)):\n        for r in range(h-n,h):\n            out[r][c]=5\n    return out",
