    "program_source": "def transform(grid):\n    from collections import Counter\n    h,w=len(grid),len(grid[0])\n    best=None\n    for a in range(h):\n      for b in range(a+2,h):\n       for c in range(w):\n        for d in range(c+2,w):\n         pts=[(a,x) for x in range(c,d+1)]+[(b,x) for x in range(c,d+1)]+[(y,c) for y in range(a+1,b)]+[(y,d) for y in range(a+1,b)]\n         vals=[grid[y][x] for y,x in pts]\n         if 0 in vals: continue\n         counts=Counter(vals)\n         color,n=counts.most_common(1)[0]\n         score=len(pts)\n         if best is None or score>best[0]: best=(score,pts,color)\n    out=[[0]*w for _ in range(h)]\n    if best:\n      for y,x in best[1]: out[y][x]=best[2]\n    return out",
