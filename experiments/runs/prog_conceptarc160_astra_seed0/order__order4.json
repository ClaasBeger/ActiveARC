    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    seen=set(); objects=[]\n    for r in range(h):\n        for c in range(w):\n            if not grid[r][c] or (r,c) in seen: continue\n            color=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); pts=[]\n            while stack:\n                y,x=stack.pop(); pts.append((y,x))\n                for yy,xx in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                    if 0<=yy<h and 0<=xx<w and (yy,xx) not in seen and grid[yy][xx]==color:\n                        seen.add((yy,xx)); stack.append((yy,xx))\n            y0=min(y for y,x in pts); y1=max(y for y,x in pts)\n            x0=min(x for y,x in pts); x1=max(x for y,x in pts)\n            holes=[(y,x) for y in range(y0,y1+1) for x in range(x0,x1+1) if grid[y][x]==0]\n            objects.append((y0,y1,x0,x1,color,holes))\n    objects.sort(key=lambda o:o[2])\n    ordered=sorted(objects,key=lambda o:max((y for y,x in o[5]),default=-1),reverse=True)\n    out=[[0]*w for _ in range(h)]\n    for target,source in zip(objects,ordered):\n        y0,y1,x0,x1=target[:4]\n        for y in range(y0,y1+1):\n            for x in range(x0,x1+1): out[y][x]=source[4]\n    return out",
