    "program_source": "def transform(grid):\n    from collections import Counter\n    h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]; seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]!=0 or (r,c) in seen: continue\n            seen.add((r,c)); cells=[(r,c)]; boundary=[]; edge=False\n            for x,y in cells:\n                if x==0 or y==0 or x==h-1 or y==w-1: edge=True\n                for a,b in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):\n                    if 0<=a<h and 0<=b<w:\n                        if grid[a][b]: boundary.append(grid[a][b])\n                        elif (a,b) not in seen: seen.add((a,b)); cells.append((a,b))\n            if not edge and boundary:\n                color=Counter(boundary).most_common(1)[0][0]\n                for x,y in cells: out[x][y]=color\n    return out",
