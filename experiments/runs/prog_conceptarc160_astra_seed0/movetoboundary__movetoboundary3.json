    "program_source": "def transform(grid):\n    h=len(grid); w=len(grid[0])\n    out=[[0]*w for _ in range(h)]\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            comp=[(r,c)]; seen.add((r,c))\n            for y,x in comp:\n                for a,b in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                    if 0<=a<h and 0<=b<w and grid[a][b]!=0 and (a,b) not in seen:\n                        seen.add((a,b)); comp.append((a,b))\n            shift=w-1-max(x for y,x in comp)\n            for y,x in comp: out[y][x+shift]=grid[y][x]\n    return out",
