    "program_source": "def transform(grid):\n    from collections import Counter\n    h,w=len(grid),len(grid[0]); seen=set(); objs=[]\n    for r in range(h):\n        for c in range(w):\n            if not grid[r][c] or (r,c) in seen: continue\n            color=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); cells=[]\n            while stack:\n                x,y=stack.pop(); cells.append((x,y))\n                for a,b in ((x+1,y),(x-1,y),(x,y+1),(x,y-1)):\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==color:\n                        seen.add((a,b)); stack.append((a,b))\n            mr=min(x for x,y in cells); mc=min(y for x,y in cells)\n            key=tuple(sorted((x-mr,y-mc) for x,y in cells))\n            objs.append((cells,key))\n    counts=Counter(k for cells,k in objs)\n    out=[row[:] for row in grid]\n    for cells,k in objs:\n        if counts[k]==1:\n            for x,y in cells: out[x][y]=0\n    return out",
