    "verifier_slot": "custom",
    "program_source": "from collections import Counter\n\ndef transform(grid):\n    h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\n    seen=set(); comps=[]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            q=[(r,c)]; seen.add((r,c))\n            for y,x in q:\n                for yy,xx in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                    if 0<=yy<h and 0<=xx<w and grid[yy][xx]!=0 and (yy,xx) not in seen:\n                        seen.add((yy,xx)); q.append((yy,xx))\n            counts=Counter(grid[y][x] for y,x in q)\n            comps.append((q,counts,min(y for y,x in q),min(x for y,x in q),max(y for y,x in q),max(x for y,x in q)))\n    sources=[a for a in comps if len(a[1])>1]\n    for q,counts,y0,x0,y1,x1 in comps:\n        if len(counts)!=1: continue\n        for sq,sc,sy,sx,ey,ex in sources:\n            if ey-sy!=y1-y0 or ex-sx!=x1-x0: continue\n            base=sc.most_common(1)[0][0]\n            for y,x in sq:\n                if grid[y][x]!=base:\n                    out[y0+y-sy][x0+x-sx]=grid[y][x]\n            break\n    return out",
