            "arguments": "{\"code\":\"def transform(grid):\\n h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\\n seen=set(); comps=[]\\n for r in range(h):\\n  for c in range(w):\\n   if grid[r][c]==0 or (r,c) in seen: continue\\n   color=grid[r][c]; pts={(r,c)}; seen.add((r,c)); stack=[(r,c)]\\n   while stack:\\n    x,y=stack.pop()\\n    for a,b in [(x+1,y),(x-1,y),(x,y+1),(x,y-1)]:\\n     if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==color:\\n      seen.add((a,b));pts.add((a,b));stack.append((a,b))\\n   comps.append((color,pts))\\n for i,(col,pts) in enumerate(comps):\\n  adjacent=[]\\n  for j,(col2,pts2) in enumerate(comps):\\n   if col2==col: continue\\n   if any((a+dx,b+dy) in pts2 for a,b in pts for dx,dy in [(1,0),(-1,0),(0,1),(0,-1)]): adjacent.append(pts2)\\n  if not adjacent: continue\\n  x=min(a for a,b in pts); y=min(b for a,b in pts)\\n  norm={(a-x,b-y) for a,b in pts}\\n  for j,(col2,pts2) in enumerate(comps):\\n   if i==j or col2!=col: continue\\n   xx=min(a for a,b in pts2); yy=min(b for a,b in pts2)\\n   if {(a-xx,b-yy) for a,b in pts2}!=norm: continue\\n   dx,dy=xx-x,yy-y\\n   for region in adjacent:\\n    for a,b in region:\\n     aa,bb=a+dx,b+dy\\n     if 0<=aa<h and 0<=bb<w and out[aa][bb]==0: out[aa][bb]=grid[a][b]\\n return out\"}",
