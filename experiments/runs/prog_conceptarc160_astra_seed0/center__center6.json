    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    from collections import Counter\n    h,w=len(grid),len(grid[0])\n    counts=Counter(v for row in grid for v in row if v)\n    out=[row[:] for row in grid]\n    if not counts: return out\n    shape=max(counts,key=counts.get)\n    movers=[(r,c,grid[r][c]) for r in range(h) for c in range(w) if grid[r][c] and grid[r][c]!=shape]\n    def same(r,c): return 0<=r<h and 0<=c<w and grid[r][c]==shape\n    targets=[]\n    for r in range(h):\n        for c in range(w):\n            if not same(r,c): continue\n            for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:\n                ar,ac=dr+dc,dc+dr\n                br,bc=dr-dc,dc-dr\n                if same(r+ar,c+ac) and same(r+br,c+bc):\n                    rr,cc=r+dr,c+dc\n                    if 0<=rr<h and 0<=cc<w and grid[rr][cc]!=shape:\n                        targets.append((rr,cc))\n    if targets and movers:\n        for r,c,v in movers: out[r][c]=0\n        for i,(r,c,v) in enumerate(movers):\n            rr,cc=targets[min(i,len(targets)-1)]\n            out[rr][cc]=v\n    return out",
