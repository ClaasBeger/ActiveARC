    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0]); out=[row[:] for row in grid]\n    seen=set()\n    comps=[]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            color=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); comp=[]\n            while stack:\n                y,x=stack.pop(); comp.append((y,x))\n                for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n                    a,b=y+dy,x+dx\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==color:\n                        seen.add((a,b)); stack.append((a,b))\n            comps.append(comp)\n    for comp in comps:\n        if len(comp)!=1: continue\n        r,c=comp[0]; color=grid[r][c]\n        for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n            y,x=r+dy,c+dx\n            while 0<=y<h and 0<=x<w and grid[y][x]==0:\n                out[y][x]=color; y+=dy; x+=dx\n    return out",
