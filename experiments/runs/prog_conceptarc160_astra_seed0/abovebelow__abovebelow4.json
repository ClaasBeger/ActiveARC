    "program_source": "def transform(grid):\n    out=[row[:] for row in grid]\n    h=len(grid); w=len(grid[0])\n    lines=[r for r in range(h) if all(x==9 for x in grid[r])]\n    if not lines:\n        lines=[r for r in range(h) if grid[r][0]!=0 and len(set(grid[r]))==1]\n    if not lines: return out\n    mid=lines[0]; color=grid[mid][0]\n    for r,row in enumerate(grid):\n        if r==mid: continue\n        c=0\n        while c<w:\n            if row[c]==0:\n                c+=1; continue\n            start=c; val=row[c]\n            while c<w and row[c]==val: c+=1\n            out[r][start if r<mid else c-1]=color\n    return out",
