    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    frames=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v==5]\n    obj=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v not in (0,5)]\n    if not frames or not obj: return out\n    t=min(r for r,c in frames); b=max(r for r,c in frames)\n    l=min(c for r,c in frames); q=max(c for r,c in frames)\n    a=min(r for r,c in obj); z=max(r for r,c in obj)\n    x=min(c for r,c in obj); y=max(c for r,c in obj)\n    nr=t+(b-t+1-(z-a+1))//2\n    nc=l+(q-l+1-(y-x+1))//2\n    for r,c in obj:\n        out[nr+r-a][nc+c-x]=grid[r][c]\n    return out",
