    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    h=len(grid); w=len(grid[0]); seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            color=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); pts=[]\n            while stack:\n                y,x=stack.pop(); pts.append((y,x))\n                for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n                    yy,xx=y+dy,x+dx\n                    if 0<=yy<h and 0<=xx<w and (yy,xx) not in seen and grid[yy][xx]==color:\n                        seen.add((yy,xx)); stack.append((yy,xx))\n            y0=min(y for y,x in pts); y1=max(y for y,x in pts)\n            x0=min(x for y,x in pts); x1=max(x for y,x in pts)\n            fill=7 if x1-x0>y1-y0 else 3\n            for y in range(y0+1,y1):\n                for x in range(x0+1,x1):\n                    if grid[y][x]==0: out[y][x]=fill\n    return out",
