    "program_source": "def transform(grid):\n    h=len(grid); w=len(grid[0])\n    bars=[c for c in range(w) if all(grid[r][c]==3 for r in range(h))]\n    panels=[[row[a+1:b] for row in grid] for a,b in zip(bars,bars[1:])]\n    panels.sort(key=lambda p:sum(v==4 for row in p for v in row))\n    out=[row[:] for row in grid]\n    for (a,b),p in zip(zip(bars,bars[1:]),panels):\n        for r in range(h): out[r][a+1:b]=p[r]\n    return out",
