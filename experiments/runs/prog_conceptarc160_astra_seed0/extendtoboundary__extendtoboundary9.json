    "program_source": "def transform(grid):\n    out=[row[:] for row in grid]\n    h=len(grid); w=len(grid[0])\n    # Extend yellow cells in the cardinal directions until meeting the frame.\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==4:\n                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                    rr,cc=r+dr,c+dc\n                    while 0<=rr<h and 0<=cc<w and grid[rr][cc] in (0,4):\n                        out[rr][cc]=4\n                        rr+=dr; cc+=dc\n    return out",
