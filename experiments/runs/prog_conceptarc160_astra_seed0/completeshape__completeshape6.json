    "program_source": "def transform(grid):\n    h=len(grid); w=len(grid[0]); out=[r[:] for r in grid]; seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            col=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); pts=[]\n            while stack:\n                y,x=stack.pop(); pts.append((y,x))\n                for yy,xx in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                    if 0<=yy<h and 0<=xx<w and (yy,xx) not in seen and grid[yy][xx]==col:\n                        seen.add((yy,xx)); stack.append((yy,xx))\n            for y in range(min(p[0] for p in pts),max(p[0] for p in pts)+1):\n                for x in range(min(p[1] for p in pts),max(p[1] for p in pts)+1):\n                    out[y][x]=col\n    return out",
