    "program_source": "def transform(grid):\n    out=[row[:] for row in grid]\n    h=len(grid); w=len(grid[0])\n    colors=set(v for row in grid for v in row)-{0}\n    if not colors: return out\n    def frame_score(c):\n        pts=[(r,k) for r in range(h) for k in range(w) if grid[r][k]==c]\n        a=min(r for r,k in pts); b=max(r for r,k in pts); l=min(k for r,k in pts); t=max(k for r,k in pts)\n        if a==b or l==t: return -1\n        return sum(r in (a,b) or k in (l,t) for r,k in pts)/(2*(b-a+t-l))\n    c=max(colors,key=frame_score)\n    pts=[(r,k) for r in range(h) for k in range(w) if grid[r][k]==c]\n    a=min(r for r,k in pts); b=max(r for r,k in pts); l=min(k for r,k in pts); t=max(k for r,k in pts)\n    for r in range(h):\n        for k in range(w):\n            if not (a<=r<=b and l<=k<=t): out[r][k]=0\n            elif r in (a,b) or k in (l,t): out[r][k]=c\n    return out",
