    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    runs=[]\n    i=0\n    while i<len(grid):\n        if any(grid[i]):\n            j=i+1\n            while j<len(grid) and any(grid[j]): j+=1\n            runs.append((i,j,grid[i:j]))\n            i=j\n        else: i+=1\n    if not runs: return out\n    blocks=sorted((b for _,_,b in runs),key=len,reverse=True)\n    result=grid[:runs[0][0]]\n    for k,b in enumerate(blocks):\n        result+=b\n        if k+1<len(runs): result+=grid[runs[k][1]:runs[k+1][0]]\n    result+=grid[runs[-1][1]:]\n    return [r[:] for r in result]",
