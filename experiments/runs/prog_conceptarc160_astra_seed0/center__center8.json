    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[row[:] for row in grid]\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]!=8 or (r,c) in seen: continue\n            stack=[(r,c)]; seen.add((r,c)); pts=[]\n            while stack:\n                a,b=stack.pop(); pts.append((a,b))\n                for x,y in ((a-1,b),(a+1,b),(a,b-1),(a,b+1)):\n                    if 0<=x<h and 0<=y<w and grid[x][y]==8 and (x,y) not in seen:\n                        seen.add((x,y)); stack.append((x,y))\n            marks=set()\n            for a,b in pts:\n                for x,y in ((a-1,b),(a+1,b),(a,b-1),(a,b+1)):\n                    if 0<=x<h and 0<=y<w and grid[x][y]==2: marks.add((x,y))\n            if not marks: continue\n            for a,b in marks: out[a][b]=0\n            r0=min(a for a,b in pts); r1=max(a for a,b in pts)\n            c0=min(b for a,b in pts); c1=max(b for a,b in pts)\n            a=(r0+r1)//2; b=(c0+c1)//2\n            offsets=((0,-1),(0,0),(0,1)) if r1>r0 else ((-1,0),(0,0),(1,0))\n            for dr,dc in offsets:\n                x,y=a+dr,b+dc\n                if 0<=x<h and 0<=y<w: out[x][y]=2\n    return out",
