    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==7]\n    out=[[0]*w for _ in range(h)]\n    if not pts: return out\n    top=min(r for r,c in pts); bottom=max(r for r,c in pts)\n    left=min(c for r,c in pts); right=max(c for r,c in pts)\n    for r in range(top,bottom+1):\n        for c in range(left,right+1):\n            if grid[r][c]!=7: out[r][c]=grid[r][c]\n    return out",
