    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    candidates=[]\n    for r in range(h-2):\n        for c in range(w-2):\n            color=grid[r][c]\n            if color==0: continue\n            for b in range(r+2,h):\n                if any(grid[y][c]!=color for y in range(r,b+1)): break\n                for d in range(c+2,w):\n                    if all(grid[r][x]==color and grid[b][x]==color for x in range(c,d+1)) and all(grid[y][d]==color for y in range(r,b+1)):\n                        candidates.append(((b-r+1)*(d-c+1),r,c,b,d))\n    if not candidates: return [row[:] for row in grid]\n    _,r,c,b,d=max(candidates)\n    return [row[c+1:d] for row in grid[r+1:b]]",
