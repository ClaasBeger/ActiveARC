    "program_source": "def transform(grid):\n h,w=len(grid),len(grid[0]); seen=set(); comps=[]\n for r in range(h):\n  for c in range(w):\n   if grid[r][c]==0 or (r,c) in seen: continue\n   comp=[]; stack=[(r,c)]; seen.add((r,c))\n   while stack:\n    y,x=stack.pop(); comp.append((y,x))\n    for a,b in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n     if 0<=a<h and 0<=b<w and grid[a][b]!=0 and (a,b) not in seen:\n      seen.add((a,b)); stack.append((a,b))\n   comps.append(comp)\n def box(p): return min(y for y,x in p),max(y for y,x in p),min(x for y,x in p),max(x for y,x in p)\n frames=[]\n for p in comps:\n  a,b,c,d=box(p)\n  if len(p)<(b-a+1)*(d-c+1): frames.append(p)\n if not frames: return [row[:] for row in grid]\n frame=max(frames,key=len); a,b,c,d=box(frame)\n out=[row[:] for row in grid]\n for p in comps:\n  if p is frame: continue\n  u,v,l,r=box(p); dy=dx=0\n  if v<a: dy=a-v-1\n  elif u>b: dy=b-u+1\n  elif r<c: dx=c-r-1\n  elif l>d: dx=d-l+1\n  for y,x in p: out[y][x]=0\n  for y,x in p:\n   if 0<=y+dy<h and 0<=x+dx<w: out[y+dy][x+dx]=grid[y][x]\n return out",
