    "program_source": "def transform(grid):\n    from collections import Counter\n    pts=[(r,c,v) for r,row in enumerate(grid) for c,v in enumerate(row) if v]\n    if not pts: return [row[:] for row in grid]\n    color=Counter(v for r,c,v in pts).most_common(1)[0][0]\n    p=[(r,c) for r,c,v in pts if v==color]\n    plus=Counter(r-c for r,c in p)\n    minus=Counter(r+c for r,c in p)\n    if plus.most_common(1)[0][1]>minus.most_common(1)[0][1]:\n        k=plus.most_common(1)[0][0]\n        return [[color if r-c>=k else 0 for c in range(len(grid[0]))] for r in range(len(grid))]\n    k=minus.most_common(1)[0][0]\n    return [[color if r+c>=k else 0 for c in range(len(grid[0]))] for r in range(len(grid))]",
