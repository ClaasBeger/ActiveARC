    "program_source": "def transform(grid):\n    h=len(grid); w=len(grid[0]); out=[r[:] for r in grid]; seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            color=grid[r][c]; pts=[]; stack=[(r,c)]; seen.add((r,c))\n            while stack:\n                y,x=stack.pop(); pts.append((y,x))\n                for a,b in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==color:\n                        seen.add((a,b)); stack.append((a,b))\n            if len(pts)>1:\n                if len({y for y,x in pts})==1: new=7\n                elif len({x for y,x in pts})==1: new=4\n                else: continue\n                for y,x in pts: out[y][x]=new\n    return out",
