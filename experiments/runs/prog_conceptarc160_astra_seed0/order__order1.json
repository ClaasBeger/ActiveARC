          {
            "arguments": "{\"code\":\"def transform(grid):\\n    h,w=len(grid),len(grid[0])\\n    seen=set(); objs=[]\\n    for r in range(h):\\n        for c in range(w):\\n            if not grid[r][c] or (r,c) in seen: continue\\n            stack=[(r,c)]; seen.add((r,c)); cells=[]\\n            while stack:\\n                y,x=stack.pop(); cells.append((y,x,grid[y][x]))\\n                for yy,xx in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\\n                    if 0<=yy<h and 0<=xx<w and grid[yy][xx]!=0 and (yy,xx) not in seen:\\n                        seen.add((yy,xx)); stack.append((yy,xx))\\n            objs.append((min(y for y,x,v in cells),min(x for y,x,v in cells),max(y for y,x,v in cells),max(x for y,x,v in cells),cells))\\n    if len(objs)<2:return [row[:] for row in grid]\\n    horizontal=len(set(o[1] for o in objs))>1\\n    axis=1 if horizontal else 0\\n    objs.sort(key=lambda o:o[axis])\\n    gaps=[objs[i+1][axis]-objs[i][axis+2]-1 for i in range(len(objs)-1)]\\n    pos=objs[0][axis]\\n    ordered=sorted(objs,key=lambda o:len(o[4]))\\n    out=[[0]*w for _ in range(h)]\\n    for i,o in enumerate(ordered):\\n        delta=pos-o[axis]\\n        for y,x,v in o[4]:\\n            yy=y+(delta if not horizontal else 0); xx=x+(delta if horizontal else 0)\\n            if 0<=yy<h and 0<=xx<w:out[yy][xx]=v\\n        pos+=o[axis+2]-o[axis]+1+(gaps[i] if i<len(gaps) else 0)\\n    return out\"}",
