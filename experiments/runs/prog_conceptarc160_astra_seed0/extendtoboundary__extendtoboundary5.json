    "program_source": "def transform(grid):\n    out=[row[:] for row in grid]\n    h=len(grid); w=len(grid[0])\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]!=0:\n                color=grid[r][c]\n                for y in range(h):\n                    for x in range(w):\n                        if abs(y-r)==abs(x-c):\n                            out[y][x]=color\n                return out\n    return out",
