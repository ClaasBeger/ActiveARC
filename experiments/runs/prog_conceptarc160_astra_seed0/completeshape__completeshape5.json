    "program_source": "def transform(grid):\n    out=[row[:] for row in grid]\n    h=len(grid); w=len(grid[0])\n    for r in range(h-1):\n        for c in range(w-1):\n            cells=[(r,c),(r+1,c),(r,c+1),(r+1,c+1)]\n            vals=[grid[a][b] for a,b in cells]\n            for col,other in [(3,4),(4,3)]:\n                if vals.count(col)==3 and vals.count(0)==1:\n                    a,b=cells[vals.index(0)]\n                    out[a][b]=other\n    return out",
