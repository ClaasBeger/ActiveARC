    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n h,w=len(grid),len(grid[0]); out=[[0]*w for _ in range(h)]; seen=set()\n for r in range(h):\n  for c in range(w):\n   if grid[r][c]==0 or (r,c) in seen: continue\n   color=grid[r][c]; pts={(r,c)}; seen.add((r,c)); todo=[(r,c)]\n   while todo:\n    y,x=todo.pop()\n    for p in [(y-1,x),(y+1,x),(y,x-1),(y,x+1)]:\n     a,b=p\n     if 0<=a<h and 0<=b<w and p not in seen and grid[a][b]==color:\n      seen.add(p);pts.add(p);todo.append(p)\n   rows={y:sum(a==y for a,b in pts) for y,x in pts}; cols={x:sum(b==x for a,b in pts) for y,x in pts}\n   dy=dx=0\n   if max(rows.values())>=max(cols.values()):\n    bar=max(rows,key=rows.get)\n    if sum(y-bar for y,x in pts)>0: dy=h-1-max(y for y,x in pts)\n    else: dy=-min(y for y,x in pts)\n   else:\n    bar=max(cols,key=cols.get)\n    if sum(x-bar for y,x in pts)>0: dx=w-1-max(x for y,x in pts)\n    else: dx=-min(x for y,x in pts)\n   for y,x in pts: out[y+dy][x+dx]=color\n return out",
