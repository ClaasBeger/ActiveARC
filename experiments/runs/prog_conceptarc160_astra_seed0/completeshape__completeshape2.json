    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[row[:] for row in grid]\n    colors=set(v for row in grid for v in row)-{0}\n    for col in colors:\n        for r in range(h):\n            if sum(v==col for v in grid[r])>=2:\n                for c in range(w): out[r][c]=col\n        for c in range(w):\n            if sum(grid[r][c]==col for r in range(h))>=2:\n                for r in range(h): out[r][c]=col\n    return out",
