    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[row[:] for row in grid]\n    for vertical in (False,True):\n        for a in range(w if vertical else h):\n            coords=[(b,a) if vertical else (a,b) for b in range(h if vertical else w)]\n            vals=[grid[r][c] for r,c in coords]\n            i=0\n            while i<len(vals):\n                j=i+1\n                while j<len(vals) and vals[j]==vals[i]: j+=1\n                if i>0 and j<len(vals) and vals[i]!=0 and vals[i-1]!=0 and vals[i-1]==vals[j]:\n                    for k in range(i,j):\n                        r,c=coords[k]\n                        out[r][c]=vals[i-1]\n                i=j\n    return out",
