    "program_source": "def transform(grid):\n    from collections import Counter\n    out=[row[:] for row in grid]\n    h=len(grid); w=len(grid[0])\n    counts=Counter(x for row in grid for x in row if x)\n    for r in range(h):\n        for c in range(w):\n            color=grid[r][c]\n            if color and counts[color]==1:\n                for d in (-1,1):\n                    y=r+d\n                    while 0<=y<h and grid[y][c]==0:\n                        out[y][c]=color\n                        y+=d\n    return out",
