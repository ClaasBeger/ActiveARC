    "program_source": "def transform(grid):\n    h=len(grid); w=len(grid[0]); seen=set(); counts={}\n    for r in range(h):\n        for c in range(w):\n            color=grid[r][c]\n            if not color or (r,c) in seen: continue\n            counts[color]=counts.get(color,0)+1\n            seen.add((r,c)); stack=[(r,c)]\n            while stack:\n                y,x=stack.pop()\n                for dy in (-1,0,1):\n                    for dx in (-1,0,1):\n                        yy,xx=y+dy,x+dx\n                        if 0<=yy<h and 0<=xx<w and (yy,xx) not in seen and grid[yy][xx]==color:\n                            seen.add((yy,xx)); stack.append((yy,xx))\n    return [[v if counts.get(v,0)>1 else 0 for v in row] for row in grid]",
