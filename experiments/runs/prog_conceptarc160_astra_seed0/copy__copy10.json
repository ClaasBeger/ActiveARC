    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\n    seen=set(); comps=[]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            col=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); pts=[]\n            while stack:\n                x,y=stack.pop(); pts.append((x,y))\n                for a,b in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==col:\n                        seen.add((a,b)); stack.append((a,b))\n            comps.append((col,pts))\n    colors=set(v for row in grid for v in row if v)\n    marker=max(colors,key=lambda col:sum(len(p)==1 for v,p in comps if v==col))\n    objs=[]\n    for col,p in comps:\n        if col==marker: continue\n        r=min(x for x,y in p); c=min(y for x,y in p)\n        key=(col,tuple(sorted((x-r,y-c) for x,y in p)))\n        objs.append((r,c,key,p))\n    if not objs: return out\n    decorations=[[] for _ in objs]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]!=marker: continue\n            idx=min(range(len(objs)),key=lambda i:min((r-x)**2+(c-y)**2 for x,y in objs[i][3]))\n            a,b,_,_=objs[idx]; decorations[idx].append((r-a,c-b))\n    for i,(r,c,key,p) in enumerate(objs):\n        candidates=[j for j in range(len(objs)) if objs[j][2]==key and decorations[j]]\n        if not candidates: continue\n        j=max(candidates,key=lambda j:len(decorations[j]))\n        for a,b in decorations[j]:\n            x,y=r+a,c+b\n            if 0<=x<h and 0<=y<w and out[x][y]==0: out[x][y]=marker\n    return out",
