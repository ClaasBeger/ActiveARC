    "program_source": "def transform(grid):\n    out = [row[:] for row in grid]\n    points = [(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v != 0]\n    if len(points)==2:\n        (r,c),(s,d)=points\n        out[(r+s)//2][(c+d)//2]=1\n    else:\n        a=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v==2]\n        b=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v==5]\n        for r,c in a:\n            for s,d in b:\n                if (r+s)%2==0 and (c+d)%2==0:\n                    out[(r+s)//2][(c+d)//2]=1\n    return out",
