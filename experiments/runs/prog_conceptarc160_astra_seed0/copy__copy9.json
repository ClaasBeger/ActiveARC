    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    seen=set(); groups={}\n    for r in range(h):\n        for c in range(w):\n            color=grid[r][c]\n            if not color or (r,c) in seen: continue\n            stack=[(r,c)]; seen.add((r,c)); comp=[]\n            while stack:\n                y,x=stack.pop(); comp.append((y,x))\n                for dy in (-1,0,1):\n                    for dx in (-1,0,1):\n                        yy,xx=y+dy,x+dx\n                        if 0<=yy<h and 0<=xx<w and (yy,xx) not in seen and grid[yy][xx]==color:\n                            seen.add((yy,xx)); stack.append((yy,xx))\n            groups.setdefault(color,[]).append(comp)\n    for color,comps in groups.items():\n        templates=[p for p in comps if len(p)>1]\n        if not templates: continue\n        template=max(templates,key=len)\n        ymin=min(y for y,x in template); ymax=max(y for y,x in template)\n        xmin=min(x for y,x in template); xmax=max(x for y,x in template)\n        cy=(ymin+ymax)//2; cx=(xmin+xmax)//2\n        for comp in comps:\n            if len(comp)!=1: continue\n            y,x=comp[0]\n            out[y][x]=0\n            for yy,xx in template:\n                ny,nx=y+yy-cy,x+xx-cx\n                if 0<=ny<h and 0<=nx<w: out[ny][nx]=color\n    return out",
