    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    cols=[c for c in range(w) if grid[0][c]!=0 and all(grid[r][c]==grid[0][c] for r in range(h))]\n    rows=[r for r in range(h) if grid[r][0]!=0 and all(grid[r][c]==grid[r][0] for c in range(w))]\n    if len(cols)>=2:\n        a,b=cols[0],cols[-1]\n        for r in range(h):\n            for c in range(a+1,b):\n                if grid[r][c]!=0:\n                    out[r][c]=0\n                    out[r][(a+b)//2]=grid[r][c]\n    elif len(rows)>=2:\n        a,b=rows[0],rows[-1]\n        for r in range(a+1,b):\n            for c in range(w):\n                if grid[r][c]!=0:\n                    out[r][c]=0\n                    out[(a+b)//2][c]=grid[r][c]\n    return out",
