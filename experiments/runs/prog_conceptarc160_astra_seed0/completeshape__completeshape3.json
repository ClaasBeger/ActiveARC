    "program_source": "def transform(grid):\n    out = [row[:] for row in grid]\n    colors = set(v for row in grid for v in row) - {0}\n    for color in colors:\n        pts = [(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v == color]\n        top = min(r for r,c in pts)\n        bottom = max(r for r,c in pts)\n        left = min(c for r,c in pts)\n        right = max(c for r,c in pts)\n        for c in range(left,right+1):\n            out[top][c] = color\n            out[bottom][c] = color\n        for r in range(top,bottom+1):\n            out[r][left] = color\n            out[r][right] = color\n    return out",
