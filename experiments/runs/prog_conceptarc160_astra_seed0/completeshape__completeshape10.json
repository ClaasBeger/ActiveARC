    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    h=len(grid); w=len(grid[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]!=0]\n    if not pts:return out\n    a=min(r for r,c in pts);b=max(r for r,c in pts);l=min(c for r,c in pts);u=max(c for r,c in pts)\n    maps=[lambda r,c:(r,l+u-c),lambda r,c:(a+b-r,c)]\n    def score(f):\n        return sum(grid[r][c]!=grid[f(r,c)[0]][f(r,c)[1]] for r in range(a,b+1) for c in range(l,u+1))\n    f=min(maps,key=score)\n    for r,c in pts:\n        y,x=f(r,c)\n        if out[y][x]==0:out[y][x]=grid[r][c]\n    return out",
