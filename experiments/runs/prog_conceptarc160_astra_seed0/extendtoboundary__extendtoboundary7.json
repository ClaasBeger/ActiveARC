          {
            "arguments": "{\"code\":\"def transform(grid):\\n    h,w=len(grid),len(grid[0])\\n    out=[r[:] for r in grid]\\n    cols=[c for c in range(w) if grid[0][c]!=0 and all(grid[r][c]==grid[0][c] for r in range(h))]\\n    rows=[r for r in range(h) if grid[r][0]!=0 and all(v==grid[r][0] for v in grid[r])]\\n    if cols:\\n        for r in range(h):\\n            for c in range(w):\\n                if grid[r][c] and c not in cols:\\n                    target=min(cols,key=lambda x:abs(x-c))\\n                    for x in range(min(c,target)+1,max(c,target)):\\n                        out[r][x]=grid[r][c]\\n    elif rows:\\n        for r in range(h):\\n            for c in range(w):\\n                if grid[r][c] and r not in rows:\\n                    target=min(rows,key=lambda x:abs(x-r))\\n                    for x in range(min(r,target)+1,max(r,target)):\\n                        out[x][c]=grid[r][c]\\n    return out\"}",
