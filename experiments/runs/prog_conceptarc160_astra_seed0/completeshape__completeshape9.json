    "program_source": "def transform(grid):\n    out=[row[:] for row in grid]\n    h,w=len(grid),len(grid[0])\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            color=grid[r][c]\n            cells=[(r,c)]; seen.add((r,c))\n            for y,x in cells:\n                for yy,xx in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                    if 0<=yy<h and 0<=xx<w and (yy,xx) not in seen and grid[yy][xx]==color:\n                        seen.add((yy,xx)); cells.append((yy,xx))\n            for y in range(min(p[0] for p in cells),max(p[0] for p in cells)+1):\n                for x in range(min(p[1] for p in cells),max(p[1] for p in cells)+1):\n                    out[y][x]=color\n    return out",
