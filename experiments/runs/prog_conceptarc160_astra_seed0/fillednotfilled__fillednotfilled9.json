    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            if not grid[r][c] or (r,c) in seen: continue\n            comp=[]; stack=[(r,c)]; seen.add((r,c))\n            while stack:\n                y,x=stack.pop(); comp.append((y,x))\n                for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n                    a,b=y+dy,x+dx\n                    if 0<=a<h and 0<=b<w and grid[a][b]!=0 and (a,b) not in seen:\n                        seen.add((a,b)); stack.append((a,b))\n            colors=set(grid[y][x] for y,x in comp)\n            if len(colors)<2: continue\n            top=min(y for y,x in comp); bottom=max(y for y,x in comp)\n            left=min(x for y,x in comp); right=max(x for y,x in comp)\n            boundary={v:0 for v in colors}\n            for y,x in comp:\n                if y in (top,bottom) or x in (left,right): boundary[grid[y][x]]+=1\n            frame=max(colors,key=lambda v:boundary[v])\n            fill=next((v for v in colors if v!=frame),2)\n            for y in range(top,bottom+1):\n                for x in range(left,right+1):\n                    if grid[y][x]==0: out[y][x]=fill\n    return out",
