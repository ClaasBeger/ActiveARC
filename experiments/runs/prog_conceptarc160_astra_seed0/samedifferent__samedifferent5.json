          {
            "arguments": "{\"code\":\"def transform(grid):\\n    from collections import Counter\\n    h,w=len(grid),len(grid[0]); seen=set(); votes=Counter()\\n    for r in range(h):\\n        for c in range(w):\\n            if not grid[r][c] or (r,c) in seen: continue\\n            seen.add((r,c)); stack=[(r,c)]; comp=[]\\n            while stack:\\n                a,b=stack.pop(); comp.append((a,b))\\n                for x,y in ((a-1,b),(a+1,b),(a,b-1),(a,b+1)):\\n                    if 0<=x<h and 0<=y<w and grid[x][y] and (x,y) not in seen:\\n                        seen.add((x,y)); stack.append((x,y))\\n            cells=set(comp); boundary=Counter(); colors=Counter(grid[a][b] for a,b in comp)\\n            for a,b in comp:\\n                if any((x,y) not in cells for x,y in ((a-1,b),(a+1,b),(a,b-1),(a,b+1))): boundary[grid[a][b]]+=1\\n            outer=boundary.most_common(1)[0][0]\\n            for color in colors:\\n                if color!=outer: votes[color]+=1\\n    return [[votes.most_common(1)[0][0]]]\"}",
