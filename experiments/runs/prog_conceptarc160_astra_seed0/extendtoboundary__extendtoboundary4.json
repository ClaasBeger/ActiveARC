    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\n    seen=set(); comps=[]\n    for r in range(h):\n        for c in range(w):\n            if not grid[r][c] or (r,c) in seen: continue\n            color=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); pts=[]\n            while stack:\n                a,b=stack.pop(); pts.append((a,b))\n                for x,y in ((a-1,b),(a+1,b),(a,b-1),(a,b+1)):\n                    if 0<=x<h and 0<=y<w and (x,y) not in seen and grid[x][y]==color:\n                        seen.add((x,y)); stack.append((x,y))\n            comps.append((color,pts))\n    for color,pts in comps:\n        rows={r for r,c in pts}; cols={c for r,c in pts}\n        dirs=[]\n        if len(rows)==1: dirs += [(0,1),(0,-1)]\n        if len(cols)==1: dirs += [(1,0),(-1,0)]\n        for dr,dc in dirs:\n            r,c=max(pts,key=lambda p:p[0]*dr+p[1]*dc)\n            r+=dr; c+=dc; path=[]\n            while 0<=r<h and 0<=c<w and grid[r][c]==0:\n                path.append((r,c)); r+=dr; c+=dc\n            if 0<=r<h and 0<=c<w and grid[r][c]!=color:\n                for a,b in path: out[a][b]=color\n    return out",
