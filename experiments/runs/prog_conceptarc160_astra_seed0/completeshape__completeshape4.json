    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[[0]*w for _ in range(h)]\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]!=0]\n    if not pts: return out\n    a=min(r for r,c in pts); b=max(r for r,c in pts)\n    l=min(c for r,c in pts); u=max(c for r,c in pts)\n    color=grid[pts[0][0]][pts[0][1]]\n    horizontal=all(r in (a,b) for r,c in pts)\n    if horizontal:\n        for r in range(a+1,b):\n            out[r][l]=color\n            out[r][u]=color\n    else:\n        for c in range(l+1,u):\n            out[a][c]=color\n            out[b][c]=color\n    return out",
