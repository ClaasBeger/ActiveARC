    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    seen=set(); comps=[]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            stack=[(r,c)]; seen.add((r,c)); comp=[]\n            while stack:\n                a,b=stack.pop(); comp.append((a,b))\n                for x,y in [(a+1,b),(a-1,b),(a,b+1),(a,b-1)]:\n                    if 0<=x<h and 0<=y<w and grid[x][y]!=0 and (x,y) not in seen:\n                        seen.add((x,y)); stack.append((x,y))\n            comps.append(comp)\n    out=[[0]*w for _ in range(h)]\n    if comps:\n        comp=max(comps,key=len)\n        for r,c in comp: out[r][c]=grid[r][c]\n    return out",
