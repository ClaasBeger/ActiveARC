    "program_source": "def transform(grid):\n    from collections import Counter\n    h,w=len(grid),len(grid[0])\n    out=[row[:] for row in grid]\n    rows=[r for r in range(h) if all(grid[r][c]!=0 for c in range(w))]\n    cols=[c for c in range(w) if all(grid[r][c]!=0 for r in range(h))]\n    rc={r:Counter(grid[r][c] for c in range(w) if c not in cols).most_common(1) for r in rows}\n    cc={c:Counter(grid[r][c] for r in range(h) if r not in rows).most_common(1) for c in cols}\n    for r in rows:\n        for c in cols:\n            if rc[r] and cc[c]:\n                a,b=rc[r][0][0],cc[c][0][0]\n                out[r][c]=b if grid[r][c]==a else a\n    return out",
