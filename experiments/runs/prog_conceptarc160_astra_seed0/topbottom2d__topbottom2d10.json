    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    inds=[i for i,r in enumerate(grid) if any(r)]\n    if not inds: return out\n    a,b=inds[0],inds[-1]+1\n    groups=[]\n    for r in grid[a:b]:\n        if groups and groups[-1][-1]==r: groups[-1].append(r[:])\n        else: groups.append([r[:]])\n    if len(groups)>1: groups=[groups[-1]]+groups[1:-1]+[groups[0]]\n    out[a:b]=[r for block in groups for r in block]\n    return out",
