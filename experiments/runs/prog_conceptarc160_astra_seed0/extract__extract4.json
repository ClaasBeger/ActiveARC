    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    best=None\n    for color in set(sum(grid,[]))-{0}:\n        for top in range(h):\n            good=[True]*w\n            for bottom in range(top,h):\n                for j in range(w): good[j]=good[j] and grid[bottom][j]==color\n                start=0\n                while start<w:\n                    if not good[start]:\n                        start+=1\n                        continue\n                    end=start\n                    while end<w and good[end]: end+=1\n                    rh=bottom-top+1; rw=end-start\n                    score=(min(rh,rw)>1,rh*rw)\n                    if best is None or score>best[0]: best=(score,rh,rw,color)\n                    start=end\n    if best is None: return [row[:] for row in grid]\n    _,rh,rw,color=best\n    return [[color]*rw for _ in range(rh)]",
