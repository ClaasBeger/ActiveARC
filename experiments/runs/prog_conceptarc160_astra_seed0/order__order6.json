    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    seen=set(); blocks=[]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            color=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); cells=[]\n            while stack:\n                x,y=stack.pop(); cells.append((x,y))\n                for a,b in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==color:\n                        seen.add((a,b)); stack.append((a,b))\n            blocks.append((cells,color))\n    if not blocks:return [r[:] for r in grid]\n    out=[[0]*w for _ in range(h)]\n    top=min(r for cells,_ in blocks for r,c in cells)\n    left=min(c for cells,_ in blocks for r,c in cells)\n    vertical=len(set(min(r for r,c in cells) for cells,_ in blocks))>1\n    pos=top if vertical else left\n    for cells,color in sorted(blocks,key=lambda z:len(z[0])):\n        r0=min(r for r,c in cells); c0=min(c for r,c in cells)\n        bh=max(r for r,c in cells)-r0+1; bw=max(c for r,c in cells)-c0+1\n        for r,c in cells:\n            rr=pos+r-r0 if vertical else r\n            cc=c if vertical else pos+c-c0\n            if 0<=rr<h and 0<=cc<w:out[rr][cc]=color\n        pos+=bh if vertical else bw\n    return out",
