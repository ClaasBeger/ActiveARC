    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[[0]*w for _ in range(h)]\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            if not grid[r][c] or (r,c) in seen: continue\n            color=grid[r][c]\n            stack=[(r,c)]; seen.add((r,c)); comp=[]\n            while stack:\n                y,x=stack.pop(); comp.append((y,x))\n                for dy in (-1,0,1):\n                    for dx in (-1,0,1):\n                        ny,nx=y+dy,x+dx\n                        if 0<=ny<h and 0<=nx<w and (ny,nx) not in seen and grid[ny][nx]==color:\n                            seen.add((ny,nx)); stack.append((ny,nx))\n            if len(comp)>1 and len({x for y,x in comp})==1:\n                for y,x in comp: out[y][x]=color\n    return out",
