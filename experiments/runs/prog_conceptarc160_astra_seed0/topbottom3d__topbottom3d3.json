    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[[0 if v==8 else v for v in row] for row in grid]\n    dirs=[(1,0),(0,1),(1,1),(1,-1)]\n    for dr,dc in dirs:\n        for r in range(h):\n            for c in range(w):\n                color=grid[r][c]\n                if color in (0,8): continue\n                rr,cc=r+dr,c+dc\n                gap=[]\n                while 0<=rr<h and 0<=cc<w and grid[rr][cc]==8:\n                    gap.append((rr,cc)); rr+=dr; cc+=dc\n                if gap and 0<=rr<h and 0<=cc<w and grid[rr][cc]==color:\n                    for a,b in gap: out[a][b]=color\n    return out",
