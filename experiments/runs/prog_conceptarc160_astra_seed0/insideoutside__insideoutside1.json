    "program_source": "def transform(grid):\n    frame = [(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v==5]\n    if not frame: return [[0]]\n    top=min(r for r,c in frame); bottom=max(r for r,c in frame)\n    left=min(c for r,c in frame); right=max(c for r,c in frame)\n    n=sum(1 for r,row in enumerate(grid) for c,v in enumerate(row) if v not in (0,5) and not (top<=r<=bottom and left<=c<=right))\n    return [[0] for _ in range(n)]",
