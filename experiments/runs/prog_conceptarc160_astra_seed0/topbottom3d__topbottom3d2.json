          {
            "arguments": "{\"code\":\"def transform(grid):\\n    from collections import Counter\\n    h,w=len(grid),len(grid[0])\\n    counts=Counter(v for row in grid for v in row if v!=0)\\n    squares=Counter()\\n    for r in range(h-1):\\n        for c in range(w-1):\\n            v=grid[r][c]\\n            if v and grid[r+1][c]==v and grid[r][c+1]==v and grid[r+1][c+1]==v:\\n                squares[v]+=1\\n    if not counts: return [row[:] for row in grid]\\n    keep=max(counts,key=lambda v:(squares[v],counts[v]))\\n    return [[v if v==keep else 0 for v in row] for row in grid]\"}",
