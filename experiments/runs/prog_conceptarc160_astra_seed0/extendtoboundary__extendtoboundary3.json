    "program_source": "def transform(grid):\n    out=[row[:] for row in grid]\n    wall=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v==9]\n    if not wall: return out\n    rs={r for r,c in wall}; cs={c for r,c in wall}\n    for r,row in enumerate(grid):\n        for c,v in enumerate(row):\n            if v==3:\n                if len(rs)==1:\n                    target=next(iter(rs))\n                    for rr in range(min(r,target)+1,max(r,target)):\n                        out[rr][c]=v\n                elif len(cs)==1:\n                    target=next(iter(cs))\n                    for cc in range(min(c,target)+1,max(c,target)):\n                        out[r][cc]=v\n    return out",
