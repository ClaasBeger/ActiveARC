    "program_source": "def transform(grid):\n    h=len(grid); w=len(grid[0]); out=[row[:] for row in grid]\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            col=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); pts=[]\n            while stack:\n                x,y=stack.pop(); pts.append((x,y))\n                for dx in (-1,0,1):\n                    for dy in (-1,0,1):\n                        a,b=x+dx,y+dy\n                        if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==col:\n                            seen.add((a,b)); stack.append((a,b))\n            lo=min(x+y for x,y in pts); hi=max(x+y for x,y in pts)\n            left=min(x-y for x,y in pts); right=max(x-y for x,y in pts)\n            for x in range(h):\n                for y in range(w):\n                    s=x+y; d=x-y\n                    if lo<=s<=hi and left<=d<=right and (s==lo or s==hi or d==left or d==right):\n                        out[x][y]=col\n    return out",
