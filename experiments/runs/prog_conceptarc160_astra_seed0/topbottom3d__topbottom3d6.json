    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    colors=set(x for row in grid for x in row)-{0}\n    boxes={}\n    for c in colors:\n        pts=[(r,k) for r,row in enumerate(grid) for k,v in enumerate(row) if v==c]\n        boxes[c]=(min(r for r,k in pts),max(r for r,k in pts),min(k for r,k in pts),max(k for r,k in pts))\n    above={c:set() for c in colors}\n    for c,(a,b,d,e) in boxes.items():\n        above[c]={grid[r][k] for r in range(a,b+1) for k in range(d,e+1)}-{0,c}\n    covered=set().union(*above.values())\n    candidates=colors-covered\n    def depth(c,seen):\n        return 0 if c in seen else 1+max([depth(v,seen|{c}) for v in above[c]] or [0])\n    c=max(candidates or colors,key=lambda c:depth(c,set()))\n    a,b,d,e=boxes[c]\n    return [[c]*(e-d+1) for _ in range(b-a+1)]",
