    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    h,w=len(grid),len(grid[0])\n    cols=[c for c in range(w) if all(grid[r][c]==5 for r in range(h))]\n    if cols:\n        c=min(cols,key=lambda c:abs(c-(w-1)/2))\n        for r in range(h):\n            for j in range(c+1,w): out[r][j]=0\n    else:\n        rows=[r for r in range(h) if all(v==5 for v in grid[r])]\n        if rows:\n            r=min(rows,key=lambda r:abs(r-(h-1)/2))\n            for i in range(r+1,h):out[i]=[0]*w\n    return out",
