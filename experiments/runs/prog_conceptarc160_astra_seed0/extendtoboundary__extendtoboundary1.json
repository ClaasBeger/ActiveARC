    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    h,w=len(grid),len(grid[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]!=0]\n    if not pts:return out\n    a=min(r for r,c in pts); b=max(r for r,c in pts); l=min(c for r,c in pts); u=max(c for r,c in pts)\n    color=grid[a][l]\n    if a==0:\n        for r in range(b+1,h):out[r][(l+u)//2]=color\n    elif b==h-1:\n        for r in range(a):out[r][(l+u)//2]=color\n    elif l==0:\n        for c in range(u+1,w):out[(a+b)//2][c]=color\n    elif u==w-1:\n        for c in range(l):out[(a+b)//2][c]=color\n    else:\n        for r in range(b+1,h):out[r][(l+u)//2]=color\n    return out",
