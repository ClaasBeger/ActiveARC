    "program_source": "def transform(grid):\n    pts=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v==8]\n    if not pts:\n        return [[0] for _ in range(7)]\n    r0=min(r for r,c in pts); r1=max(r for r,c in pts)\n    c0=min(c for r,c in pts); c1=max(c for r,c in pts)\n    n=sum(grid[r][c] not in (0,8) for r in range(r0+1,r1) for c in range(c0+1,c1))\n    return [[4 if i<n else 0] for i in range(7)]",
