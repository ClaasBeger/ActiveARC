    "program_source": "def transform(grid):\n    out=[row[:] for row in grid]\n    h=len(grid); w=len(grid[0])\n    for top in range(h):\n        for left in range(w):\n            color=grid[top][left]\n            if color==0: continue\n            for right in range(left+2,w):\n                if any(grid[top][c]!=color for c in range(left,right+1)): break\n                for bottom in range(top+2,h):\n                    if all(grid[r][left]==color and grid[r][right]==color for r in range(top,bottom+1)) and all(grid[bottom][c]==color for c in range(left,right+1)):\n                        for r in range(top+1,bottom):\n                            for c in range(left+1,right): out[r][c]=color\n    return out",
