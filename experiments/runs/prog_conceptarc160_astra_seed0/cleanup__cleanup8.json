    "program_source": "def transform(grid):\n    from collections import Counter\n    h,w=len(grid),len(grid[0])\n    out=[[0]*w for _ in range(h)]\n    for i in range(0,min(h,w),2):\n        cells=[grid[r][c] for r in range(i,min(i+2,h)) for c in range(i,min(i+2,w))]\n        color=Counter(cells).most_common(1)[0][0]\n        for r in range(i,min(i+2,h)):\n            for c in range(i,min(i+2,w)):\n                out[r][c]=color\n    return out",
