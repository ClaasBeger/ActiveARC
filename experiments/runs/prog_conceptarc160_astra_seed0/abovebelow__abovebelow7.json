    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    box=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v==8]\n    obj=[(r,c,v) for r,row in enumerate(grid) for c,v in enumerate(row) if v not in (0,8)]\n    if not box or not obj: return out\n    bottom=max(r for r,c in box)\n    top=min(r for r,c,v in obj)\n    shift=bottom+1-top\n    for r,c,v in obj: out[r][c]=0\n    for r,c,v in obj:\n        if 0<=r+shift<len(out): out[r+shift][c]=v\n    return out",
