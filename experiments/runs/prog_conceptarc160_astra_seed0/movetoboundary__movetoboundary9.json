    "program_source": "def transform(grid):\n    h=len(grid); w=len(grid[0])\n    cols=[c for c in range(w) if any(grid[r][c]!=0 for r in range(h))]\n    out=[[0]*w for _ in range(h)]\n    if len(cols)<2: return [r[:] for r in grid]\n    i=max(range(len(cols)-1),key=lambda i:cols[i+1]-cols[i])\n    split=cols[i]\n    for r in range(h):\n        for c in cols:\n            if grid[r][c]:\n                nc=c-cols[0] if c<=split else c+w-1-cols[-1]\n                out[r][nc]=grid[r][c]\n    return out",
