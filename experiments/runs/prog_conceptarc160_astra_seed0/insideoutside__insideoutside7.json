    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    seen=set(); frames=[]\n    for r in range(h):\n        for c in range(w):\n            color=grid[r][c]\n            if color in (0,2) or (r,c) in seen: continue\n            stack=[(r,c)]; seen.add((r,c)); pts=[]\n            while stack:\n                y,x=stack.pop(); pts.append((y,x))\n                for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n                    a,b=y+dy,x+dx\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==color:\n                        seen.add((a,b)); stack.append((a,b))\n            top=min(y for y,x in pts); bottom=max(y for y,x in pts)\n            left=min(x for y,x in pts); right=max(x for y,x in pts)\n            if bottom-top>=2 and right-left>=2:\n                count=sum(grid[y][x]==2 for y in range(top+1,bottom) for x in range(left+1,right))\n                frames.append((top,left,color,count))\n    frames.sort()\n    return [[color for _,_,color,count in frames for i in range(count)]]",
