    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    seen=set(); candidates=[]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            color=grid[r][c]; pts=[]; stack=[(r,c)]; seen.add((r,c))\n            while stack:\n                y,x=stack.pop(); pts.append((y,x))\n                for yy,xx in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                    if 0<=yy<h and 0<=xx<w and (yy,xx) not in seen and grid[yy][xx]==color:\n                        seen.add((yy,xx)); stack.append((yy,xx))\n            a=min(y for y,x in pts); b=max(y for y,x in pts); l=min(x for y,x in pts); t=max(x for y,x in pts)\n            s=set(pts); outside=set(); todo=[(a-1,l-1)]; outside.add(todo[0])\n            while todo:\n                y,x=todo.pop()\n                for yy,xx in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                    if a-1<=yy<=b+1 and l-1<=xx<=t+1 and (yy,xx) not in s and (yy,xx) not in outside:\n                        outside.add((yy,xx)); todo.append((yy,xx))\n            holes=sum((y,x) not in s and (y,x) not in outside for y in range(a,b+1) for x in range(l,t+1))\n            candidates.append((holes,len(pts),a,b,l,t))\n    if not candidates: return grid\n    _,_,a,b,l,t=max(candidates)\n    return [row[l:t+1] for row in grid[a:b+1]]",
