            "arguments": "{\"code\":\"def transform(grid):\\n    h=len(grid); w=len(grid[0]) if h else 0\\n    seen=set(); comps=[]\\n    for r in range(h):\\n        for c in range(w):\\n            if grid[r][c]!=0 and (r,c) not in seen:\\n                stack=[(r,c)]; seen.add((r,c)); comp=[]\\n                while stack:\\n                    x,y=stack.pop(); comp.append((x,y))\\n                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\\n                        a,b=x+dx,y+dy\\n                        if 0<=a<h and 0<=b<w and grid[a][b]!=0 and (a,b) not in seen:\\n                            seen.add((a,b)); stack.append((a,b))\\n                comps.append(comp)\\n    if not comps: return []\\n    comp=max(comps,key=lambda q:len(q))\\n    rs=[p[0] for p in comp]; cs=[p[1] for p in comp]\\n    r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)\\n    return [row[c0:c1+1] for row in grid[r0:r1+1]]\"}",
