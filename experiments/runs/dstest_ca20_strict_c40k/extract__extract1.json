          "id": "call_01a0c86fab9675d09c1539e7",
          "name": "propose_hypotheses",
          "arguments": "{\"hypotheses\":[{\"nl\":\"Output is the longest horizontal run of identical nonzero color, as a 1xN row.\",\"code\":\"def transform(grid):\\n    best=[]\\n    for row in grid:\\n        i=0\\n        while i<len(row):\\n            if row[i]!=0:\\n                j=i\\n                while j<len(row) and row[j]==row[i]: j+=1\\n                if j-i>len(best): best=row[i:j]\\n                i=j\\n            else: i+=1\\n    return [best]\"},{\"nl\":\"Output is the first row containing nonzero cells, trimmed to its nonzero segment.\",\"code\":\"def transform(grid):\\n    for row in grid:\\n        nz=[c for c in row if c!=0]\\n        if nz: return [nz]\\n    return [[]]\"},{\"nl\":\"Output is the row with the most nonzero cells, trimmed to its nonzero segment.\",\"code\":\"def transform(grid):\\n    best=None;bc=-1\\n    for row in grid:\\n        nz=[c for c in row if c!=0]\\n        if len(nz)>bc: bc=len(nz);best=nz\\n    return [best]\"},{\"nl\":\"Output is the most frequent nonzero color repeated count times as a 1xN row.\",\"code\":\"def transform(grid):\\n    from collections import Counter\\n    c=Counter(v for row in grid for v in row if v!=0)\\n    if not c: return [[]]\\n    col,n=c.most_common(1)[0]\\n    return [[col]*n]\"},{\"nl\":\"Output is the horizontal run of color 2 (the 2-line), as a 1xN row.\",\"code\":\"def transform(grid):\\n    best=[]\\n    for row in grid:\\n        i=0\\n        while i<len(row):\\n            if row[i]==2:\\n                j=i\\n                while j<len(row) and row[j]==2: j+=1\\n                if j-i>len(best): best=row[i:j]\\n                i=j\\n            else: i+=1\\n    return [best]\"},{\"nl\":\"Output is the longest run of identical nonzero color in any direction (horizontal or vertical).\",\"code\":\"def transform(grid):\\n    R=len(grid);C=len(grid[0]) if R else 0\\n    best=[]\\n    for r in range(R):\\n        i=0\\n        while i<C:\\n            if grid[r][i]!=0:\\n                j=i\\n                while j<C and grid[r][j]==grid[r][i]: j+=1\\n                if j-i>len(best): best=[grid[r][i]]*(j-i)\\n                i=j\\n            else: i+=1\\n    for c in range(C):\\n        i=0\\n        while i<R:\\n            if grid[i][c]!=0:\\n                j=i\\n                while j<R and grid[j][c]==grid[i][c]: j+=1\\n                if j-i>len(best): best=[grid[i][c]]*(j-i)\\n                i=j\\n            else: i+=1\\n    return [best]\"},{\"nl\":\"Output is the top row trimmed of zeros.\",\"code\":\"def transform(grid):\\n    row=grid[0]\\n    nz=[c for c in row if c!=0]\\n    return [nz]\"},{\"nl\":\"Output is the longest horizontal run of nonzero cells (any colors), as a 1xN row.\",\"code\":\"def transform(grid):\\n    best=[]\\n    for row in grid:\\n        i=0\\n        while i<len(row):\\n            if row[i]!=0:\\n                j=i\\n                while j<len(row) and row[j]!=0: j+=1\\n                if j-i>len(best): best=row[i:j]\\n                i=j\\n            else: i+=1\\n    return [best]\"}]}"
