            "implementation": "# ConceptARC DSL program (the verifier is this descriptor, run by the interpreter below):\n# {\"action\": {\"op\": \"extract_cell\"},\"selector\": {\"op\": \"middle_cell\"}}\n# Entry point: output = transform_dsl_program(program, input_grid)\n\n# --- action: how the selection is turned into the output grid ---\n\ndef transform_dsl_program(program: DslProgram, grid: Grid) -> Grid:\n    # Dispatch trimmed to the branch(es) this program uses.\n    \"\"\"Apply a default DSL program to an input grid.\n\n    Args:\n      program (DslProgram): DSL program.\n      grid (Grid): Input grid.\n\n    Returns:\n      Grid: Output grid.\n    \"\"\"\n    selection = select_scene_objects(program.selector, grid)\n    action_op = program.action.get(\"op\")\n    if action_op == \"extract_cell\":\n        return extract_cell(grid, expect_cell(selection))\n\n# --- selection: which cells/objects the program operates on ---\n\ndef select_scene_objects(selector: dict[str, Any], grid: Grid) -> SceneSelection:\n    # Dispatch trimmed to the branch(es) this program uses.\n    \"\"\"Select object(s) from a grid using a DSL selector expression.\n\n    Args:\n      selector (dict[str, Any]): Selector expression.\n      grid (Grid): Input grid.\n\n    Returns:\n      SceneSelection: Selected object or object pair.\n    \"\"\"\n    op = selector.get(\"op\")\n    if op == \"middle_cell\":\n        return middle_cell(grid)\n\n# --- helpers the branches above reach (ConceptARC-GEN, verify side only; `common.grid(w, h, c)` is ARC-GEN's blank-grid constructor) ---\n\nGrid = list[list[int]]\n\nSceneSelection = Union[SceneCell, SceneCellGroup, SceneCellPatch, SceneCount, SceneRowRun, SceneObject, tuple[SceneObject, SceneObject], SceneObjectGroup, SceneObjectReferenceGroup, SceneShapeInstance, SceneShapeInstanceGroup]\n\ndef middle_cell(grid: Grid) -> SceneCell:\n    \"\"\"Return the uniquely defined center cell of an odd-sized grid.\n\n    Args:\n      grid (Grid): Grid to inspect.\n\n    Returns:\n      SceneCell: Center cell.\n    \"\"\"\n    height = len(grid)\n    width = len(grid[0])\n    if height % 2 == 0 or width % 2 == 0:\n        raise ValueError('middle_cell requires odd grid height and width')\n    return SceneCell(height // 2, width // 2)\n\ndef expect_cell(selection: SceneSelection | None) -> SceneCell:\n    \"\"\"Return a selected cell or raise a type error.\n\n    Args:\n      selection (SceneSelection | None): Selection to validate.\n\n    Returns:\n      SceneCell: Selected cell.\n    \"\"\"\n    if isinstance(selection, SceneCell):\n        return selection\n    raise ValueError('DSL action requires a single cell selection')\n\ndef extract_cell(grid: Grid, cell: SceneCell) -> Grid:\n    \"\"\"Return a 1x1 grid containing a selected cell's color.\n\n    Args:\n      grid (Grid): Input grid.\n      cell (SceneCell): Cell to extract.\n\n    Returns:\n      Grid: One-cell output grid.\n    \"\"\"\n    return [[grid[cell.row][cell.col]]]\n",
