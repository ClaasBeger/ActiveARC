          {
            "arguments": "{\"code\":\"def transform(grid):\\n    h=len(grid); w=len(grid[0]) if h else 0\\n    out=[[8 for _ in range(w)] for _ in range(h)]\\n    seen=set()\\n    for r in range(h):\\n        for c in range(w):\\n            if grid[r][c]==8 or (r,c) in seen: continue\\n            stack=[(r,c)]; seen.add((r,c)); comp=[]\\n            while stack:\\n                x,y=stack.pop(); comp.append((x,y))\\n                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):\\n                    a,b=x+dx,y+dy\\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]!=8:\\n                        seen.add((a,b)); stack.append((a,b))\\n            if len(comp)==3:\\n                rs={x for x,y in comp}; cs={y for x,y in comp}\\n                # three cells occupying a 2x2 block (an L triomino)\\n                if len(rs)==2 and len(cs)==2:\\n                    for x,y in comp: out[x][y]=grid[x][y]\\n    return out\"}",
