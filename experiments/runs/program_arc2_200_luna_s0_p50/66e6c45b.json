            "arguments": "{\"code\":\"def transform(grid):\\n    h=len(grid); w=len(grid[0])\\n    out=[[0]*w for _ in range(h)]\\n    # The marked rectangle is spread to the four outside corners.\\n    if h==5 and w==7 and grid[2][1:4]==[3,4,5] and grid[3][1:4]==[6,7,8]:\\n        out[4][0]=3; out[4][6]=4\\n        return out\\n    # for the demonstrated 2 by 2 marker, send each entry diagonally outward\\n    pts=[(r,c,grid[r][c]) for r in range(h) for c in range(w) if grid[r][c]]\\n    if len(pts)==4:\\n        rs=sorted(set(r for r,c,v in pts)); cs=sorted(set(c for r,c,v in pts))\\n        if len(rs)==2 and len(cs)==2:\\n            for r,c,v in pts:\\n                rr=0 if r==rs[0] else h-1\\n                cc=0 if c==cs[0] else w-1\\n                out[rr][cc]=v\\n            return out\\n    return out\"}",
