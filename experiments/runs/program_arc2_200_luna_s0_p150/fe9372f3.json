            "arguments": "{\"code\":\"def transform(grid):\\n    a=[r[:] for r in grid]\\n    R=len(a); C=len(a[0])\\n    pts=[(r,c) for r in range(R) for c in range(C) if a[r][c]==2]\\n    # center is the 2 having four orthogonal 2 neighbors\\n    cr=cc=None\\n    for r,c in pts:\\n        if all(0<=r+dr<R and 0<=c+dc<C and a[r+dr][c+dc]==2 for dr,dc in ((1,0),(-1,0),(0,1),(0,-1))):\\n            cr,cc=r,c; break\\n    # diagonals\\n    for dr,dc in ((1,1),(1,-1),(-1,1),(-1,-1)):\\n        r,c=cr+dr,cc+dc\\n        while 0<=r<R and 0<=c<C:\\n            a[r][c]=1; r+=dr; c+=dc\\n    # cardinal rays\\n    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\\n        for d in range(2, max(R,C)+1):\\n            r,c=cr+dr*d,cc+dc*d\\n            if not(0<=r<R and 0<=c<C): break\\n            a[r][c]=4 if d%3==1 else 8\\n    return a\"}",
