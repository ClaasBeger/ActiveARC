            "arguments": "{\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    # locate solid separator row (color 4), and vertical separator columns\\n    sep=next((r for r,row in enumerate(grid) if row and all(x==4 for x in row)), None)\\n    if sep is None: return g\\n    cols=[c for c in range(len(grid[0])) if all(grid[r][c]==4 for r in range(len(grid)))]\\n    # contiguous panel intervals between separators/borders\\n    bounds=[-1]+cols+[len(grid[0])]\\n    panels=[]\\n    for a,b in zip(bounds,bounds[1:]):\\n        if b>a+1: panels.append((a+1,b))\\n    top=range(0,sep); bot=range(sep+1,len(grid))\\n    def score(rs, a,b, val): return sum(grid[r][c]==val for r in rs for c in range(a,b))\\n    # side containing 1s is template; opposite side contains color labels\\n    st=sum(score(top,a,b,1) for a,b in panels); sb=sum(score(bot,a,b,1) for a,b in panels)\\n    template=top if st>=sb else bot\\n    other=bot if st>=sb else top\\n    for (a,b) in panels:\\n        colors=[grid[r][c] for r in other for c in range(a,b) if grid[r][c] not in (0,4,1)]\\n        if not colors: continue\\n        color=colors[0]\\n        for r in template:\\n            for c in range(a,b):\\n                if grid[r][c]==1: g[r][c]=color\\n    return g\"}",
