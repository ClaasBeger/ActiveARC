          "id": "call_169073",
          "name": "propose_hypotheses",
          "arguments": "{\"hypotheses\":[{\"code\":\"def transform(grid):\\n    # Find bounding box of non-zero pixels, draw line from center to right\\n    import copy\\n    out = copy.deepcopy(grid)\\n    rows = [r for r in range(len(grid)) if any(grid[r])]\\n    cols = [c for c in range(len(grid[0])) if any(grid[r][c] for r in range(len(grid)))]\\n    if rows and cols:\\n        mid_r = (rows[0] + rows[-1]) // 2\\n        max_c = cols[-1]\\n        val = grid[mid_r][max_c]\\n        for c in range(max_c + 1, len(grid[0])):\\n            out[mid_r][c] = val\\n    return out\\n\",\"nl\":\"From the vertical midpoint of the shape, extend a ray to the right edge of the grid.\"},{\"code\":\"def transform(grid):\\n    # Middle row of the grid gets filled from shape to the right\\n    import copy\\n    out = copy.deepcopy(grid)\\n    mid_r = 5\\n    for c in range(10, len(grid[0])):\\n        out[mid_r][c] = 8\\n    return out\\n\",\"nl\":\"Always extend row 5 from column 10 to the right edge with color 8.\"},{\"nl\":\"Extend the horizontal center line across the entire grid.\",\"code\":\"def transform(grid):\\n    # Extend row (min_r + max_r)//2 in both directions to boundaries\\n    import copy\\n    out = copy.deepcopy(grid)\\n    rows = [r for r in range(len(grid)) if any(grid[r])]\\n    cols = [c for c in range(len(grid[0])) if any(grid[r][c] for r in range(len(grid)))]\\n    if rows and cols:\\n        mid_r = (rows[0] + rows[-1]) // 2\\n        val = grid[mid_r][cols[0]]\\n        for c in range(len(grid[0])):\\n            out[mid_r][c] = val\\n    return out\\n\"},{\"code\":\"def transform(grid):\\n    # Extend from center to the right with length equal to width of shape\\n    import copy\\n    out = copy.deepcopy(grid)\\n    rows = [r for r in range(len(grid)) if any(grid[r])]\\n    cols = [c for c in range(len(grid[0])) if any(grid[r][c] for r in range(len(grid)))]\\n    if rows and cols:\\n        mid_r = (rows[0] + rows[-1]) // 2\\n        w = cols[-1] - cols[0] + 1\\n        for c in range(cols[-1] + 1, min(len(grid[0]), cols[-1] + 1 + w + 1)):\\n            out[mid_r][c] = grid[mid_r][cols[-1]]\\n    return out\\n\",\"nl\":\"Extend a ray of length 6 (or width+1) to the right.\"},{\"nl\":\"Extend ray from the median row of non-zero pixels to the right.\",\"code\":\"def transform(grid):\\n    # If a square/rectangle of color 8 exists, shoot ray from center to right\\n    import copy\\n    out = copy.deepcopy(grid)\\n    rows = [r for r in range(len(grid)) if any(grid[r])]\\n    cols = [c for c in range(len(grid[0])) if any(grid[r][c] for r in range(len(grid)))]\\n    if rows and cols:\\n        mid_r = rows[len(rows)//2]\\n        for c in range(cols[-1] + 1, len(grid[0])):\\n            out[mid_r][c] = 8\\n    return out\\n\"},{\"nl\":\"Extend ray from center of shape towards the farther horizontal edge.\",\"code\":\"def transform(grid):\\n    # Project horizontal center line towards the closer (or further) vertical edge\\n    # In this case right edge is distance 16 - 10 = 6, left is 5. So towards further edge (right).\\n    import copy\\n    out = copy.deepcopy(grid)\\n    rows = [r for r in range(len(grid)) if any(grid[r])]\\n    cols = [c for c in range(len(grid[0])) if any(grid[r][c] for r in range(len(grid)))]\\n    if rows and cols:\\n        mid_r = (rows[0] + rows[-1]) // 2\\n        val = grid[mid_r][cols[-1]]\\n        dist_left = cols[0]\\n        dist_right = len(grid[0]) - 1 - cols[-1]\\n        if dist_right >= dist_left:\\n            for c in range(cols[-1] + 1, len(grid[0])):\\n                out[mid_r][c] = val\\n        else:\\n            for c in range(0, cols[0]):\\n                out[mid_r][c] = val\\n    return out\\n\"},{\"code\":\"def transform(grid):\\n    # Project horizontal center line towards the right edge always\\n    import copy\\n    out = copy.deepcopy(grid)\\n    for r in range(len(grid)):\\n        if sum(grid[r]) > 0:\\n            pass\\n    # Find all shapes, extend to right\\n    rows = [r for r in range(len(grid)) if any(grid[r])]\\n    cols = [c for c in range(len(grid[0])) if any(grid[r][c] for r in range(len(grid)))]\\n    mid_r = (rows[0] + rows[-1]) // 2\\n    for c in range(cols[-1] + 1, len(grid[0])):\\n        out[mid_r][c] = grid[rows[0]][cols[0]]\\n    return out\\n\",\"nl\":\"Extend ray from vertical center of shape to the right boundary using the shape's color.\"},{\"nl\":\"Append 6 teal pixels to row 5 from column 10 to 15.\",\"code\":\"def transform(grid):\\n    # Check if shape is a 5x5 teal square; if so, draw a pointer/arrow of length 6 to the right\\n    import copy\\n    out = copy.deepcopy(grid)\\n    for r in range(len(grid)):\\n        for c in range(len(grid[0])):\\n            if grid[r][c] == 8 and c >= 10:\\n                pass\\n    out[5] = grid[5][:10] + [8]*6\\n    return out\\n\"}]}"
