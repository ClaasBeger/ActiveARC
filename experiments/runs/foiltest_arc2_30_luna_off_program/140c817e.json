            "arguments": "{\"code\":\"def transform(grid):\\n    a=[row[:] for row in grid]\\n    h=len(a); w=len(a[0])\\n    seeds=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==1]\\n    # horizontal and vertical rays/lines\\n    for r,c in seeds:\\n        for j in range(w): a[r][j]=1\\n        for i in range(h): a[i][c]=1\\n    # one-cell diagonal markers, only on cells not occupied by lines\\n    for r,c in seeds:\\n        for dr,dc in ((-1,-1),(-1,1),(1,-1),(1,1)):\\n            i,j=r+dr,c+dc\\n            if 0<=i<h and 0<=j<w and a[i][j] not in (1,2):\\n                a[i][j]=3\\n    for r,c in seeds: a[r][c]=2\\n    return a\"}",
