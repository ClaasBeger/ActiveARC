    "program_source": "def transform(grid):\n    out=[row[:] for row in grid]\n    h=len(grid); w=len(grid[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==8]\n    if not pts: return out\n    horizontal=len(set(r for r,c in pts))==1\n    axis=pts[0][0] if horizontal else pts[0][1]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]!=0:\n                rr,cc=(2*axis-r,c) if horizontal else (r,2*axis-c)\n                if 0<=rr<h and 0<=cc<w and out[rr][cc]==0:\n                    out[rr][cc]=grid[r][c]\n    return out",
