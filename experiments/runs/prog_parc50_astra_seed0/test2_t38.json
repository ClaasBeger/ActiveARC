    "program_source": "def transform(grid):\n    from math import isqrt\n    from collections import Counter\n    H,W=len(grid),len(grid[0])\n    h,w=isqrt(H),isqrt(W)\n    if h*h!=H or w*w!=W:\n        return [r[:] for r in grid]\n    # The large image is the self-product of a smaller stencil.\n    mask=[[any(grid[a*h+i][b*w+j]!=0 for a in range(h) for b in range(w)) for j in range(w)] for i in range(h)]\n    for a in range(h):\n        for b in range(w):\n            for i in range(h):\n                for j in range(w):\n                    if (grid[a*h+i][b*w+j]!=0) != (mask[a][b] and mask[i][j]):\n                        return [r[:] for r in grid]\n    counts=Counter(v for row in grid for v in row if v)\n    if not counts: return [[0]*w for _ in range(h)]\n    base=counts.most_common(1)[0][0]\n    out=[[base if mask[i][j] else 0 for j in range(w)] for i in range(h)]\n    for r in range(H):\n        for c in range(W):\n            v=grid[r][c]\n            if v and v!=base: out[r%h][c%w]=v\n    return out",
