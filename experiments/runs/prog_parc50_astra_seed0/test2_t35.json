    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    separators=[c for c in range(w) if all(grid[r][c]==8 for r in range(h))]\n    bounds=[-1]+separators+[w]\n    spans=[(a+1,b) for a,b in zip(bounds,bounds[1:]) if b>a+1]\n    panels=[[[grid[r][c] for c in range(a,b)] for r in range(h)] for a,b in spans]\n    def key(p):\n        positions=[c for row in p for c,v in enumerate(row) if v not in (0,8)]\n        return min(positions) if positions else -1\n    panels.sort(key=key)\n    out=[row[:] for row in grid]\n    for (a,b),p in zip(spans,panels):\n        for r in range(h):\n            out[r][a:b]=p[r]\n    return out",
