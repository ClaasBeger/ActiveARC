    "program_source": "def transform(grid):\n    pts=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v==5]\n    top=min(r for r,c in pts); bottom=max(r for r,c in pts)\n    left=min(c for r,c in pts); right=max(c for r,c in pts)\n    h=bottom-top; w=right-left-1\n    out=[[0]*w for _ in range(h)]\n    for j in range(w):\n        n=sum(grid[r][left+1+j]==2 for r in range(len(grid)))\n        for k in range(min(n,h)):\n            out[h-1-k][j]=2\n    return out",
