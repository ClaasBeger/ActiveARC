    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    mh,mw=h//2,w//2\n    cells=[(r,c,v) for r,row in enumerate(grid) for c,v in enumerate(row) if v]\n    top=[r for r,c,v in cells if r<mh]\n    bot=[r for r,c,v in cells if r>=mh]\n    left=[c for r,c,v in cells if c<mw]\n    right=[c for r,c,v in cells if c>=mw]\n    dt=mh-1-max(top) if top else 0\n    db=mh-min(bot) if bot else 0\n    dl=mw-1-max(left) if left else 0\n    dr=mw-min(right) if right else 0\n    out=[[0]*w for _ in range(h)]\n    for r,c,v in cells:\n        out[r+(dt if r<mh else db)][c+(dl if c<mw else dr)]=v\n    return out",
