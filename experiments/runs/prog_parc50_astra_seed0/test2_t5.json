    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[[0 if v==8 else v for v in row] for row in grid]\n    n=sum(row.count(8) for row in grid)\n    r=h-1\n    while n>0 and r>=0:\n        k=min(n,w)\n        start=(w-k)//2\n        for c in range(start,start+k): out[r][c]=8\n        n-=k\n        r-=1\n    return out\n",
