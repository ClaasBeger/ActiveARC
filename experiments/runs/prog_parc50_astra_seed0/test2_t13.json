    "program_source": "def transform(grid):\n from collections import Counter\n out=[r[:] for r in grid]\n h,w=len(grid),len(grid[0])\n pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c] not in (0,3)]\n if not pts:return out\n t=min(r for r,c in pts); b=max(r for r,c in pts); l=min(c for r,c in pts); rr=max(c for r,c in pts)\n rings={}\n for r,c in pts:\n  d=min(r-t,b-r,c-l,rr-c)\n  rings.setdefault(d,Counter())[grid[r][c]]+=1\n colors={d:v.most_common(1)[0][0] for d,v in rings.items()}\n n=0\n for r in range(h):\n  for c in range(w):\n   if grid[r][c]==3:\n    d=min(r-t,b-r,c-l,rr-c)\n    if d<0:out[r][c]=0;continue\n    seq=[colors[k] for k in sorted(colors) if k<=d]\n    if not seq:seq=[colors[min(colors)]]\n    out[r][c]=seq[-1]\n    depth=sum(i==0 or x!=seq[i-1] for i,x in enumerate(seq))\n    n=max(n,depth)\n for r in range(max(0,h-n),h):out[r][w-1]=9\n return out",
