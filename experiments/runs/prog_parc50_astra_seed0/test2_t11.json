    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[row[:] for row in grid]\n    seeds=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==2]\n    ends=set()\n    for sr,sc in seeds:\n        for dr,dc in [(-1,-1),(-1,1),(1,-1),(1,1)]:\n            r,c=sr,sc\n            seen=set()\n            while (r,c,dr,dc) not in seen:\n                seen.add((r,c,dr,dc))\n                if not 0<=r+dr<h: dr=-dr\n                if not 0<=c+dc<w: dc=-dc\n                r+=dr; c+=dc\n                if not (0<=r<h and 0<=c<w): break\n                out[r][c]=2\n                if r==sr or c==sc:\n                    ends.add((r,c))\n                    break\n    for r,c in ends:\n        for dr,dc in [(-1,-1),(-1,1),(1,-1),(1,1)]:\n            nr,nc=r+dr,c+dc\n            if 0<=nr<h and 0<=nc<w: out[nr][nc]=3\n    for r,c in ends: out[r][c]=1\n    return out",
