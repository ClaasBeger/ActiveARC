    "program_source": "def transform(grid):\n h,w=len(grid),len(grid[0]); out=[[0]*w for _ in range(h)]; seen=set()\n for r in range(h):\n  for c in range(w):\n   col=grid[r][c]\n   if not col or (r,c) in seen: continue\n   pts=[(r,c)]; seen.add((r,c))\n   for y,x in pts:\n    for yy,xx in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n     if 0<=yy<h and 0<=xx<w and grid[yy][xx]==col and (yy,xx) not in seen:\n      seen.add((yy,xx)); pts.append((yy,xx))\n   dy,dx={3:(-1,-1),4:(1,-1),6:(-1,1),8:(1,1)}.get(col,(0,0))\n   if dy:\n    sy=min(y for y,x in pts) if dy<0 else h-1-max(y for y,x in pts)\n    sx=min(x for y,x in pts) if dx<0 else w-1-max(x for y,x in pts)\n    n=min(sy,sx)\n   else: n=0\n   for y,x in pts: out[y+n*dy][x+n*dx]=col\n return out",
