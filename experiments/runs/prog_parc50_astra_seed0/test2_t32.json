    "program_source": "def transform(grid):\n    a=[r[:] for r in grid]\n    h,w=len(a),len(a[0])\n    trans=False\n    bars=[i for i,r in enumerate(a) if len(set(r))==1 and r[0]!=0]\n    if not bars:\n        a=[list(r) for r in zip(*a)]\n        trans=True\n        bars=[i for i,r in enumerate(a) if len(set(r))==1 and r[0]!=0]\n    if not bars:\n        return [r[:] for r in grid]\n    k=bars[0]\n    before=a[:k]; after=a[k+1:]\n    def score(rows):\n        return sum(sum(v!=0 for v in r) for r in rows)/max(1,len(rows))\n    templates=before if score(before)>=score(after) else after\n    targets=range(k+1,len(a)) if templates is before else range(k)\n    for i in targets:\n        row=a[i]\n        candidates=[r for r in templates if all(v==0 or v==r[j] for j,v in enumerate(row))]\n        if candidates:\n            best=max(candidates,key=lambda r:sum(v!=0 for v in r))\n            a[i]=[v if v else best[j] for j,v in enumerate(row)]\n    return [list(r) for r in zip(*a)] if trans else a",
