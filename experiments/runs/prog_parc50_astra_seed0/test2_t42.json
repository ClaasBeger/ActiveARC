    "program_source": "def transform(grid):\n    from collections import Counter, defaultdict\n    out=[r[:] for r in grid]\n    w=len(grid[0]); half=w//2\n    votes=defaultdict(Counter)\n    for row in grid:\n        for j in range(half):\n            votes[row[j]][row[j+half]]+=1\n    mapping={a:c.most_common(1)[0][0] for a,c in votes.items()}\n    for i,row in enumerate(grid):\n        for j in range(half):\n            out[i][j+half]=mapping[row[j]]\n    return out",
