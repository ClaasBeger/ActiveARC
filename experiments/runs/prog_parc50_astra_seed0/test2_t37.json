    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    out[0]=[0]*w\n    for r in range(1,h):\n        marker=grid[r][0]\n        out[r][0]=0\n        if marker in (2,3):\n            shift=1 if marker==2 else -1\n            for c in range(1,w):\n                if grid[r][c]==5:\n                    out[r][c]=0\n            for c in range(1,w):\n                if grid[r][c]==5 and 0<=c+shift<w:\n                    out[r][c+shift]=grid[0][c] or 5\n    return out",
