    "program_source": "def transform(grid):\n    from collections import deque\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    centers=[]\n    for r in range(1,h-1):\n        for c in range(1,w-1):\n            if all(grid[r+dr][c+dc]==7 for dr,dc in [(-1,-1),(-1,1),(1,-1),(1,1)]):\n                centers.append((r,c))\n    start=next(p for p in centers if grid[p[0]][p[1]]==4)\n    end=next(p for p in centers if grid[p[0]][p[1]]==8)\n    prev={start:None}; q=deque([start])\n    while q:\n        p=q.popleft()\n        if p==end: break\n        r,c=p\n        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\n            if grid[r+dr][c+dc]!=2: continue\n            options=[v for v in centers if (dc==0 and v[1]==c and (v[0]-r)*dr>0) or (dr==0 and v[0]==r and (v[1]-c)*dc>0)]\n            if not options: continue\n            v=min(options,key=lambda v:abs(v[0]-r)+abs(v[1]-c))\n            if v not in prev:\n                prev[v]=(p,(r+dr,c+dc)); q.append(v)\n    if end in prev:\n        p=end\n        while prev[p] is not None:\n            parent,door=prev[p]\n            out[door[0]][door[1]]=5\n            p=parent\n        out[start[0]][start[1]]=0\n        out[end[0]][end[1]]=4\n    return out",
