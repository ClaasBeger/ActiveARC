    "program_source": "def transform(grid):\n h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\n vertical=[c for c in range(w) if grid[0][c]!=0 and all(grid[r][c]==grid[0][c] for r in range(h))]\n if not vertical:\n  t=transform([list(r) for r in zip(*grid)])\n  return [list(r) for r in zip(*t)]\n mid=min(vertical,key=lambda c:abs(c-(w-1)/2)); shift=mid+1\n seen=set(); moves=[]\n for r in range(h):\n  for c in range(w):\n   if c==mid or grid[r][c]==0 or (r,c) in seen: continue\n   color=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); obj=[]\n   while stack:\n    y,x=stack.pop(); obj.append((y,x))\n    for a,b in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n     if 0<=a<h and 0<=b<w and b!=mid and (a,b) not in seen and grid[a][b]==color:\n      seen.add((a,b)); stack.append((a,b))\n   d=shift if c<mid else -shift\n   target=[(y,x+d) for y,x in obj]\n   if all(0<=x<w and grid[y][x]==0 for y,x in target): moves.append((obj,target,color))\n for obj,target,color in moves:\n  for y,x in obj: out[y][x]=0\n for obj,target,color in moves:\n  for y,x in target: out[y][x]=color\n return out",
