    "program_source": "def transform(grid):\n    groups={}\n    for r,row in enumerate(grid):\n        for c,x in enumerate(row):\n            if x: groups.setdefault(x,[]).append((r,c))\n    pieces=[]\n    for color,pts in groups.items():\n        a=min(r for r,c in pts); b=min(c for r,c in pts)\n        pts=[(r-a,c-b) for r,c in pts]\n        pieces.append((color,pts,max(r for r,c in pts)+1,max(c for r,c in pts)+1))\n    n=sum(len(p[1]) for p in pieces)\n    dims=[(h,n//h) for h in range(1,n+1) if n%h==0]\n    dims.sort(key=lambda hw:(abs(hw[0]-hw[1]),hw[0]<hw[1]))\n    for H,W in dims:\n        if any(h>H or w>W for _,_,h,w in pieces): continue\n        choices=[[] for _ in range(n)]\n        bypiece=[]\n        for i,(color,pts,h,w) in enumerate(pieces):\n            opts=[]\n            for r in range(H-h+1):\n                for c in range(W-w+1):\n                    cells=[(r+a)*W+c+b for a,b in pts]\n                    mask=sum(1<<x for x in cells)\n                    opt=(i,mask,cells)\n                    opts.append(opt)\n                    for x in cells: choices[x].append(opt)\n            bypiece.append(opts)\n        full=(1<<n)-1\n        failed=set()\n        def solve(occ,used,path):\n            if occ==full: return path\n            key=(occ,used)\n            if key in failed: return None\n            best=None\n            for x in range(n):\n                if occ>>x&1: continue\n                opts=[p for p in choices[x] if not (used>>p[0]&1) and not (occ&p[1])]\n                if not opts: failed.add(key); return None\n                if best is None or len(opts)<len(best): best=opts\n                if len(best)==1: break\n            for i,mask,cells in best:\n                result=solve(occ|mask,used|1<<i,path+[(i,cells)])\n                if result is not None: return result\n            failed.add(key)\n            return None\n        ans=solve(0,0,[])\n        if ans is not None:\n            out=[[0]*W for _ in range(H)]\n            for i,cells in ans:\n                for x in cells: out[x//W][x%W]=pieces[i][0]\n            return out\n    return grid",
