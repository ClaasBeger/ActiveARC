    "program_source": "def transform(grid):\n import itertools, math\n H,W=len(grid),len(grid[0]); seen=set(); pieces=[]; origins=[]; colors=[]\n for r in range(H):\n  for c in range(W):\n   if grid[r][c] and (r,c) not in seen:\n    color=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); pts=[]\n    while stack:\n     x,y=stack.pop(); pts.append((x,y))\n     for a,b in ((x+1,y),(x-1,y),(x,y+1),(x,y-1)):\n      if 0<=a<H and 0<=b<W and (a,b) not in seen and grid[a][b]==color:\n       seen.add((a,b)); stack.append((a,b))\n    x=min(a for a,b in pts); y=min(b for a,b in pts)\n    pieces.append(frozenset((a-x,b-y) for a,b in pts)); origins.append((x,y)); colors.append(color)\n def norm(p):\n  x=min(a for a,b in p); y=min(b for a,b in p)\n  return frozenset((a-x,b-y) for a,b in p)\n variants=[]\n for p in pieces:\n  v=[]\n  for _ in range(4):\n   if p not in v:v.append(p)\n   p=norm([(b,-a) for a,b in p])\n  variants.append(v)\n def tile(ids,n):\n  options=[[] for _ in range(n*n)]\n  for i in ids:\n   for p in variants[i]:\n    h=max(a for a,b in p)+1; w=max(b for a,b in p)+1\n    for x in range(n-h+1):\n     for y in range(n-w+1):\n      pts=frozenset((a+x,b+y) for a,b in p); mask=sum(1<<(a*n+b) for a,b in pts)\n      for a,b in pts:options[a*n+b].append((i,mask,pts))\n  full=(1<<(n*n))-1\n  def rec(mask,used,sol):\n   if mask==full:return sol\n   best=None\n   for k in range(n*n):\n    if not (mask>>k)&1:\n     poss=[p for p in options[k] if p[0] not in used and not p[1]&mask]\n     if not poss:return None\n     if best is None or len(poss)<len(best):best=poss\n   for i,m,p in best:\n    ans=rec(mask|m,used|{i},sol+[(i,p)])\n    if ans is not None:return ans\n   return None\n  return rec(0,set(),[])\n remaining=set(range(len(pieces))); groups=[]\n while remaining:\n  found=False\n  for count in range(1,len(remaining)+1):\n   for ids in itertools.combinations(sorted(remaining),count):\n    area=sum(len(pieces[i]) for i in ids); n=math.isqrt(area)\n    if n*n!=area:continue\n    sol=tile(ids,n)\n    if sol is not None:\n     groups.append((n,sol)); remaining.difference_update(ids); found=True; break\n   if found:break\n  if not found:break\n out=[row[:] for row in grid]\n for n,sol in groups:\n  for anchor,_ in sol:\n   forms=sol\n   for turn in range(4):\n    p=dict(forms)[anchor]\n    if norm(p)==pieces[anchor]:\n     dx=origins[anchor][0]-min(a for a,b in p); dy=origins[anchor][1]-min(b for a,b in p)\n     if 0<=dx and dx+n<=H and 0<=dy and dy+n<=W:\n      for i,pts in forms:\n       for a,b in pts:out[a+dx][b+dy]=colors[i]\n      break\n    forms=[(i,frozenset((b,n-1-a) for a,b in pts)) for i,pts in forms]\n return out",
