    "program_source": "def transform(grid):\n h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\n seen=set(); comps=[]\n for r in range(h):\n  for c in range(w):\n   if grid[r][c] and (r,c) not in seen:\n    seen.add((r,c)); q=[(r,c)]\n    for y,x in q:\n     for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n      a,b=y+dy,x+dx\n      if 0<=a<h and 0<=b<w and grid[a][b] and (a,b) not in seen:\n       seen.add((a,b)); q.append((a,b))\n    comps.append(q)\n if not comps:return out\n body=max(comps,key=len)\n cy=(min(r for r,c in body)+max(r for r,c in body))/2\n cx=(min(c for r,c in body)+max(c for r,c in body))/2\n others=[p for comp in comps if comp is not body for p in comp]\n for r,c in others:out[r][c]=0\n for r,c in others:\n  y=int(cy+c-cx);x=int(cx+cy-r)\n  if 0<=y<h and 0<=x<w:out[y][x]=grid[r][c]\n return out",
