    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[row[:] for row in grid]\n    nodes={(r,c) for r in range(h) for c in range(w) if grid[r][c] in (5,8)}\n    starts=[(r,c) for r,c in nodes if grid[r][c]==8]\n    for start in starts:\n        out[start[0]][start[1]]=5\n        path=[]\n        seen={}\n        p=start\n        while p not in seen:\n            seen[p]=len(path)\n            path.append(p)\n            r,c=p\n            nxt=None\n            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n                a,b=r+dr,c+dc\n                if 0<=a<h and 0<=b<w and grid[a][b]==7:\n                    while 0<=a<h and 0<=b<w:\n                        if (a,b) in nodes:\n                            nxt=(a,b)\n                            break\n                        a+=dr\n                        b+=dc\n                    if nxt is not None: break\n            if nxt is None: break\n            p=nxt\n        else:\n            cycle=path[seen[p]:]\n            for i,(r,c) in enumerate(cycle):\n                a,b=cycle[(i+1)%len(cycle)]\n                dr=(a>r)-(a<r)\n                dc=(b>c)-(b<c)\n                out[r][c]=8\n                while (r,c)!=(a,b):\n                    r+=dr\n                    c+=dc\n                    out[r][c]=8\n    return out",
