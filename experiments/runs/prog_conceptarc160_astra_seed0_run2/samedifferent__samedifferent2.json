          {
            "arguments": "{\"code\":\"def transform(grid):\\n    h,w=len(grid),len(grid[0]); seen=set(); objects=[]\\n    for r in range(h):\\n        for c in range(w):\\n            if grid[r][c]==0 or (r,c) in seen: continue\\n            color=grid[r][c]; cells=[]; stack=[(r,c)]; seen.add((r,c))\\n            while stack:\\n                a,b=stack.pop(); cells.append((a,b))\\n                for x,y in ((a-1,b),(a+1,b),(a,b-1),(a,b+1)):\\n                    if 0<=x<h and 0<=y<w and (x,y) not in seen and grid[x][y]==color:\\n                        seen.add((x,y)); stack.append((x,y))\\n            mr=min(a for a,b in cells); mc=min(b for a,b in cells)\\n            key=tuple(sorted((a-mr,b-mc) for a,b in cells))\\n            objects.append((key,cells))\\n    from collections import Counter\\n    counts=Counter(k for k,c in objects)\\n    out=[row[:] for row in grid]\\n    for key,cells in objects:\\n        if counts[key]==1:\\n            for r,c in cells: out[r][c]=0\\n    return out\"}",
