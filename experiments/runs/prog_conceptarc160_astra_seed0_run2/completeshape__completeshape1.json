            "arguments": "{\"code\":\"def transform(grid):\\n    from collections import Counter\\n    h,w=len(grid),len(grid[0])\\n    pts=[(r,c,grid[r][c]) for r in range(h) for c in range(w) if grid[r][c]]\\n    out=[row[:] for row in grid]\\n    if not pts:return out\\n    candidates=[]\\n    for r in range(h):\\n        for c in range(w):\\n            ds=[abs(y-r)+abs(x-c) for y,x,v in pts]\\n            if min(ds)==max(ds):\\n                d=ds[0]\\n                if d and r-d>=0 and r+d<h and c-d>=0 and c+d<w:\\n                    candidates.append((d,r,c))\\n    if not candidates:return out\\n    d,r,c=min(candidates)\\n    colors={p:Counter(v for y,x,v in pts if y%2==p) for p in (0,1)}\\n    fallback=Counter(v for y,x,v in pts).most_common(1)[0][0]\\n    for y in range(r-d,r+d+1):\\n        dx=d-abs(y-r)\\n        for x in {c-dx,c+dx}:\\n            out[y][x]=colors[y%2].most_common(1)[0][0] if colors[y%2] else fallback\\n    return out\"}",
