    "program_source": "def transform(grid):\n    out=[row[:] for row in grid]\n    h=len(grid); w=len(grid[0])\n    cells=[(r,c) for r in range(h) for c in range(w) if grid[r][c]!=0]\n    if not cells: return out\n    r0=min(r for r,c in cells); r1=max(r for r,c in cells)\n    c0=min(c for r,c in cells); c1=max(c for r,c in cells)\n    vertical=all(grid[r][c]==grid[r0][c] for r in range(r0,r1+1) for c in range(c0,c1+1))\n    if vertical:\n        out[0]=[8]*w\n    else:\n        for row in out: row[-1]=8\n    return out",
