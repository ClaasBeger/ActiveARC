    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    seen=set(); stack=[]\n    for r in range(h):\n        for c in range(w):\n            if (r in (0,h-1) or c in (0,w-1)) and grid[r][c]!=4:\n                seen.add((r,c)); stack.append((r,c))\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            a,b=r+dr,c+dc\n            if 0<=a<h and 0<=b<w and grid[a][b]!=4 and (a,b) not in seen:\n                seen.add((a,b));stack.append((a,b))\n    return [[0] for _ in range(sum(grid[r][c]==3 for r,c in seen))]\n",
