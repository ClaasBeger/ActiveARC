    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    colors=set(sum(grid,[]))-{0}\n    best=None\n    for transpose in (False,True):\n        g=grid if not transpose else [list(r) for r in zip(*grid)]\n        n,m=len(g),len(g[0])\n        for col in colors:\n            for lo in range(m):\n                for hi in range(lo+1,m):\n                    d=hi-lo\n                    for phase in range(2*d):\n                        path=[lo+d-abs((i+phase)%(2*d)-d) for i in range(n)]\n                        hit=sum(g[i][path[i]]==col for i in range(n))\n                        score=(hit/n,hit,n)\n                        if best is None or score>best[0]:\n                            best=(score,transpose,col,path)\n    out=[[0]*w for _ in range(h)]\n    if best:\n        _,t,c,p=best\n        for i,j in enumerate(p):\n            r,k=(j,i) if t else (i,j)\n            if grid[r][k]==c: out[r][k]=c\n    return out",
