            "arguments": "{\"code\":\"def transform(grid):\\n    from collections import Counter\\n    h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]; seen=set()\\n    for r in range(h):\\n        for c in range(w):\\n            if grid[r][c]!=0 or (r,c) in seen: continue\\n            seen.add((r,c)); comp=[(r,c)]; edge=False; colors=Counter()\\n            for y,x in comp:\\n                if y==0 or x==0 or y==h-1 or x==w-1: edge=True\\n                for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\\n                    a,b=y+dy,x+dx\\n                    if 0<=a<h and 0<=b<w:\\n                        if grid[a][b]: colors[grid[a][b]]+=1\\n                        elif (a,b) not in seen:\\n                            seen.add((a,b)); comp.append((a,b))\\n            if not edge and colors:\\n                color=colors.most_common(1)[0][0]\\n                for y,x in comp: out[y][x]=color\\n    return out\"}",
