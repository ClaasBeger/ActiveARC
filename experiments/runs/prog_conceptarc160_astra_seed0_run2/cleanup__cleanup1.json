    "program_source": "def transform(grid):\n    from collections import Counter\n    h,w=len(grid),len(grid[0])\n    rows=[Counter(row).most_common(1)[0][0] for row in grid]\n    cols=[Counter(grid[r][c] for r in range(h)).most_common(1)[0][0] for c in range(w)]\n    er=sum(grid[r][c]!=rows[r] for r in range(h) for c in range(w))\n    ec=sum(grid[r][c]!=cols[c] for r in range(h) for c in range(w))\n    return [[rows[r] if er<=ec else cols[c] for c in range(w)] for r in range(h)]",
