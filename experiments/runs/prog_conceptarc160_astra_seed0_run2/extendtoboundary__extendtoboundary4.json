    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    from collections import defaultdict\n    g=[r[:] for r in grid]; h=len(g); w=len(g[0]); p=defaultdict(list)\n    for r in range(h):\n        for c in range(w):\n            if g[r][c]: p[g[r][c]].append((r,c))\n    if len(p)<2:return g\n    wall=max(p,key=lambda x:len(p[x])); pts=p[wall]\n    rs=[r for r,c in pts]; cs=[c for r,c in pts]\n    if len(set(rs))==1: nr,nc=1,0\n    elif len(set(cs))==1: nr,nc=0,1\n    elif len(set(r+c for r,c in pts))==1: nr,nc=1,1\n    else: nr,nc=1,-1\n    level=sum(nr*r+nc*c for r,c in pts)/len(pts)\n    for color, seeds in p.items():\n        if color==wall:continue\n        for r,c in seeds:\n            v=nr*r+nc*c\n            sign=1 if level>v else -1\n            dr,dc=nr*sign,nc*sign\n            r+=dr;c+=dc\n            while 0<=r<h and 0<=c<w and (nr*r+nc*c-level)*sign<0:\n                if g[r][c]!=0:break\n                g[r][c]=color\n                r+=dr;c+=dc\n    return g",
