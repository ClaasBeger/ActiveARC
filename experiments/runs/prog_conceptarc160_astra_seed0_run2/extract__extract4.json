            "arguments": "{\"code\":\"def transform(grid):\\n    h,w=len(grid),len(grid[0])\\n    colors=set(sum(grid,[]))-{0}\\n    choices=[]\\n    for color in colors:\\n        for transpose in (False,True):\\n            a=[list(x) for x in zip(*grid)] if transpose else grid\\n            H,W=len(a),len(a[0])\\n            full={r for r in range(H) if all(v==color for v in a[r])}\\n            pts=[(r,c) for r in range(H) if r not in full for c in range(W) if a[r][c]==color]\\n            if not full or not pts: continue\\n            r0=min(r for r,c in pts);r1=max(r for r,c in pts)\\n            c0=min(c for r,c in pts);c1=max(c for r,c in pts)\\n            while r0>0 and all(a[r0-1][c]==color for c in range(c0,c1+1)):r0-=1\\n            while r1+1<H and all(a[r1+1][c]==color for c in range(c0,c1+1)):r1+=1\\n            hh,ww=r1-r0+1,c1-c0+1\\n            if transpose: hh,ww=ww,hh\\n            choices.append((len(full)*W,hh,ww,color))\\n    if choices:\\n        _,hh,ww,color=max(choices)\\n        return [[color]*ww for _ in range(hh)]\\n    return [r[:] for r in grid]\\n\"}",
