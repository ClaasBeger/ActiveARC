    "program_source": "def transform(grid):\n    from collections import Counter\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    rows={}\n    cols={}\n    for r in range(h):\n        if all(grid[r][c]!=0 for c in range(w)):\n            rows[r]=Counter(grid[r]).most_common(1)[0][0]\n    for c in range(w):\n        if all(grid[r][c]!=0 for r in range(h)):\n            cols[c]=Counter(grid[r][c] for r in range(h)).most_common(1)[0][0]\n    for r,a in rows.items():\n        for c,b in cols.items():\n            if a!=b:\n                out[r][c]=b if grid[r][c]==a else a\n    return out",
