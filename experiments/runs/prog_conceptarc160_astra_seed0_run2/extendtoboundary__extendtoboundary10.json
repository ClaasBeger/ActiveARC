    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    walls=[(r,c) for r in range(h) for c in range(w) if grid[r][c] not in (0,1)]\n    if not walls: return out\n    top=min(r for r,c in walls); bottom=max(r for r,c in walls)\n    left=min(c for r,c in walls); right=max(c for r,c in walls)\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]!=1: continue\n            dirs=[]\n            if r<top and left<c<right: dirs.append((1,0))\n            if r>bottom and left<c<right: dirs.append((-1,0))\n            if c<left and top<r<bottom: dirs.append((0,1))\n            if c>right and top<r<bottom: dirs.append((0,-1))\n            for dr,dc in dirs:\n                y,x=r+dr,c+dc\n                while 0<=y<h and 0<=x<w and grid[y][x] in (0,1):\n                    out[y][x]=1\n                    y+=dr; x+=dc\n    return out",
