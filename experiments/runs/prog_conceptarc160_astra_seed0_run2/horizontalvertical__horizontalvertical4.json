    "program_source": "def transform(grid):\n    h=len(grid); w=len(grid[0]); out=[r[:] for r in grid]; seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]!=2 or (r,c) in seen: continue\n            seen.add((r,c)); comp=[(r,c)]\n            for y,x in comp:\n                for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n                    a,b=y+dy,x+dx\n                    if 0<=a<h and 0<=b<w and grid[a][b]==2 and (a,b) not in seen:\n                        seen.add((a,b)); comp.append((a,b))\n            if max(x for y,x in comp)-min(x for y,x in comp)>max(y for y,x in comp)-min(y for y,x in comp):\n                for y,x in comp: out[y][x]=3\n    return out",
