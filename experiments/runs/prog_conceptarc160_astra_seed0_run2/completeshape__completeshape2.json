    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    groups={}\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]: groups.setdefault(grid[r][c],[]).append((r,c))\n    horizontal=[]\n    for color, pts in groups.items():\n        rs=set(r for r,c in pts); cs=set(c for r,c in pts)\n        if len(rs)==1:\n            horizontal.append((next(iter(rs)),color))\n        elif len(cs)==1:\n            c=next(iter(cs))\n            for r in range(h): out[r][c]=color\n    for r,color in horizontal:\n        out[r]=[color]*w\n    return out",
