    "program_source": "def transform(grid):\n    h=len(grid); w=len(grid[0]); out=[row[:] for row in grid]; seen=set()\n    for r in range(h):\n        for c in range(w):\n            if not grid[r][c] or (r,c) in seen: continue\n            color=grid[r][c]; comp=[]; stack=[(r,c)]; seen.add((r,c))\n            while stack:\n                y,x=stack.pop(); comp.append((y,x))\n                for dy in (-1,0,1):\n                    for dx in (-1,0,1):\n                        ny,nx=y+dy,x+dx\n                        if 0<=ny<h and 0<=nx<w and (ny,nx) not in seen and grid[ny][nx]==color:\n                            seen.add((ny,nx)); stack.append((ny,nx))\n            top=min(y for y,x in comp)\n            for y,x in comp:\n                if y==top: out[y][x]=2\n    return out",
