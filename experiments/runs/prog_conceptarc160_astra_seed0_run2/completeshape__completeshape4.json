    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[[0]*w for _ in range(h)]\n    colors=set(v for row in grid for v in row)-{0}\n    for color in colors:\n        pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==color]\n        a=min(r for r,c in pts); b=max(r for r,c in pts)\n        x=min(c for r,c in pts); y=max(c for r,c in pts)\n        vertical=all(c in (x,y) for r,c in pts)\n        if vertical:\n            for c in range(x+1,y):\n                out[a][c]=out[b][c]=color\n        else:\n            for r in range(a+1,b):\n                out[r][x]=out[r][y]=color\n    return out",
