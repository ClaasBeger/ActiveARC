    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    colors=set(sum(grid,[]))-{0}\n    boxes={}\n    for c in colors:\n        pts=[(r,k) for r in range(h) for k in range(w) if grid[r][k]==c]\n        a,b=min(r for r,k in pts),max(r for r,k in pts)\n        l,t=min(k for r,k in pts),max(k for r,k in pts)\n        boxes[c]=(a,b,l,t,len(pts))\n    out=[[0]*w for _ in range(h)]\n    for c,(a,b,l,t,n) in boxes.items():\n        if n<(b-a+1)*(t-l+1):\n            for r in range(a,b+1):\n                for k in range(l,t+1): out[r][k]=c\n    return out",
