    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    colors=set(v for row in grid for v in row)-{0}\n    candidates=[]\n    for c in colors:\n        pts=[(r,k) for r in range(h) for k in range(w) if grid[r][k]==c]\n        a,b=min(r for r,k in pts),max(r for r,k in pts)\n        l,t=min(k for r,k in pts),max(k for r,k in pts)\n        if b-a<2 or t-l<2: continue\n        perimeter=[(r,k) for r in range(a,b+1) for k in range(l,t+1) if r in (a,b) or k in (l,t)]\n        score=sum(grid[r][k]==c for r,k in perimeter)/len(perimeter)\n        candidates.append((score,c,a,b,l,t))\n    if not candidates: return [row[:] for row in grid]\n    _,c,a,b,l,t=max(candidates)\n    out=[[0]*w for _ in range(h)]\n    for r in range(a,b+1):\n        for k in range(l,t+1):\n            out[r][k]=c if r in (a,b) or k in (l,t) else grid[r][k]\n    return out",
