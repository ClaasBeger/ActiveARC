            "arguments": "{\"code\":\"def transform(grid):\\n    from collections import Counter\\n    h,w=len(grid),len(grid[0])\\n    variants=[]\\n    for transpose in (False,True):\\n        a=[list(r) for r in zip(*grid)] if transpose else grid\\n        colors=set(v for row in a for v in row)\\n        for c in colors:\\n            if all(len(set(row)-{c})<=1 for row in a):\\n                points=[]\\n                for i,row in enumerate(a):\\n                    if len(set(row))>1:\\n                        for j,v in enumerate(row):\\n                            if v==c: points.append((j,i) if transpose else (i,j))\\n                if points: variants.append((len(points),points,c))\\n    if variants:\\n        _,pts,c=min(variants,key=lambda x:x[0])\\n    else:\\n        pts=[]\\n        for i,row in enumerate(grid):\\n            bg=Counter(row).most_common(1)[0][0]\\n            pts.extend((i,j) for j,v in enumerate(row) if v!=bg)\\n        if not pts:return [row[:] for row in grid]\\n    r0=min(i for i,j in pts);r1=max(i for i,j in pts)\\n    c0=min(j for i,j in pts);c1=max(j for i,j in pts)\\n    out=[[0]*(c1-c0+1) for _ in range(r1-r0+1)]\\n    for i,j in pts:out[i-r0][j-c0]=grid[i][j]\\n    return out\"}",
