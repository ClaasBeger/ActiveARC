    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    h=len(grid)\n    for r,row in enumerate(grid):\n        for c,v in enumerate(row):\n            if v==3:\n                for d in (-1,1):\n                    y=r+d\n                    while 0<=y<h and grid[y][c] in (0,3):\n                        out[y][c]=3\n                        y+=d\n    return out",
