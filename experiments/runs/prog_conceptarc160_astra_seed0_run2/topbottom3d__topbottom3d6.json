    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    colors=set(v for row in grid for v in row)-{0}\n    boxes={}\n    for c in colors:\n        pts=[(r,k) for r,row in enumerate(grid) for k,v in enumerate(row) if v==c]\n        boxes[c]=(min(r for r,k in pts),max(r for r,k in pts),min(k for r,k in pts),max(k for r,k in pts))\n    above={c:set() for c in colors}\n    for c,(r0,r1,c0,c1) in boxes.items():\n        above[c]={grid[r][k] for r in range(r0,r1+1) for k in range(c0,c1+1)}-{0,c}\n    covered=set().union(*above.values())\n    candidates=colors-covered\n    if not candidates: candidates=colors\n    def score(c):\n        seen=set(); todo=list(above[c])\n        while todo:\n            x=todo.pop()\n            if x in seen: continue\n            seen.add(x); todo.extend(above.get(x,set())-seen)\n        a,b,d,e=boxes[c]\n        return (len(seen),(b-a+1)*(e-d+1))\n    c=max(candidates,key=score)\n    a,b,d,e=boxes[c]\n    return [[c]*(e-d+1) for _ in range(b-a+1)]",
