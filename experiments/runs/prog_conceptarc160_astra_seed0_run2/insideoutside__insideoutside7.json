    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    candidates=[]\n    for color in range(1,10):\n        pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==color]\n        if not pts: continue\n        a,b=min(r for r,c in pts),max(r for r,c in pts)\n        l,u=min(c for r,c in pts),max(c for r,c in pts)\n        if b-a>=2 and u-l>=2:\n            edge=[grid[r][c] for r in range(a,b+1) for c in range(l,u+1) if r in (a,b) or c in (l,u)]\n            if all(v==color for v in edge):\n                candidates.append(((b-a)*(u-l),color,a,b,l,u))\n    if not candidates: return [[]]\n    _,color,a,b,l,u=max(candidates)\n    n=sum(grid[r][c]!=0 for r in range(a+1,b) for c in range(l+1,u))\n    return [[color]*n]",
