    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    best=None\n    for r in range(h-2):\n        for c in range(w-2):\n            color=grid[r][c]\n            if color==0: continue\n            for b in range(r+2,h):\n                if any(grid[y][c]!=color for y in range(r,b+1)): break\n                for d in range(c+2,w):\n                    if any(grid[r][x]!=color for x in range(c,d+1)): break\n                    if all(grid[b][x]==color for x in range(c,d+1)) and all(grid[y][d]==color for y in range(r,b+1)):\n                        area=(b-r+1)*(d-c+1)\n                        if best is None or area>best[0]: best=(area,r,c,b,d)\n    if best:\n        _,r,c,b,d=best\n        return [row[c+1:d] for row in grid[r+1:b]]\n    return [row[:] for row in grid]",
