    "program_source": "def transform(grid):\n    pts=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v==3]\n    if pts:\n        a=min(r for r,c in pts); b=max(r for r,c in pts)\n        l=min(c for r,c in pts); h=max(c for r,c in pts)\n        n=sum(grid[r][c]==5 for r in range(a+1,b) for c in range(l+1,h))\n    else:\n        n=0\n    return [[4 if i<n else 0] for i in range(7)]",
