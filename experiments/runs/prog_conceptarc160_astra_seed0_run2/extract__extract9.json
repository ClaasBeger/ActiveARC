    "program_source": "def transform(grid):\n    pts=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v not in (0,5)]\n    if not pts: return [row[:] for row in grid]\n    a=min(r for r,c in pts); b=max(r for r,c in pts)\n    x=min(c for r,c in pts); y=max(c for r,c in pts)\n    return [[0 if grid[r][c]==5 else grid[r][c] for c in range(x,y+1)] for r in range(a,b+1)]",
