    "program_source": "def transform(grid):\n    from collections import Counter\n    h,w=len(grid),len(grid[0])\n    seen=set(); counts=Counter()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            stack=[(r,c)]; seen.add((r,c)); comp=[]\n            while stack:\n                a,b=stack.pop(); comp.append((a,b))\n                for da,db in ((1,0),(-1,0),(0,1),(0,-1)):\n                    x,y=a+da,b+db\n                    if 0<=x<h and 0<=y<w and grid[x][y]!=0 and (x,y) not in seen:\n                        seen.add((x,y)); stack.append((x,y))\n            cells=set(comp)\n            border=Counter(grid[a][b] for a,b in comp if any((a+da,b+db) not in cells for da,db in ((1,0),(-1,0),(0,1),(0,-1))))\n            outer=border.most_common(1)[0][0]\n            colors=set(grid[a][b] for a,b in comp)-{outer}\n            counts.update(colors)\n    if counts: return [[counts.most_common(1)[0][0]]]\n    return [[0]]",
