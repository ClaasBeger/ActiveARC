    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    colors={v for row in grid for v in row if v}\n    groups=[]\n    for c in colors:\n        pts=[(r,k) for r in range(h) for k in range(w) if grid[r][k]==c]\n        groups.append(pts)\n    groups.sort(key=lambda pts:min(k for r,k in pts))\n    out=[[0]*w for _ in range(h)]\n    for i,pts in enumerate(groups):\n        lo=min(k for r,k in pts); hi=max(k for r,k in pts)\n        shift=-lo if i==0 else w-1-hi\n        for r,k in pts: out[r][k+shift]=grid[r][k]\n    return out",
