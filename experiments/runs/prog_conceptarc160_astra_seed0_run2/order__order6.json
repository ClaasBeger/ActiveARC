    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    colors={v for row in grid for v in row if v!=0}\n    objects=[]\n    for color in colors:\n        pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==color]\n        top=min(r for r,c in pts)\n        objects.append((top,len(pts),color,[(r-top,c) for r,c in pts]))\n    slots=sorted(o[0] for o in objects)\n    objects.sort(key=lambda o:(o[1],o[0]))\n    out=[[0]*w for _ in range(h)]\n    for top,obj in zip(slots,objects):\n        for dr,c in obj[3]:\n            if top+dr<h: out[top+dr][c]=obj[2]\n    return out",
