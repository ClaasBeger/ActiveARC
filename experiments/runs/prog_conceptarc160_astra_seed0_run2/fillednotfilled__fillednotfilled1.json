    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            col=grid[r][c]\n            if col==0 or (r,c) in seen: continue\n            comp={(r,c)}; seen.add((r,c)); todo=[(r,c)]\n            while todo:\n                y,x=todo.pop()\n                for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n                    a,b=y+dy,x+dx\n                    if 0<=a<h and 0<=b<w and grid[a][b]==col and (a,b) not in seen:\n                        seen.add((a,b));comp.add((a,b));todo.append((a,b))\n            ys=[p[0] for p in comp]; xs=[p[1] for p in comp]\n            if len(comp)<(max(ys)-min(ys)+1)*(max(xs)-min(xs)+1):\n                return [[col]]\n    return [[0]]",
