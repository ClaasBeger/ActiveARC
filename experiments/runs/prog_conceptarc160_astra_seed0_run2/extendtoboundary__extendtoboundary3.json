    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    out=[row[:] for row in grid]\n    h,w=len(grid),len(grid[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]!=0]\n    if not pts: return out\n    rows=[sum(r==i for r,c in pts) for i in range(h)]\n    cols=[sum(c==j for r,c in pts) for j in range(w)]\n    if max(cols)>=max(rows):\n        axis=cols.index(max(cols))\n        for r,c in pts:\n            if c!=axis:\n                color=grid[r][c]\n                for j in range(min(c,axis),max(c,axis)+1): out[r][j]=color\n    else:\n        axis=rows.index(max(rows))\n        for r,c in pts:\n            if r!=axis:\n                color=grid[r][c]\n                for i in range(min(r,axis),max(r,axis)+1): out[i][c]=color\n    return out",
