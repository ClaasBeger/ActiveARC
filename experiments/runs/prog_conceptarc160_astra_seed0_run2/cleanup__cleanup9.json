    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    from collections import Counter\n    h,w=len(grid),len(grid[0])\n    counts=Counter(v for row in grid for v in row if v)\n    out=[[0]*w for _ in range(h)]\n    if not counts: return out\n    color=counts.most_common(1)[0][0]\n    points=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==color]\n    top=min(r for r,c in points); bottom=max(r for r,c in points)\n    left=min(c for r,c in points); right=max(c for r,c in points)\n    for r in range(top,bottom+1):\n        for c in range(left,right+1):\n            if r in (top,bottom) or c in (left,right): out[r][c]=color\n    return out",
