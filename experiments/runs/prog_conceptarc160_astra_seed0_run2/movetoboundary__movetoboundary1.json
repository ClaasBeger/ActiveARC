    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==1]\n    if not pts: return out\n    rows=[r for r in range(h) if all(x==2 for x in grid[r])]\n    cols=[c for c in range(w) if all(grid[r][c]==2 for r in range(h))]\n    dr=dc=0\n    if rows:\n        line=min(rows,key=lambda r:min(abs(r-a) for a,b in pts))\n        lo=min(r for r,c in pts); hi=max(r for r,c in pts)\n        dr=line-1-hi if hi<line else line+1-lo\n    elif cols:\n        line=min(cols,key=lambda c:min(abs(c-b) for a,b in pts))\n        lo=min(c for r,c in pts); hi=max(c for r,c in pts)\n        dc=line-1-hi if hi<line else line+1-lo\n    for r,c in pts: out[r][c]=0\n    for r,c in pts:\n        if 0<=r+dr<h and 0<=c+dc<w: out[r+dr][c+dc]=1\n    return out",
