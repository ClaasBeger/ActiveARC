    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\n    seen=set(); frames=[]\n    for r in range(h):\n        for c in range(w):\n            if not grid[r][c] or (r,c) in seen: continue\n            color=grid[r][c]; stack=[(r,c)];seen.add((r,c));comp=[]\n            while stack:\n                y,x=stack.pop();comp.append((y,x))\n                for yy,xx in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                    if 0<=yy<h and 0<=xx<w and (yy,xx) not in seen and grid[yy][xx]==color:\n                        seen.add((yy,xx));stack.append((yy,xx))\n            a=min(y for y,x in comp); b=max(y for y,x in comp); l=min(x for y,x in comp); t=max(x for y,x in comp)\n            if b-a>=2 and t-l>=2 and all(grid[y][x]==color for y in range(a,b+1) for x in range(l,t+1) if y in (a,b) or x in (l,t)):\n                frames.append((a,b,l,t))\n    for a,b,l,t in frames:\n        pts=[(y,x) for y in range(a+1,b) for x in range(l+1,t) if grid[y][x]!=0]\n        if not pts: continue\n        aa=min(y for y,x in pts);bb=max(y for y,x in pts);ll=min(x for y,x in pts);tt=max(x for y,x in pts)\n        from collections import Counter\n        col=Counter(grid[y][x] for y,x in pts).most_common(1)[0][0]\n        for y in range(a+1,b):\n            for x in range(l+1,t):\n                if (aa<=y<=bb and (x<ll or x>tt)) or (ll<=x<=tt and (y<aa or y>bb)):\n                    out[y][x]=col\n    return out",
