    "program_source": "def transform(grid):\n    from collections import Counter\n    out=[r[:] for r in grid]\n    h=len(grid); w=len(grid[0])\n    # Vertical foreground lines take precedence at crossings.\n    for c in range(w):\n        vals=[grid[r][c] for r in range(h)]\n        if 0 not in vals:\n            color=Counter(vals).most_common(1)[0][0]\n            # Use line color visible at the boundary when crossings are numerous.\n            if vals[0]==vals[-1]: color=vals[0]\n            for r in range(h): out[r][c]=color\n    return out",
