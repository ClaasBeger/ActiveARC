    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    colors=set(sum(grid,[]))-{0}\n    def score(c):\n        cells=[(r,k) for r in range(h) for k in range(w) if grid[r][k]==c]\n        isolated=sum(not any(0<=r+dr<h and 0<=k+dc<w and grid[r+dr][k+dc]==c for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]) for r,k in cells)\n        return isolated/len(cells),isolated\n    if not colors:return [row[:] for row in grid]\n    noise=max(colors,key=score)\n    out=[[0 if x==noise else x for x in row] for row in grid]\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            col=out[r][c]\n            if not col or (r,c) in seen:continue\n            stack=[(r,c)];seen.add((r,c));pts=[]\n            while stack:\n                y,x=stack.pop();pts.append((y,x))\n                for dy,dx in [(1,0),(-1,0),(0,1),(0,-1)]:\n                    a,b=y+dy,x+dx\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and out[a][b]==col:\n                        seen.add((a,b));stack.append((a,b))\n            for a in range(min(y for y,x in pts),max(y for y,x in pts)+1):\n                for b in range(min(x for y,x in pts),max(x for y,x in pts)+1):\n                    if grid[a][b]==noise:out[a][b]=col\n    return out",
