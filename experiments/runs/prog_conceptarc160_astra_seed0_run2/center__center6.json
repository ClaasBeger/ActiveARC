    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    gray=[]\n    color=3\n    for r,row in enumerate(grid):\n        for c,v in enumerate(row):\n            if v==5: gray.append((r,c))\n            elif v!=0:\n                color=v\n                out[r][c]=0\n    if gray:\n        r=(min(p[0] for p in gray)+max(p[0] for p in gray))//2\n        c=(min(p[1] for p in gray)+max(p[1] for p in gray))//2\n        out[r][c]=color\n    return out",
