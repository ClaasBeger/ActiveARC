    "program_source": "def transform(grid):\n    out=[row[:] for row in grid]\n    h=len(grid); w=len(grid[0])\n    for r in range(h):\n        for c in range(w):\n            v=grid[r][c]\n            if v not in (0,8):\n                y,x=r-1,c+1\n                while y>=0 and x<w and grid[y][x]==0:\n                    out[y][x]=v\n                    y-=1; x+=1\n    return out",
