    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    seen=set(); comps=[]\n    for r in range(h):\n        for c in range(w):\n            if not grid[r][c] or (r,c) in seen: continue\n            color=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); comp=[]\n            while stack:\n                a,b=stack.pop(); comp.append((a,b))\n                for x,y in ((a-1,b),(a+1,b),(a,b-1),(a,b+1)):\n                    if 0<=x<h and 0<=y<w and (x,y) not in seen and grid[x][y]==color:\n                        seen.add((x,y)); stack.append((x,y))\n            comps.append((color,comp))\n    if not comps: return [row[:] for row in grid]\n    color,comp=max(comps,key=lambda z:len(z[1]))\n    r0=min(r for r,c in comp); r1=max(r for r,c in comp)\n    c0=min(c for r,c in comp); c1=max(c for r,c in comp)\n    return [[grid[r][c] if r0<=r<=r1 and c0<=c<=c1 and grid[r][c]!=color else 0 for c in range(w)] for r in range(h)]",
