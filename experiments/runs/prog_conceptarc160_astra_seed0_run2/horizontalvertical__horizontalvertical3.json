            "arguments": "{\"code\":\"def transform(grid):\\n    h,w=len(grid),len(grid[0])\\n    out=[r[:] for r in grid]\\n    seen=set(); comps=[]\\n    for r in range(h):\\n        for c in range(w):\\n            if grid[r][c] and (r,c) not in seen:\\n                stack=[(r,c)];seen.add((r,c));comp=[]\\n                while stack:\\n                    x,y=stack.pop();comp.append((x,y))\\n                    for a,b in [(x-1,y),(x+1,y),(x,y-1),(x,y+1)]:\\n                        if 0<=a<h and 0<=b<w and grid[a][b] and (a,b) not in seen:\\n                            seen.add((a,b));stack.append((a,b))\\n                comps.append(comp)\\n    centers=[(sum(x for x,y in p)/len(p),sum(y for x,y in p)/len(p)) for p in comps]\\n    if centers:\\n        vr=max(x for x,y in centers)-min(x for x,y in centers)\\n        vc=max(y for x,y in centers)-min(y for x,y in centers)\\n    else: vr,vc=1,0\\n    if vr>vc:\\n        for r in range(h): out[r][0]=1\\n    else:\\n        out[0]=[1]*w\\n    return out\"}",
