    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[row[:] for row in grid]\n    start=next(((r,c) for r in range(h) for c in range(w) if grid[r][c]),None)\n    if start is None: return out\n    color=grid[start[0]][start[1]]\n    obj={start}; stack=[start]\n    while stack:\n        r,c=stack.pop()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            a,b=r+dr,c+dc\n            if 0<=a<h and 0<=b<w and grid[a][b]==color and (a,b) not in obj:\n                obj.add((a,b));stack.append((a,b))\n    for r,c in obj: out[r][c]=0\n    d=0\n    while all(r+d+1<h and out[r+d+1][c]==0 for r,c in obj): d+=1\n    for r,c in obj: out[r+d][c]=color\n    return out",
