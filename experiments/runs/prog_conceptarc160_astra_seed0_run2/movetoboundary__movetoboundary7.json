    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\n    seen=set(); comps=[]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            stack=[(r,c)]; seen.add((r,c)); cells=[]\n            while stack:\n                a,b=stack.pop(); cells.append((a,b))\n                for x,y in ((a-1,b),(a+1,b),(a,b-1),(a,b+1)):\n                    if 0<=x<h and 0<=y<w and grid[x][y]!=0 and (x,y) not in seen:\n                        seen.add((x,y)); stack.append((x,y))\n            bounds=(min(a for a,b in cells),max(a for a,b in cells),min(b for a,b in cells),max(b for a,b in cells))\n            comps.append((cells,bounds))\n    if len(comps)<2: return out\n    frames=[o for o in comps if len(o[0]) < (o[1][1]-o[1][0]+1)*(o[1][3]-o[1][2]+1)]\n    frame=max(frames or comps,key=lambda o:(o[1][1]-o[1][0]+1)*(o[1][3]-o[1][2]+1))\n    t,b,l,r=frame[1]\n    for obj in comps:\n        if obj is frame: continue\n        cells,(ot,ob,ol,orr)=obj\n        dr=dc=0\n        if orr<l: dc=l-1-orr\n        elif ol>r: dc=r+1-ol\n        elif ob<t: dr=t-1-ob\n        elif ot>b: dr=b+1-ot\n        values=[(a+dr,c+dc,grid[a][c]) for a,c in cells]\n        for a,c in cells: out[a][c]=0\n        for a,c,v in values:\n            if 0<=a<h and 0<=c<w: out[a][c]=v\n    return out",
