            "arguments": "{\"code\":\"def transform(grid):\\n    out=[r[:] for r in grid]\\n    frame=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v==5]\\n    if not frame:return out\\n    top=min(r for r,c in frame); bottom=max(r for r,c in frame)\\n    left=min(c for r,c in frame); right=max(c for r,c in frame)\\n    shape=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v not in (0,5)]\\n    if not shape:return out\\n    a=min(r for r,c in shape); b=max(r for r,c in shape)\\n    x=min(c for r,c in shape); y=max(c for r,c in shape)\\n    rr=top+1+(bottom-top-1-(b-a+1))//2\\n    cc=left+1+(right-left-1-(y-x+1))//2\\n    for r,c in shape:out[rr+r-a][cc+c-x]=grid[r][c]\\n    return out\"}",
