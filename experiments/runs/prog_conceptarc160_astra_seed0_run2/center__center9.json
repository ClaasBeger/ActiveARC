    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    h,w=len(grid),len(grid[0])\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==2:\n                out[r][c]=0\n                walls=[j for j in range(w) if grid[r][j]==4]\n                left=[j for j in walls if j<c]\n                right=[j for j in walls if j>c]\n                if left and right:\n                    out[r][(max(left)+min(right))//2]=2\n                else:\n                    top=[i for i in range(r) if grid[i][c]==4]\n                    bot=[i for i in range(r+1,h) if grid[i][c]==4]\n                    if top and bot: out[(max(top)+min(bot))//2][c]=2\n                    else: out[r][w//2]=2\n    return out",
