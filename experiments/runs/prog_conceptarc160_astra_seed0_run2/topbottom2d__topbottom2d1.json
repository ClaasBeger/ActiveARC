    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    colors={v for row in grid for v in row if v!=0}\n    candidates=[]\n    for v in colors:\n        p=[(r,c) for r,row in enumerate(grid) for c,x in enumerate(row) if x==v]\n        a=min(r for r,c in p); b=max(r for r,c in p)\n        l=min(c for r,c in p); h=max(c for r,c in p)\n        density=len(p)/((b-a+1)*(h-l+1))\n        candidates.append((density,v,a,b,l,h))\n    if not candidates: return [row[:] for row in grid]\n    _,v,a,b,l,h=min(candidates)\n    return [[grid[r][c] if grid[r][c]==v else 0 for c in range(l,h+1)] for r in range(a,b+1)]",
