            "arguments": "{\"code\":\"def transform(grid):\\n h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\\n comps={}\\n seen=set()\\n for r in range(h):\\n  for c in range(w):\\n   col=grid[r][c]\\n   if col==0 or (r,c) in seen: continue\\n   pts={(r,c)}; seen.add((r,c)); todo=[(r,c)]\\n   for a,b in todo:\\n    for x,y in [(a-1,b),(a+1,b),(a,b-1),(a,b+1)]:\\n     if 0<=x<h and 0<=y<w and grid[x][y]==col and (x,y) not in seen:\\n      seen.add((x,y));pts.add((x,y));todo.append((x,y))\\n   comps.setdefault(col,[]).append(pts)\\n for col,parts in comps.items():\\n  if len(parts)<2: continue\\n  templates=[]\\n  for p in parts:\\n   a=min(x for x,y in p); b=min(y for x,y in p); z=max(x for x,y in p); t=max(y for x,y in p)\\n   border=[(x-a,y-b,grid[x][y]) for x in range(max(0,a-1),min(h,z+2)) for y in range(max(0,b-1),min(w,t+2)) if grid[x][y] not in (0,col)]\\n   if border: templates.append((p,a,b,border))\\n  for p,a,b,border in templates:\\n   shape={(x-a,y-b) for x,y in p}\\n   for q in parts:\\n    u=min(x for x,y in q);v=min(y for x,y in q)\\n    if {(x-u,y-v) for x,y in q}!=shape: continue\\n    for dx,dy,k in border:\\n     x,y=u+dx,v+dy\\n     if 0<=x<h and 0<=y<w and out[x][y]==0:out[x][y]=k\\n return out\"}",
