    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    cols=[c for c in range(w) if grid[0][c]!=0 and all(grid[r][c]==grid[0][c] for r in range(h))]\n    if len(cols)>=2:\n        spans=[(a+1,b) for a,b in zip(cols,cols[1:]) if b>a+1]\n        blocks=[[[grid[r][c] for c in range(a,b)] for r in range(h)] for a,b in spans]\n        blocks.sort(key=lambda b:sum(v!=0 for row in b for v in row))\n        for (a,b),block in zip(spans,blocks):\n            for r in range(h): out[r][a:b]=block[r]\n    else:\n        rows=[r for r in range(h) if grid[r][0]!=0 and len(set(grid[r]))==1]\n        spans=[(a+1,b) for a,b in zip(rows,rows[1:]) if b>a+1]\n        blocks=[[row[:] for row in grid[a:b]] for a,b in spans]\n        blocks.sort(key=lambda b:sum(v!=0 for row in b for v in row))\n        for (a,b),block in zip(spans,blocks): out[a:b]=block\n    return out",
