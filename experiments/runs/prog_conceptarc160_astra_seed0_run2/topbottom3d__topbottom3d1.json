    "program_source": "def transform(grid):\n    out = [row[:] for row in grid]\n    colors = set(v for row in grid for v in row) - {0}\n    for color in colors:\n        cells = [(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v == color]\n        r0 = min(r for r,c in cells)\n        r1 = max(r for r,c in cells)\n        c0 = min(c for r,c in cells)\n        c1 = max(c for r,c in cells)\n        if any(grid[r][c] != color for r in range(r0,r1+1) for c in range(c0,c1+1)):\n            for r in range(r0,r1+1):\n                for c in range(c0,c1+1):\n                    out[r][c] = color\n    return out",
