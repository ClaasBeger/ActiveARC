    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    colors=set(v for row in grid for v in row)-{0}\n    frames=[]\n    for color in colors:\n        pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==color]\n        a,b=min(r for r,c in pts),max(r for r,c in pts)\n        l,u=min(c for r,c in pts),max(c for r,c in pts)\n        if b-a>=2 and u-l>=2 and all(grid[r][c]==color for r in range(a,b+1) for c in range(l,u+1) if r in (a,b) or c in (l,u)):\n            frames.append(((b-a)*(u-l),a,b,l,u,color))\n    if frames:\n        _,a,b,l,u,frame=max(frames)\n        pts=[(r,c) for r in range(a+1,b) for c in range(l+1,u) if grid[r][c] not in (0,frame)]\n    else:\n        pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]!=0]\n    if not pts: return [[0]]\n    color=min(grid[r][c] for r,c in pts)\n    pts=[(r,c) for r,c in pts if grid[r][c]==color]\n    a,b=min(r for r,c in pts),max(r for r,c in pts)\n    l,u=min(c for r,c in pts),max(c for r,c in pts)\n    return [row[l:u+1] for row in grid[a:b+1]]",
