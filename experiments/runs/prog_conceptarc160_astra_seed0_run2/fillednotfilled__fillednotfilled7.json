    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    h=len(grid); w=len(grid[0]); seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            color=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); pts=[]\n            while stack:\n                y,x=stack.pop(); pts.append((y,x))\n                for yy,xx in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                    if 0<=yy<h and 0<=xx<w and (yy,xx) not in seen and grid[yy][xx]==color:\n                        seen.add((yy,xx)); stack.append((yy,xx))\n            top=min(y for y,x in pts); bot=max(y for y,x in pts)\n            left=min(x for y,x in pts); right=max(x for y,x in pts)\n            for y,x in pts:\n                if right-left>bot-top:\n                    if y not in (top,bot): out[y][x]=0\n                else:\n                    if x not in (left,right): out[y][x]=0\n    return out",
