    "program_source": "def transform(grid):\n    h=len(grid); w=len(grid[0]); out=[r[:] for r in grid]\n    spans=[]; c=0\n    while c<w:\n        if any(grid[r][c]!=0 for r in range(h)):\n            a=c\n            while c<w and any(grid[r][c]!=0 for r in range(h)): c+=1\n            spans.append((a,c))\n        else: c+=1\n    blocks=[([row[a:b] for row in grid],sum(v!=0 for row in grid for v in row[a:b])) for a,b in spans]\n    blocks.sort(key=lambda x:-x[1])\n    for (a,b),(block,_) in zip(spans,blocks):\n        for r in range(h):\n            for c in range(a,b): out[r][c]=0\n            for j,v in enumerate(block[r]):\n                if a+j<w: out[r][a+j]=v\n    return out",
