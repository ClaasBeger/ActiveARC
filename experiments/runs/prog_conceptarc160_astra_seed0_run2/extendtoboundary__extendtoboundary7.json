    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[row[:] for row in grid]\n    rows=[r for r in range(h) if grid[r][0]!=0 and len(set(grid[r]))==1]\n    cols=[c for c in range(w) if grid[0][c]!=0 and len({grid[r][c] for r in range(h)})==1]\n    for r in range(h):\n        for c in range(w):\n            v=grid[r][c]\n            if not v or r in rows or c in cols: continue\n            if rows:\n                target=min(rows,key=lambda t:abs(t-r))\n                for rr in range(min(r,target)+1,max(r,target)):\n                    out[rr][c]=v\n            if cols:\n                target=min(cols,key=lambda t:abs(t-c))\n                for cc in range(min(c,target)+1,max(c,target)):\n                    out[r][cc]=v\n    return out",
