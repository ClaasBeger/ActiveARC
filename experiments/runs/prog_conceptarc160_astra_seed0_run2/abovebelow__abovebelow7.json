          {
            "arguments": "{\"code\":\"def transform(grid):\\n    h,w=len(grid),len(grid[0]); out=[row[:] for row in grid]\\n    def components(color):\\n        seen=set(); comps=[]\\n        for r in range(h):\\n            for c in range(w):\\n                if grid[r][c]!=color or (r,c) in seen: continue\\n                seen.add((r,c)); comp=[(r,c)]\\n                for y,x in comp:\\n                    for a,b in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\\n                        if 0<=a<h and 0<=b<w and grid[a][b]==color and (a,b) not in seen:\\n                            seen.add((a,b)); comp.append((a,b))\\n                comps.append(comp)\\n        return comps\\n    frames=[]\\n    for comp in components(4):\\n        frames.append((min(r for r,c in comp),max(r for r,c in comp),min(c for r,c in comp),max(c for r,c in comp)))\\n    for comp in components(8):\\n        top=min(r for r,c in comp); bottom=max(r for r,c in comp)\\n        left=min(c for r,c in comp); right=max(c for r,c in comp)\\n        candidates=[f for f in frames if f[0]>bottom and f[2]<=right and f[3]>=left]\\n        if not candidates: continue\\n        a,b,l,rr=min(candidates,key=lambda f:f[0]-bottom)\\n        shift=b+1-top\\n        for r,c in comp: out[r][c]=0\\n        for r,c in comp:\\n            if 0<=r+shift<h: out[r+shift][c]=8\\n    return out\"}",
