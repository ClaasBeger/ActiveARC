    "program_source": "def transform(grid):\n    out=[row[:] for row in grid]\n    h=len(grid); w=len(grid[0])\n    # The blue dotted horizontal line divides left-marked and right-marked bars.\n    scores=[sum(v==1 for v in row) for row in grid]\n    mid=max(range(h),key=lambda r:scores[r])\n    for r,row in enumerate(grid):\n        if r==mid: continue\n        c=0\n        while c<w:\n            if row[c] in (0,1):\n                c+=1; continue\n            start=c; color=row[c]\n            while c<w and row[c]==color: c+=1\n            out[r][start if r<mid else c-1]=1\n    return out",
