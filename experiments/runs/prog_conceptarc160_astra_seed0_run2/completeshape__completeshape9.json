    "program_source": "def transform(grid):\n    from collections import deque, Counter\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    seen=set(); q=deque()\n    for r in range(h):\n        for c in range(w):\n            if (r in (0,h-1) or c in (0,w-1)) and grid[r][c]==0:\n                seen.add((r,c)); q.append((r,c))\n    while q:\n        r,c=q.popleft()\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\n            a,b=r+dr,c+dc\n            if 0<=a<h and 0<=b<w and grid[a][b]==0 and (a,b) not in seen:\n                seen.add((a,b)); q.append((a,b))\n    colors=Counter(v for row in grid for v in row if v)\n    col=colors.most_common(1)[0][0] if colors else 1\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 and (r,c) not in seen: out[r][c]=col\n    return out",
