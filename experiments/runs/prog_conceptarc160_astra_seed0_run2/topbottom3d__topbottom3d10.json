    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    h=len(grid); w=len(grid[0])\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==4]\n    if not pts: return out\n    a=min(r for r,c in pts); b=max(r for r,c in pts)\n    l=min(c for r,c in pts); u=max(c for r,c in pts)\n    rows=[]; cols=[]\n    for r in range(a,b+1):\n        vals=[grid[r][c] for c in range(l,u+1) if grid[r][c] not in (5,6)]\n        if vals and all(v==4 for v in vals): rows.append(r)\n    for c in range(l,u+1):\n        vals=[grid[r][c] for r in range(a,b+1) if grid[r][c] not in (5,6)]\n        if vals and all(v==4 for v in vals): cols.append(c)\n    for r in range(a,b+1):\n        for c in range(l,u+1):\n            if r in rows or c in cols: out[r][c]=4\n    return out",
