          {
            "arguments": "{\"code\":\"def transform(grid):\\n    from collections import Counter\\n    h,w=len(grid),len(grid[0])\\n    out=[row[:] for row in grid]\\n    seen=set()\\n    for r in range(h):\\n        for c in range(w):\\n            if not grid[r][c] or (r,c) in seen: continue\\n            stack=[(r,c)]; seen.add((r,c)); pts=[]\\n            while stack:\\n                y,x=stack.pop(); pts.append((y,x))\\n                for a,b in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\\n                    if 0<=a<h and 0<=b<w and grid[a][b]!=0 and (a,b) not in seen:\\n                        seen.add((a,b)); stack.append((a,b))\\n            top=min(y for y,x in pts); bottom=max(y for y,x in pts)\\n            left=min(x for y,x in pts); right=max(x for y,x in pts)\\n            border=Counter(grid[y][x] for y,x in pts if y in (top,bottom) or x in (left,right))\\n            if not border: continue\\n            wall=border.most_common(1)[0][0]\\n            fill=Counter(grid[y][x] for y,x in pts if grid[y][x]!=wall)\\n            if not fill: continue\\n            color=fill.most_common(1)[0][0]\\n            for y in range(top,bottom+1):\\n                for x in range(left,right+1):\\n                    if out[y][x]==0: out[y][x]=color\\n    return out\"}",
