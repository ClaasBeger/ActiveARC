    "program_source": "def transform(grid):\n    out=[r[:] for r in grid]\n    h=len(grid); w=len(grid[0])\n    frame=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==7]\n    moving=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==9]\n    if frame:\n        top=min(r for r,c in frame); bottom=max(r for r,c in frame)\n        left=min(c for r,c in frame); right=max(c for r,c in frame)\n    for r,c in moving:\n        on=frame and ((r in (top,bottom) and left<=c<=right) or (c in (left,right) and top<=r<=bottom))\n        out[r][c]=7 if on else 0\n    for r,c in moving:\n        if c>0: out[r][c-1]=9\n    return out",
