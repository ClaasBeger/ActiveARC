    "program_source": "def transform(grid):\n from collections import Counter\n h,w=len(grid),len(grid[0]); seen=set(); objs=[]\n for r in range(h):\n  for c in range(w):\n   if grid[r][c]==0 or (r,c) in seen: continue\n   color=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); pts=[]\n   while stack:\n    a,b=stack.pop(); pts.append((a,b))\n    for da in (-1,0,1):\n     for db in (-1,0,1):\n      x,y=a+da,b+db\n      if 0<=x<h and 0<=y<w and (x,y) not in seen and grid[x][y]==color:\n       seen.add((x,y)); stack.append((x,y))\n   if len(set(a for a,b in pts))==1: orient='h'\n   elif len(set(b for a,b in pts))==1: orient='v'\n   elif len(set(a-b for a,b in pts))==1: orient='d1'\n   else: orient='d2'\n   objs.append((pts,orient))\n counts=Counter(o for p,o in objs)\n if not counts:return [row[:] for row in grid]\n best=max(counts.values()); out=[row[:] for row in grid]\n for pts,o in objs:\n  if counts[o]<best:\n   for r,c in pts:out[r][c]=0\n return out",
