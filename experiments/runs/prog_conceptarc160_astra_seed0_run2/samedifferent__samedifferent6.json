    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    seen=set(); counts={}\n    for r in range(h):\n        for c in range(w):\n            v=grid[r][c]\n            if not v or (r,c) in seen: continue\n            counts[v]=counts.get(v,0)+1\n            stack=[(r,c)]; seen.add((r,c))\n            while stack:\n                y,x=stack.pop()\n                for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n                    a,b=y+dy,x+dx\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==v:\n                        seen.add((a,b)); stack.append((a,b))\n    return [[v if counts.get(v,0)<=1 else 0 for v in row] for row in grid]",
