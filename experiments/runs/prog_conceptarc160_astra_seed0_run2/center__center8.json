    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[row[:] for row in grid]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==1: out[r][c]=0\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]!=7 or (r,c) in seen: continue\n            comp=[]; stack=[(r,c)]; seen.add((r,c))\n            while stack:\n                a,b=stack.pop(); comp.append((a,b))\n                for x,y in ((a-1,b),(a+1,b),(a,b-1),(a,b+1)):\n                    if 0<=x<h and 0<=y<w and grid[x][y]==7 and (x,y) not in seen:\n                        seen.add((x,y)); stack.append((x,y))\n            a=(min(x for x,y in comp)+max(x for x,y in comp))//2\n            b=(min(y for x,y in comp)+max(y for x,y in comp))//2\n            vertical=len(set(y for x,y in comp))==1\n            for d in (-1,0,1):\n                x,y=(a,b+d) if vertical else (a+d,b)\n                if 0<=x<h and 0<=y<w: out[x][y]=1\n    return out",
