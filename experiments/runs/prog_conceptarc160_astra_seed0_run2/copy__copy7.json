    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0]); seen=set(); comps=[]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            stack=[(r,c)];seen.add((r,c)); comp=[]\n            while stack:\n                a,b=stack.pop();comp.append((a,b))\n                for x,y in ((a-1,b),(a+1,b),(a,b-1),(a,b+1)):\n                    if 0<=x<h and 0<=y<w and grid[x][y]!=0 and (x,y) not in seen:\n                        seen.add((x,y));stack.append((x,y))\n            comps.append(comp)\n    out=[row[:] for row in grid]\n    sources=[p for p in comps if any(grid[r][c]==5 for r,c in p)]\n    for p in comps:\n        if any(grid[r][c]==5 for r,c in p):continue\n        r0=min(r for r,c in p);c0=min(c for r,c in p)\n        rh=max(r for r,c in p)-r0+1;cw=max(c for r,c in p)-c0+1\n        for s in sources:\n            a=min(r for r,c in s);b=min(c for r,c in s)\n            sh=max(r for r,c in s)-a+1;sw=max(c for r,c in s)-b+1\n            if (rh,cw)!=(sh,sw):continue\n            for r,c in s:\n                if grid[r][c]==5 and (r0+r-a,c0+c-b) in p:out[r0+r-a][c0+c-b]=5\n            break\n    return out",
