    "program_source": "def transform(grid):\n    pts=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v]\n    if not pts: return [row[:] for row in grid]\n    r0,c0=pts[0]; color=grid[r0][c0]\n    slope=1\n    for r,c in pts[1:]:\n        if c!=c0:\n            slope=1 if (r-r0)*(c-c0)>0 else -1\n            break\n    return [[color if r-r0>=slope*(c-c0) else 0 for c in range(len(grid[0]))] for r in range(len(grid))]\n",
