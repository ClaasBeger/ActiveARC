    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[[0 if v==2 else v for v in row] for row in grid]\n    colors=set(sum(grid,[]))-{0,2}\n    for color in colors:\n        pts={(r,c) for r in range(h) for c in range(w) if grid[r][c]==color}\n        candidates=[]\n        for ar in range(h):\n            for ac in range(w):\n                for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:\n                    cells=set()\n                    for n in range(1,max(h,w)+1):\n                        d=n-1\n                        layer={(ar+dr*d+dc*t,ac+dc*d+dr*t) for t in range(-d,d+1)}\n                        if any(not(0<=r<h and 0<=c<w) or grid[r][c] not in (color,2) for r,c in layer): break\n                        cells|=layer\n                        known=len(cells & pts)\n                        if n>=2 and known and known>=len(cells)*0.4:\n                            candidates.append((known,n,cells.copy()))\n        remaining=pts.copy()\n        while remaining and candidates:\n            best=max(candidates,key=lambda x:(len(x[2]&remaining),x[1]))\n            if not(best[2]&remaining): break\n            for r,c in best[2]: out[r][c]=color\n            remaining-=best[2]\n            candidates=[x for x in candidates if not x[2]&best[2]]\n    return out",
