    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    seen=set(); counts={}\n    for r in range(h):\n        for c in range(w):\n            color=grid[r][c]\n            if not color or (r,c) in seen: continue\n            counts[color]=counts.get(color,0)+1\n            stack=[(r,c)];seen.add((r,c))\n            while stack:\n                a,b=stack.pop()\n                for da in (-1,0,1):\n                    for db in (-1,0,1):\n                        x,y=a+da,b+db\n                        if 0<=x<h and 0<=y<w and (x,y) not in seen and grid[x][y]==color:\n                            seen.add((x,y));stack.append((x,y))\n    keep={c for c,n in counts.items() if n>1}\n    return [[v if v in keep else 0 for v in row] for row in grid]",
