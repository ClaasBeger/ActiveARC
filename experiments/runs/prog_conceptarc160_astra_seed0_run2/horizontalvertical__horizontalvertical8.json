          {
            "arguments": "{\"code\":\"def transform(grid):\\n    h=len(grid); w=len(grid[0]); out=[r[:] for r in grid]\\n    # Locate the thin cross connecting the four end blocks.\\n    candidates=[]\\n    for r in range(1,h-1):\\n        for c in range(1,w-1):\\n            v=grid[r][c]\\n            if v and all(grid[r+dr][c+dc]==v for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]):\\n                score=sum(grid[r+dr][c+dc]!=v for dr,dc in [(-1,-1),(-1,1),(1,-1),(1,1)])\\n                candidates.append((score,r,c,v))\\n    if not candidates: return out\\n    _,r,c,v=max(candidates)\\n    for direction in [-1,1]:\\n        rr=r\\n        while 0<=rr<h and grid[rr][c]==v: rr+=direction\\n        if not (0<=rr<h) or grid[rr][c]==0: continue\\n        col=grid[rr][c]; stack=[(rr,c)]; seen=set(stack)\\n        while stack:\\n            a,b=stack.pop();out[a][b]=0\\n            for x,y in [(a-1,b),(a+1,b),(a,b-1),(a,b+1)]:\\n                if 0<=x<h and 0<=y<w and (x,y) not in seen and grid[x][y]==col:\\n                    seen.add((x,y));stack.append((x,y))\\n    return out\"}",
