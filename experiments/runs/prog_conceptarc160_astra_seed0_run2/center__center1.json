    "program_source": "def transform(grid):\n    out = [r[:] for r in grid]\n    h,w=len(grid),len(grid[0])\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            if not grid[r][c] or (r,c) in seen: continue\n            color=grid[r][c]\n            pts=[(r,c)]\n            seen.add((r,c))\n            for y,x in pts:\n                for dy in (-1,0,1):\n                    for dx in (-1,0,1):\n                        yy,xx=y+dy,x+dx\n                        if 0<=yy<h and 0<=xx<w and (yy,xx) not in seen and grid[yy][xx]==color:\n                            seen.add((yy,xx));pts.append((yy,xx))\n            y=(min(p[0] for p in pts)+max(p[0] for p in pts))//2\n            x=(min(p[1] for p in pts)+max(p[1] for p in pts))//2\n            out[y][x]=color\n    return out",
