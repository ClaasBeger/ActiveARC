    "program_source": "def transform(grid):\n    out = [row[:] for row in grid]\n    pts = [(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v != 0]\n    if not pts: return out\n    top=min(r for r,c in pts); bottom=max(r for r,c in pts)\n    right=max(c for r,c in pts)\n    color=grid[pts[0][0]][pts[0][1]]\n    mid=(top+bottom)//2\n    for c in range(right+1,len(grid[0])): out[mid][c]=color\n    return out",
