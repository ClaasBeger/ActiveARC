    "program_source": "def transform(grid):\n h,w=len(grid),len(grid[0]); seen=set(); objs=[]\n for r in range(h):\n  for c in range(w):\n   if grid[r][c] and (r,c) not in seen:\n    color=grid[r][c]; q=[(r,c)]; seen.add((r,c))\n    for y,x in q:\n     for a,b in [(y-1,x),(y+1,x),(y,x-1),(y,x+1)]:\n      if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==color:\n       seen.add((a,b)); q.append((a,b))\n    objs.append((len(q),color))\n objs.sort(key=lambda z:z[0]); out=[[0]*w for _ in range(h)]\n for c,(n,color) in enumerate(objs):\n  if c<w:\n   for r in range(max(0,h-n),h): out[r][c]=color\n return out",
