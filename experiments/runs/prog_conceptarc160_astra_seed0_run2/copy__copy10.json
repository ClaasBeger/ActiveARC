    "program_source": "def transform(grid):\n h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\n seen=set(); comps=[]\n for r in range(h):\n  for c in range(w):\n   if grid[r][c]==0 or (r,c) in seen: continue\n   col=grid[r][c]; st=[(r,c)]; seen.add((r,c)); cells=[]\n   while st:\n    a,b=st.pop(); cells.append((a,b))\n    for x,y in [(a-1,b),(a+1,b),(a,b-1),(a,b+1)]:\n     if 0<=x<h and 0<=y<w and (x,y) not in seen and grid[x][y]==col:\n      seen.add((x,y)); st.append((x,y))\n   a=min(x for x,y in cells); b=min(y for x,y in cells); z=max(x for x,y in cells); t=max(y for x,y in cells)\n   if len(cells)==(z-a+1)*(t-b+1): comps.append((col,a,b,z,t))\n for col,a,b,z,t in comps:\n  border=[]\n  for x in range(max(0,a-1),min(h,z+2)):\n   for y in range(max(0,b-1),min(w,t+2)):\n    if grid[x][y] not in (0,col): border.append((x,y,grid[x][y]))\n  if not border: continue\n  for co,aa,bb,zz,tt in comps:\n   if co!=col or (aa,bb)==(a,b): continue\n   for x,y,v in border:\n    xs=[aa-1] if x<a else [zz+1] if x>z else list(range(aa,zz+1)) if y<b or y>t else [aa+x-a]\n    ys=[bb-1] if y<b else [tt+1] if y>t else list(range(bb,tt+1)) if x<a or x>z else [bb+y-b]\n    for xx in xs:\n     for yy in ys:\n      if 0<=xx<h and 0<=yy<w and out[xx][yy]==0: out[xx][yy]=v\n return out",
