            "arguments": "{\"code\":\"def transform(grid):\\n    h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\\n    seen=set(); comps=[]\\n    for r in range(h):\\n        for c in range(w):\\n            if grid[r][c]==0 or (r,c) in seen: continue\\n            color=grid[r][c]; seen.add((r,c)); stack=[(r,c)]; comp=[]\\n            while stack:\\n                a,b=stack.pop(); comp.append((a,b))\\n                for da in (-1,0,1):\\n                    for db in (-1,0,1):\\n                        x,y=a+da,b+db\\n                        if 0<=x<h and 0<=y<w and (x,y) not in seen and grid[x][y]==color:\\n                            seen.add((x,y)); stack.append((x,y))\\n            comps.append((color,comp))\\n    templates=[(v,p) for v,p in comps if len(p)>1]\\n    for color,p in comps:\\n        if len(p)!=1: continue\\n        choices=[q for v,q in templates if v==color]\\n        if not choices: choices=[q for v,q in templates]\\n        if not choices: continue\\n        q=max(choices,key=len); r0=min(a for a,b in q); r1=max(a for a,b in q); c0=min(b for a,b in q); c1=max(b for a,b in q)\\n        cr,cc=(r0+r1)//2,(c0+c1)//2\\n        r,c=p[0]; out[r][c]=0\\n        for a,b in q:\\n            x,y=r+a-cr,c+b-cc\\n            if 0<=x<h and 0<=y<w: out[x][y]=color\\n    return out\"}",
