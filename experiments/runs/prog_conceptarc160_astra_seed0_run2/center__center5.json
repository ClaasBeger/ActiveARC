            "arguments": "{\"code\":\"def transform(grid):\\n    h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\\n    seen=set()\\n    for r in range(h):\\n        for c in range(w):\\n            if not grid[r][c] or (r,c) in seen: continue\\n            comp=[]; stack=[(r,c)];seen.add((r,c))\\n            while stack:\\n                y,x=stack.pop();comp.append((y,x))\\n                for a,b in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\\n                    if 0<=a<h and 0<=b<w and grid[a][b] and (a,b) not in seen:\\n                        seen.add((a,b));stack.append((a,b))\\n            colors={grid[y][x] for y,x in comp}\\n            candidates=[]\\n            for color in colors:\\n                pts=[(y,x) for y,x in comp if grid[y][x]==color]\\n                ys=[p[0] for p in pts];xs=[p[1] for p in pts]\\n                if len(set(xs))==1 and len(pts)==max(ys)-min(ys)+1:\\n                    candidates.append((len(pts),True,pts))\\n                if len(set(ys))==1 and len(pts)==max(xs)-min(xs)+1:\\n                    candidates.append((len(pts),False,pts))\\n            if not candidates: continue\\n            _,vertical,pts=max(candidates)\\n            rest=[p for p in comp if p not in pts]\\n            if not rest: continue\\n            axis=0 if vertical else 1\\n            center=(min(p[axis] for p in pts)+max(p[axis] for p in pts))//2\\n            old=(min(p[axis] for p in rest)+max(p[axis] for p in rest))//2\\n            for y,x in rest: out[y][x]=0\\n            for y,x in rest:\\n                a=y+center-old if vertical else y\\n                b=x if vertical else x+center-old\\n                if 0<=a<h and 0<=b<w: out[a][b]=grid[y][x]\\n    return out\"}",
