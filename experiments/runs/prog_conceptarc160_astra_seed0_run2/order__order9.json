    "program_source": "def transform(grid):\n    a=[row[:] for row in grid]\n    h=len(a); w=len(a[0])\n    inds=[i for i,row in enumerate(a) if any(row)]\n    if not inds:return a\n    start,end=inds[0],inds[-1]+1\n    blocks=[]; gaps=[];i=start\n    while i<end:\n        j=i\n        while j<end and any(a[j]):j+=1\n        blocks.append(a[i:j]);i=j\n        j=i\n        while j<end and not any(a[j]):j+=1\n        if j>i:gaps.append(a[i:j])\n        i=j\n    blocks.sort(key=len,reverse=True)\n    middle=[]\n    for k,b in enumerate(blocks):\n        middle.extend(b)\n        if k<len(gaps):middle.extend(gaps[k])\n    return a[:start]+middle+a[end:]",
