            "arguments": "{\"code\":\"def transform(grid):\\n h,w=len(grid),len(grid[0]); seen=set(); comps=[]\\n for r in range(h):\\n  for c in range(w):\\n   if grid[r][c] and (r,c) not in seen:\\n    seen.add((r,c)); stack=[(r,c)]; comp=[]\\n    while stack:\\n     a,b=stack.pop(); comp.append((a,b))\\n     for da,db in ((0,1),(0,-1),(1,0),(-1,0)):\\n      x,y=a+da,b+db\\n      if 0<=x<h and 0<=y<w and grid[x][y] and (x,y) not in seen:\\n       seen.add((x,y)); stack.append((x,y))\\n    comps.append(comp)\\n comps.sort(key=lambda p:min(c for r,c in p))\\n out=[[0]*w for _ in range(h)]\\n for i,comp in enumerate(comps):\\n  shift=-min(c for r,c in comp) if i==0 else w-1-max(c for r,c in comp)\\n  for r,c in comp: out[r][c+shift]=grid[r][c]\\n return out\"}",
