    "program_source": "def transform(grid):\n    h=len(grid); w=len(grid[0])\n    # The two colored fields are separated by a full yellow line.\n    cols=[j for j in range(w) if all(grid[i][j]==4 for i in range(h))]\n    if cols:\n        j=cols[0]\n        panels=[[row[:j] for row in grid],[row[j+1:] for row in grid]]\n        vertical=True\n    else:\n        rows=[i for i in range(h) if all(v==4 for v in grid[i])]\n        i=rows[0]\n        panels=[grid[:i],grid[i+1:]]\n        vertical=False\n    pieces=[]\n    for p in panels:\n        pts=[(r,c) for r,row in enumerate(p) for c,v in enumerate(row) if v==8]\n        if not pts:\n            continue\n        r0=min(r for r,c in pts); r1=max(r for r,c in pts)\n        c0=min(c for r,c in pts); c1=max(c for r,c in pts)\n        pieces.append([[8 if p[r][c]==8 else 0 for c in range(c0,c1+1)] for r in range(r0,r1+1)])\n    if vertical:\n        return [sum((p[r] for p in pieces),[]) for r in range(len(pieces[0]))]\n    return sum(pieces,[])",
