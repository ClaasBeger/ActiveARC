            "arguments": "{\"code\":\"def transform(grid):\\n    h,w=len(grid),len(grid[0])\\n    out=[r[:] for r in grid]\\n    seen=set()\\n    for r in range(h):\\n        for c in range(w):\\n            if grid[r][c]==0 or (r,c) in seen: continue\\n            color=grid[r][c]\\n            comp={(r,c)}; seen.add((r,c)); stack=[(r,c)]\\n            while stack:\\n                x,y=stack.pop()\\n                for dx in (-1,0,1):\\n                    for dy in (-1,0,1):\\n                        a,b=x+dx,y+dy\\n                        if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==color:\\n                            seen.add((a,b)); comp.add((a,b)); stack.append((a,b))\\n            filled=set(comp)\\n            for x in {a for a,b in comp}:\\n                cols=[b for a,b in comp if a==x]\\n                for y in range(min(cols),max(cols)+1): filled.add((x,y))\\n            interior={(x,y) for x,y in filled if all((x+dx,y+dy) in filled for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)))}\\n            for x,y in interior:\\n                out[x][y]=0 if grid[x][y]==color else color\\n    return out\"}",
