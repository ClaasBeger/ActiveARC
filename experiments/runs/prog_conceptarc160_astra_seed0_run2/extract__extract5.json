    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    seen=set(); objects=[]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] in (0,9) or (r,c) in seen: continue\n            color=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); pts=[]\n            while stack:\n                a,b=stack.pop(); pts.append((a,b))\n                for x,y in ((a-1,b),(a+1,b),(a,b-1),(a,b+1)):\n                    if 0<=x<h and 0<=y<w and (x,y) not in seen and grid[x][y]==color:\n                        seen.add((x,y)); stack.append((x,y))\n            if len(pts)<2: continue\n            top=min(a for a,b in pts); bottom=max(a for a,b in pts)\n            left=min(b for a,b in pts); right=max(b for a,b in pts)\n            objects.append((left,top,[[grid[a][b] if grid[a][b]!=9 else 0 for b in range(left,right+1)] for a in range(top,bottom+1)]))\n    objects.sort(key=lambda x:(x[0],x[1]))\n    if not objects: return []\n    height=max(len(o[2]) for o in objects)\n    return [sum((o[2][r] if r<len(o[2]) else [0]*len(o[2][0]) for o in objects),[]) for r in range(height)]",
