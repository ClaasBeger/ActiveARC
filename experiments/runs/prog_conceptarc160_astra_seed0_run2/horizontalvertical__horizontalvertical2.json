    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            comp=[]; stack=[(r,c)]; seen.add((r,c))\n            while stack:\n                y,x=stack.pop(); comp.append((y,x))\n                for yy,xx in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                    if 0<=yy<h and 0<=xx<w and grid[yy][xx]!=0 and (yy,xx) not in seen:\n                        seen.add((yy,xx)); stack.append((yy,xx))\n            rows={}\n            for y,x in comp: rows.setdefault(y,set()).add(grid[y][x])\n            if any(len(v)>1 for v in rows.values()):\n                for y,x in comp: out[y][x]=0\n    return out",
