            "arguments": "{\"code\":\"def transform(grid):\\n h=len(grid); w=len(grid[0]); seen=set(); objs=[]\\n for r in range(h):\\n  for c in range(w):\\n   if grid[r][c]==0 or (r,c) in seen: continue\\n   col=grid[r][c]; stack=[(r,c)]; seen.add((r,c)); obj=[]\\n   while stack:\\n    x,y=stack.pop(); obj.append((x,y))\\n    for dx,dy in [(1,0),(-1,0),(0,1),(0,-1)]:\\n     a,b=x+dx,y+dy\\n     if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==col:\\n      seen.add((a,b)); stack.append((a,b))\\n   objs.append(obj)\\n out=[[0]*w for _ in range(h)]\\n if objs:\\n  obj=max(objs,key=lambda o:max(r for r,c in o))\\n  for r,c in obj: out[r][c]=grid[r][c]\\n return out\"}",
