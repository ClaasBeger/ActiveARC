    "program_source": "def transform(grid):\n    from collections import Counter\n    import math\n    counts=Counter(v for row in grid for v in row)\n    bg=0 if 0 in counts else counts.most_common(1)[0][0]\n    pts=sorted((c,r) for r,row in enumerate(grid) for c,v in enumerate(row) if v!=bg)\n    def cross(o,a,b):\n        return (a[0]-o[0])*(b[1]-o[1])-(a[1]-o[1])*(b[0]-o[0])\n    if len(pts)<3:\n        return [[7]*len(pts)]\n    lo=[]\n    for p in pts:\n        while len(lo)>1 and cross(lo[-2],lo[-1],p)<=0: lo.pop()\n        lo.append(p)\n    hi=[]\n    for p in reversed(pts):\n        while len(hi)>1 and cross(hi[-2],hi[-1],p)<=0: hi.pop()\n        hi.append(p)\n    hull=lo[:-1]+hi[:-1]\n    while len(hull)>3:\n        ds=[]\n        for i,b in enumerate(hull):\n            a=hull[i-1]; c=hull[(i+1)%len(hull)]\n            ds.append(abs(cross(a,b,c))/max(1e-9,math.hypot(c[0]-a[0],c[1]-a[1])))\n        k=min(range(len(ds)),key=lambda i:ds[i])\n        if ds[k]>0.75: break\n        hull.pop(k)\n    return [[7]*len(hull)]",
