          {
            "arguments": "{\"code\":\"def transform(grid):\\n    from collections import Counter\\n    h,w=len(grid),len(grid[0])\\n    seen=set(); objs=[]\\n    for r in range(h):\\n        for c in range(w):\\n            if grid[r][c]==0 or (r,c) in seen: continue\\n            seen.add((r,c)); cells=[(r,c)]\\n            for y,x in cells:\\n                for a,b in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\\n                    if 0<=a<h and 0<=b<w and grid[a][b]!=0 and (a,b) not in seen:\\n                        seen.add((a,b)); cells.append((a,b))\\n            ct=Counter(grid[y][x] for y,x in cells)\\n            color=max((k for k in ct if k!=7), key=lambda k:ct[k],default=7)\\n            objs.append((cells,ct[7],color))\\n    objs.sort(key=lambda o:(min(x for y,x in o[0]), min(y for y,x in o[0])))\\n    ordered=sorted(objs,key=lambda o:o[1])\\n    out=[row[:] for row in grid]\\n    for target,source in zip(objs,ordered):\\n        for y,x in target[0]: out[y][x]=source[2]\\n    return out\"}",
