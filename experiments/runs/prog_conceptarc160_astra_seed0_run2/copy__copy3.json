    "program_source": "def transform(grid):\n    h=len(grid); w=len(grid[0]); mid=w//2\n    src={(r,c):grid[r][c] for r in range(h) for c in range(mid) if grid[r][c]}\n    dst={(r,c):grid[r][c] for r in range(h) for c in range((w+1)//2,w) if grid[r][c]}\n    candidates=[]\n    for shift in range(1,w):\n        matches=sum(src.get((r,c-shift))==v for (r,c),v in dst.items())\n        bad=sum(src.get((r,c-shift))!=v for (r,c),v in dst.items())\n        conflicts=sum(0<=c+shift<w and grid[r][c+shift] not in (0,v) for (r,c),v in src.items())\n        lost=sum(c+shift>=w for r,c in src)\n        candidates.append(((matches,-bad,-conflicts,-lost,-abs(shift-(w+1)//2)),shift))\n    shift=max(candidates)[1]\n    out=[row[:] for row in grid]\n    for (r,c),v in src.items():\n        if c+shift<w: out[r][c+shift]=v\n    return out",
