    "program_source": "def transform(grid):\n    H,W=len(grid),len(grid[0])\n    candidates=[]\n    for h in range(1,H+1):\n        if H%h: continue\n        for w in range(1,W+1):\n            if W%w or H//h* (W//w)<2: continue\n            templates={}\n            ok=True\n            for r in range(0,H,h):\n                for c in range(0,W,w):\n                    parity=(r//h+c//w)%2\n                    tile=tuple(tuple(row[c:c+w]) for row in grid[r:r+h])\n                    if parity in templates and templates[parity]!=tile:\n                        ok=False;break\n                    templates[parity]=tile\n                if not ok:break\n            if not ok or len(templates)!=2: continue\n            counts=[len(set(x for row in templates[p] for x in row)) for p in (0,1)]\n            if min(counts)==1 and max(counts)>1:\n                candidates.append((h*w,templates[counts.index(max(counts))]))\n    if candidates:\n        return [list(row) for row in min(candidates,key=lambda x:x[0])[1]]\n    return [row[:] for row in grid]\n",
