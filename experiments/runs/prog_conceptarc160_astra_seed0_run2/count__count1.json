    "program_source": "def transform(grid):\n    h=len(grid); w=len(grid[0]); seen=set(); n=0\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            n+=1; color=grid[r][c]; seen.add((r,c)); stack=[(r,c)]\n            while stack:\n                a,b=stack.pop()\n                for dr in (-1,0,1):\n                    for dc in (-1,0,1):\n                        x,y=a+dr,b+dc\n                        if 0<=x<h and 0<=y<w and (x,y) not in seen and grid[x][y]==color:\n                            seen.add((x,y)); stack.append((x,y))\n    return [[4 if i<n else 0 for i in range(6)]]",
