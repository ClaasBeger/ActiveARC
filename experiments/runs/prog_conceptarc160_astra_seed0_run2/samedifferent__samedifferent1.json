    "program_source": "def transform(grid):\n    from collections import Counter\n    h,w=len(grid),len(grid[0])\n    seen=set(); objs=[]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            color=grid[r][c]; cells=[]; todo=[(r,c)]; seen.add((r,c))\n            while todo:\n                y,x=todo.pop(); cells.append((y,x))\n                for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n                    a,b=y+dy,x+dx\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==color:\n                        seen.add((a,b)); todo.append((a,b))\n            y0=min(y for y,x in cells); x0=min(x for y,x in cells)\n            key=tuple(sorted((y-y0,x-x0) for y,x in cells))\n            objs.append((key,cells))\n    counts=Counter(k for k,c in objs)\n    out=[row[:] for row in grid]\n    for k,cells in objs:\n        if counts[k]==1:\n            for y,x in cells: out[y][x]=0\n    return out",
