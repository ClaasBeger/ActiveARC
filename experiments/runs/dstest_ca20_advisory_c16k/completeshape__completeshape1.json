g[i][j]=col\\n    return g\"},{\"nl\":\"For each row, fill zeros between the leftmost and rightmost non-zero cells with the leftmost non-zero color.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    for i,row in enumerate(g):\\n        nz=[j for j,v in enumerate(row) if v!=0]\\n        if len(nz)>=2:\\n            col=row[nz[0]]\\n            for j in range(nz[0],nz[-1]+1):\\n                if g[i][j]==0: g[i][j]=col\\n    return g\"},{\"nl\":\"For each row, fill zeros between the leftmost and rightmost non-zero cells with the rightmost non-zero color.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    for i,row in enumerate(g):\\n        nz=[j for j,v in enumerate(row) if v!=0]\\n        if len(nz)>=2:\\n            col=row[nz[-1]]\\n            for j in range(nz[0],nz[-1]+1):\\n                if g[i][j]==0: g[i][j]=col\\n    return g\"},{\"nl\":\"Fill only zero cells enclosed on left, right, and top by non-zero cells, using the row's non-zero color.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    R=len(g); C=len(g[0])\\n    for i in range(R):\\n        nz=[j for j in range(C) if g[i][j]!=0]\\n        if not nz: continue\\n        col=g[i][nz[0]]\\n        for j in range(C):\\n            if g[i][j]==0:\\n                left=any(g[i][k]!=0 for k in range(j))\\n                right=any(g[i][k]!=0 for k in range(j+1,C))\\n                up=any(g[k][j]!=0 for k in range(i))\\n                if left and right and up:\\n                    g[i][j]=col\\n    return g\"},{\"nl\":\"Complete the bounding box of non-zero cells, filling all gaps with the color of the top-left non-zero cell.\",\"code\":\"def transform(grid):\\n    g=[row[:] for row in grid]\\n    R=len(g); C=len(g[0])\\n    rows=[i for i in range(R) if any(g[i][j]!=0 for j in range(C))]\\n    cols=[j for j in range(C) if any(g[i][j]!=0 for i in range(R))]\\n    if not rows or not cols: return g\\n    r0,r1=min(rows),max(rows); c0,c1=mi