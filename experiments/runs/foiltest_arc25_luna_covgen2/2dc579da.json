          {
            "arguments": "{\"code\":\"import random\\n\\ndef generate(rng):\\n    # Grids with a mostly-zero background, a compact connected shape in color 2,\\n    # and scattered color-1 cells around/within its bounding area.\\n    h = rng.randint(2, 6)\\n    w = rng.randint(2, 6)\\n    g = [[0 for _ in range(w)] for _ in range(h)]\\n    # grow a connected color-2 object from a random seed\\n    r, c = rng.randrange(h), rng.randrange(w)\\n    cells = {(r, c)}\\n    for _ in range(rng.randint(1, max(1, (h*w)//2))):\\n        rr, cc = rng.choice(tuple(cells))\\n        dr, dc = rng.choice([(1,0),(-1,0),(0,1),(0,-1)])\\n        nr, nc = rr+dr, cc+dc\\n        if 0 <= nr < h and 0 <= nc < w:\\n            cells.add((nr,nc))\\n    for rr,cc in cells: g[rr][cc] = 2\\n    # add a few color-1 cells, preferentially adjacent to the object\\n    candidates = [(rr,cc) for rr in range(h) for cc in range(w) if (rr,cc) not in cells]\\n    rng.shuffle(candidates)\\n    for rr,cc in candidates[:rng.randint(0, max(1, min(len(candidates), 4)))]:\\n        g[rr][cc] = 1\\n    return g\"}",
