            "arguments": "{\"code\":\"def transform(grid):\\n    out=[row[:] for row in grid]\\n    pts=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v==1]\\n    if len(pts)<2: return out\\n    pts.sort()\\n    # infer step from consecutive points (ordered along increasing row)\\n    pts.sort(key=lambda p:p[0])\\n    dr=pts[1][0]-pts[0][0]; dc=pts[1][1]-pts[0][1]\\n    if dr==0: return out\\n    # extend in the forward direction from the last marker\\n    r,c=pts[-1]\\n    H=len(grid); W=len(grid[0])\\n    while True:\\n        r+=dr; c+=dc\\n        if not (0<=r<H and 0<=c<W): break\\n        if out[r][c]==0: out[r][c]=2\\n    return out\"}",
