          {
            "arguments": "{\"code\":\"import random\\n\\ndef generate(rng):\\n    n=10\\n    grid=[[0]*n for _ in range(n)]\\n    # Create three colored pairs whose endpoints lie on diagonals, with sparse\\n    # input showing only endpoints. Keep segments mostly separated.\\n    colors=[2,3,9]\\n    candidates=[]\\n    for r in range(n):\\n        for c in range(n):\\n            for dr,dc in [(1,1),(1,-1)]:\\n                maxk=min((n-1-r)//dr, (n-1-c)//dc) if dc==1 else min((n-1-r)//dr,c//(-dc))\\n                for k in range(2,maxk+1):\\n                    candidates.append((r,c,r+dr*k,c+dc*k))\\n    rng.shuffle(candidates)\\n    chosen=[]\\n    used=set()\\n    for color in colors:\\n        for a,b,c,d in candidates:\\n            pts={(a,b),(c,d)}\\n            if pts & used: continue\\n            # avoid crossing/interior collisions with existing selected lines\\n            line={(a+i*(1 if c>a else -1), b+i*(1 if d>b else -1)) for i in range(abs(c-a)+1)}\\n            if line & used: continue\\n            chosen.append((color,a,b,c,d)); used |= pts; break\\n    for color,a,b,c,d in chosen:\\n        grid[a][b]=color; grid[c][d]=color\\n    return grid\"}",
