          {
            "arguments": "{\"code\":\"import random\\n\\ndef generate(rng):\\n    H, W = 11, 7\\n    g = [[0 for _ in range(W)] for _ in range(H)]\\n    # Sparse encoding: color 2 marks the endpoints/columns of a vertical band;\\n    # colors 1 and 3 mark rows that become horizontal stripes.\\n    c1 = rng.randrange(0, W)\\n    c2 = rng.randrange(0, W)\\n    r2a = rng.randrange(0, 4)\\n    r2b = rng.randrange(4, H)\\n    g[r2a][c1] = 2\\n    g[r2b][c2] = 2\\n    # Put several distinct stripe markers, avoiding the 2-marker rows.\\n    available = [r for r in range(H) if r not in (r2a, r2b)]\\n    rng.shuffle(available)\\n    for color, count in [(1, rng.randint(1, 2)), (3, rng.randint(1, 2))]:\\n        for r in available[:count]:\\n            g[r][rng.randrange(W)] = color\\n        available = available[count:]\\n    return g\"}",
