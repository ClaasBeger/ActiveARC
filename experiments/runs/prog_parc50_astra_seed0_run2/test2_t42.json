    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    from collections import Counter\n    h=len(grid); w=len(grid[0]); m=w//2\n    bands=[]; start=0; colors=set()\n    for r in range(h):\n        cs=set(grid[r][:m])\n        if len(colors|cs)>2:\n            bands.append((start,r,colors)); start=r; colors=set()\n        colors |= cs\n    bands.append((start,h,colors))\n    palettes=[]\n    for a,b,cs in bands:\n        cnt=Counter(v for row in grid[a:b] for v in row[:m])\n        palettes.append([v for v,n in cnt.most_common()])\n    out=[row[:] for row in grid]\n    for i,(a,b,cs) in enumerate(bands):\n        p=palettes[i]; q=palettes[(i+1)%len(palettes)]\n        mp={v:q[min(j,len(q)-1)] for j,v in enumerate(p)}\n        for r in range(a,b):\n            for c in range(m):out[r][m+c]=mp[grid[r][c]]\n    return out",
