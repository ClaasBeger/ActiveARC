    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    n,m=h//2,w//2\n    out=[row[:] for row in grid]\n    base=[[0]*m for _ in range(n)]\n    for a in range(2):\n        for b in range(2):\n            for r in range(n):\n                for c in range(m):\n                    v=grid[a*(n+1)+r][b*(m+1)+c]\n                    if v!=0:\n                        x,y=(n-1-r,m-1-c) if (a+b)%2 else (r,c)\n                        base[x][y]=v\n    for a in range(2):\n        for b in range(2):\n            for r in range(n):\n                for c in range(m):\n                    x,y=(n-1-r,m-1-c) if (a+b)%2 else (r,c)\n                    out[a*(n+1)+r][b*(m+1)+c]=base[x][y]\n    return out",
