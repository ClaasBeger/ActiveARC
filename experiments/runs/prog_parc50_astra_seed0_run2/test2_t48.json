    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\n    seen=set(); comps=[]\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c] and (r,c) not in seen:\n                comp=[]; q=[(r,c)]; seen.add((r,c))\n                for y,x in q:\n                    comp.append((y,x))\n                    for a,b in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                        if 0<=a<h and 0<=b<w and grid[a][b] and (a,b) not in seen:\n                            seen.add((a,b));q.append((a,b))\n                comps.append(comp)\n    main=max(comps,key=len)\n    maincolors={grid[r][c] for r,c in main}\n    colors={v for row in grid for v in row if v}\n    missing=colors-maincolors\n    if not missing: return out\n    fill=min(missing)\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 and (r,c) not in seen:\n                q=[(r,c)];seen.add((r,c));edge=False\n                for y,x in q:\n                    if y==0 or x==0 or y==h-1 or x==w-1: edge=True\n                    for a,b in ((y-1,x),(y+1,x),(y,x-1),(y,x+1)):\n                        if 0<=a<h and 0<=b<w and grid[a][b]==0 and (a,b) not in seen:\n                            seen.add((a,b));q.append((a,b))\n                if not edge:\n                    for y,x in q:out[y][x]=fill\n    return out",
