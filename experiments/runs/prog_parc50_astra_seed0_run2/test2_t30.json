          {
            "arguments": "{\"code\":\"def transform(grid):\\n    from collections import Counter\\n    h,w=len(grid),len(grid[0])\\n    out=[r[:] for r in grid]\\n    rs=[r for r in range(h) if len(set(grid[r]))==1 and grid[r][0]!=0]\\n    cs=[c for c in range(w) if len({grid[r][c] for r in range(h)})==1 and grid[0][c]!=0]\\n    if rs:\\n        bounds=[-1]+rs+[h]\\n        panels=[(a+1,b,0,w) for a,b in zip(bounds,bounds[1:]) if b>a+1]\\n    elif cs:\\n        bounds=[-1]+cs+[w]\\n        panels=[(0,h,a+1,b) for a,b in zip(bounds,bounds[1:]) if b>a+1]\\n    else:return out\\n    known=[]\\n    colors=[]\\n    for i,(a,b,c,d) in enumerate(panels):\\n        pts=[(r,t) for r in range(a,b) for t in range(c,d) if grid[r][t]!=0]\\n        if pts:\\n            ds=[abs(r-(a+b-1)/2)+abs(t-(c+d-1)/2) for r,t in pts]\\n            rad=Counter(ds).most_common(1)[0][0]\\n            known.append((i,rad))\\n            colors.extend(grid[r][t] for r,t in pts)\\n    if not colors:return out\\n    color=Counter(colors).most_common(1)[0][0]\\n    slope=1\\n    if len(known)>1:\\n        slope=(known[-1][1]-known[0][1])/(known[-1][0]-known[0][0])\\n    offset=known[0][1]-slope*known[0][0]\\n    for i,(a,b,c,d) in enumerate(panels):\\n        if any(grid[r][t]!=0 for r in range(a,b) for t in range(c,d)):continue\\n        for r in range(a,b):\\n            for t in range(c,d):\\n                if abs(abs(r-(a+b-1)/2)+abs(t-(c+d-1)/2)-(offset+slope*i))<1e-8:out[r][t]=color\\n    return out\"}",
