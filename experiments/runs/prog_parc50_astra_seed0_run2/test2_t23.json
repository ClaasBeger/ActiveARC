    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0]); out=[[0]*w for _ in range(h)]\n    seen=set(); groups={}\n    for r in range(h):\n        for c in range(w):\n            color=grid[r][c]\n            if not color or (r,c) in seen: continue\n            comp=[]; stack=[(r,c)]; seen.add((r,c))\n            while stack:\n                x,y=stack.pop(); comp.append((x,y))\n                for a,b in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==color:\n                        seen.add((a,b)); stack.append((a,b))\n            groups.setdefault(color,[]).append(sorted(comp))\n    for comps in groups.values():\n        for i,A in enumerate(comps):\n            for B in comps[i+1:]:\n                best=None; path=[]\n                for r,c in A:\n                    for x,y in B:\n                        if r!=x and c!=y: continue\n                        d=abs(r-x)+abs(c-y)\n                        if best is None or d<best:\n                            best=d\n                            if r==x: path=[(r,k) for k in range(min(c,y)+1,max(c,y))]\n                            else: path=[(k,c) for k in range(min(r,x)+1,max(r,x))]\n                for r,c in path: out[r][c]=5\n    return out",
