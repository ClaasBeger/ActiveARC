    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    a=[r[:] for r in grid]\n    h,w=len(a),len(a[0])\n    reds=[(r,c) for r in range(h) for c in range(w) if a[r][c]==9]\n    greys=[(r,c) for r in range(h) for c in range(w) if a[r][c]==5]\n    if not reds or not greys:return a\n    r,c=reds[0]\n    y,x=min(greys,key=lambda p:(p[0]-r)**2+(p[1]-c)**2)\n    dr=(y>r)-(y<r); dc=(x>c)-(x<c)\n    for y,x in greys+reds:a[y][x]=0\n    seen=set()\n    while (r,c,dr,dc) not in seen:\n        seen.add((r,c,dr,dc))\n        if not 0<=r+dr<h:dr=-dr\n        if not 0<=c+dc<w:dc=-dc\n        nr,nc=r+dr,c+dc\n        if not (0<=nr<h and 0<=nc<w):break\n        if a[nr][nc]!=0:break\n        r,c=nr,nc\n    a[r][c]=9\n    return a",
