            "arguments": "{\"code\":\"def transform(grid):\\n import math\\n h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]; seen=set(); objs=[]\\n for r in range(h):\\n  for c in range(w):\\n   if grid[r][c] and (r,c) not in seen:\\n    color=grid[r][c]; cells={(r,c)}; seen.add((r,c)); stack=[(r,c)]\\n    while stack:\\n     x,y=stack.pop()\\n     for a,b in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):\\n      if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==color:\\n       cells.add((a,b));seen.add((a,b));stack.append((a,b))\\n    objs.append((color,cells))\\n def norm(s):\\n  x=min(a for a,b in s);y=min(b for a,b in s)\\n  return frozenset((a-x,b-y) for a,b in s)\\n def variants(s):\\n  s=norm(s);v=set()\\n  for _ in range(4):\\n   v.add(norm(s));s={(b,-a) for a,b in s}\\n  return v\\n for i,(color,cells) in enumerate(objs):\\n  options=[]\\n  for j,(other,shape) in enumerate(objs):\\n   if i==j:continue\\n   n=math.isqrt(len(cells)+len(shape))\\n   if n*n!=len(cells)+len(shape):continue\\n   vs=variants(shape)\\n   r0=min(a for a,b in cells);r1=max(a for a,b in cells);c0=min(b for a,b in cells);c1=max(b for a,b in cells)\\n   for x in range(max(0,r1-n+1),min(r0,h-n)+1):\\n    for y in range(max(0,c1-n+1),min(c0,w-n)+1):\\n     missing={(a,b) for a in range(x,x+n) for b in range(y,y+n)}-cells\\n     if missing and all(grid[a][b]==0 for a,b in missing) and norm(missing) in vs:\\n      options.append((other,missing))\\n  if options:\\n   other,missing=options[0]\\n   for a,b in missing:out[a][b]=other\\n return out\"}",
