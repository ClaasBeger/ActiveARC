          {
            "arguments": "{\"code\":\"def transform(grid):\\n    from collections import deque\\n    h,w=len(grid),len(grid[0]); out=[r[:] for r in grid]\\n    nodes=[]\\n    for r in range(1,h-1):\\n        for c in range(1,w-1):\\n            if all(grid[r+dr][c+dc]==1 for dr,dc in [(-1,-1),(-1,1),(1,-1),(1,1)]) and grid[r][c] in (0,4,8):\\n                nodes.append((r,c))\\n    start=next((p for p in nodes if grid[p[0]][p[1]]==4),None)\\n    goal=next((p for p in nodes if grid[p[0]][p[1]]==8),None)\\n    if start is None or goal is None: return out\\n    prev={start:None}; q=deque([start])\\n    while q:\\n        p=q.popleft()\\n        if p==goal: break\\n        r,c=p\\n        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:\\n            if grid[r+dr][c+dc]!=2: continue\\n            cand=[n for n in nodes if (dc==0 and n[1]==c and (n[0]-r)*dr>0) or (dr==0 and n[0]==r and (n[1]-c)*dc>0)]\\n            if not cand: continue\\n            n=min(cand,key=lambda n:abs(n[0]-r)+abs(n[1]-c))\\n            if n not in prev:\\n                prev[n]=(p,(r+dr,c+dc));q.append(n)\\n    if goal not in prev: return out\\n    p=goal\\n    while p!=start:\\n        par,edge=prev[p];out[edge[0]][edge[1]]=5;p=par\\n    out[start[0]][start[1]]=0\\n    out[goal[0]][goal[1]]=4\\n    return out\"}",
