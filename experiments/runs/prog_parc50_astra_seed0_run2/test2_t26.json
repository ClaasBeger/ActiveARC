    "verifier_slot": "custom",
    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    pts=[(r,c) for r in range(h) for c in range(w) if grid[r][c]==8]\n    if not pts: return out\n    ds={r-c for r,c in pts}; ss={r+c for r,c in pts}\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0: continue\n            if len(ds)==1:\n                d=next(iter(ds)); a,b=c+d,r-d\n            elif len(ss)==1:\n                s=next(iter(ss)); a,b=s-c,s-r\n            elif len({r for r,c in pts})==1:\n                a,b=2*pts[0][0]-r,c\n            elif len({c for r,c in pts})==1:\n                a,b=r,2*pts[0][1]-c\n            else: continue\n            if 0<=a<h and 0<=b<w and out[a][b]==0: out[a][b]=grid[r][c]\n    return out",
