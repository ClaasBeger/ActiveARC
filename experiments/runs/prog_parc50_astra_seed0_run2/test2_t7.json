    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            if not grid[r][c] or (r,c) in seen: continue\n            comp={(r,c)}; seen.add((r,c)); todo=[(r,c)]\n            while todo:\n                y,x=todo.pop()\n                for dy in (-1,0,1):\n                    for dx in (-1,0,1):\n                        a,b=y+dy,x+dx\n                        if 0<=a<h and 0<=b<w and grid[a][b] and (a,b) not in seen:\n                            seen.add((a,b));comp.add((a,b));todo.append((a,b))\n            if any(grid[y][x]==8 for y,x in comp):\n                for y,x in comp:\n                    if grid[y][x]==8: continue\n                    for dy,dx in ((1,0),(-1,0),(0,1),(0,-1)):\n                        a,b=y+dy,x+dx\n                        if 0<=a<h and 0<=b<w and grid[a][b]==0: out[a][b]=8\n    return out",
