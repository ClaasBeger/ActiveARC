    "program_source": "def transform(grid):\n    def candidates(g):\n        h,w=len(g),len(g[0]); out=[]\n        for l in range(w-2):\n            c=g[0][l]\n            if not c: continue\n            for r in range(l+2,w):\n                if g[0][r]!=c: continue\n                for b in range(1,h):\n                    if g[b][l]!=c or g[b][r]!=c: break\n                    if all(g[b][x]==c for x in range(l,r+1)):\n                        data=[row[l+1:r] for row in g[:b]]\n                        if any(v!=c for row in data for v in row):\n                            out.append((r-l-1,b,data))\n        return out\n    choices=[]\n    for trans in (False,True):\n        g=[list(x) for x in zip(*grid)] if trans else grid\n        a=candidates(g); b=candidates(g[::-1])\n        for w,d,x in a:\n            for ww,dd,y in b:\n                if w==ww and d+dd+2<=len(g):\n                    z=y[::-1]+x\n                    score=w*(d+dd)\n                    if trans: z=[list(row) for row in zip(*z)]\n                    choices.append((score,z))\n    if not choices: return [r[:] for r in grid]\n    return max(choices,key=lambda x:x[0])[1]\n",
