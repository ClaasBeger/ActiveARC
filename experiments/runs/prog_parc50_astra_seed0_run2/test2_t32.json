    "program_source": "def transform(grid):\n    a=[r[:] for r in grid]\n    h,w=len(a),len(a[0])\n    bars=[i for i,r in enumerate(a) if all(v==5 for v in r)]\n    if not bars:\n        t=[list(x) for x in zip(*a)]\n        if any(all(v==5 for v in r) for r in t):\n            return [list(x) for x in zip(*transform(t))]\n        return a\n    b=bars[0]\n    before=list(range(b)); after=list(range(b+1,h))\n    def density(ids):\n        return sum(v!=0 for i in ids for v in a[i])/max(1,len(ids))\n    ref,target=(before,after) if density(before)>=density(after) else (after,before)\n    templates=[]\n    for i in ref:\n        if a[i] not in templates: templates.append(a[i][:])\n    for i in target:\n        row=a[i]\n        if not any(row): continue\n        matches=[r for r in templates if all(v==0 or v==r[j] for j,v in enumerate(row))]\n        if matches:\n            a[i]=matches[0][:]\n    return a",
