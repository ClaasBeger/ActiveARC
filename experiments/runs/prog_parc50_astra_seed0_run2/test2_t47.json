    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    rows=[i for i,row in enumerate(grid) if len(set(row))==1 and row[0]==5]\n    if rows:\n        k=rows[0]; a=grid[:k]; b=grid[k+1:]\n    else:\n        cols=[j for j in range(w) if all(grid[i][j]==5 for i in range(h))]\n        k=cols[0]; a=[r[:k] for r in grid]; b=[r[k+1:] for r in grid]\n    shared=set(x for r in a for x in r)&set(x for r in b for x in r)\n    bg=6 if 6 in shared else next(iter(shared))\n    return [[(x if y==bg else y) if (x==bg)!=(y==bg) else 0 for x,y in zip(r,s)] for r,s in zip(a,b)]",
