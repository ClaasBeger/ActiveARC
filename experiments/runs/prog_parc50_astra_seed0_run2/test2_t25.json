    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[r[:] for r in grid]\n    seen=set()\n    for r in range(h):\n        for c in range(w):\n            if grid[r][c]==0 or (r,c) in seen: continue\n            comp=[(r,c)]; seen.add((r,c))\n            for x,y in comp:\n                for a,b in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==grid[r][c]:\n                        seen.add((a,b)); comp.append((a,b))\n            if len(comp)%3:\n                for a,b in comp: out[a][b]=0\n    return out",
