    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[[0]*w for _ in range(h)]\n    for r in range(1,h):\n        marker=grid[r][0]\n        shift=1 if marker==2 else -1 if marker==3 else 0\n        for c in range(1,w):\n            v=grid[r][c]\n            if v:\n                if marker in (2,3) and grid[0][c]:\n                    v=grid[0][c]\n                nc=c+shift\n                if 0<=nc<w: out[r][nc]=v\n    return out",
