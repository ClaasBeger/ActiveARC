    "program_source": "def transform(grid):\n    walls=[(r,c) for r,row in enumerate(grid) for c,v in enumerate(row) if v==5]\n    top=min(r for r,c in walls); bottom=max(r for r,c in walls)\n    left=min(c for r,c in walls); right=max(c for r,c in walls)\n    h=bottom-top; w=right-left-1\n    out=[[0]*w for _ in range(h)]\n    for c in range(left+1,right):\n        n=sum(grid[r][c]==2 for r in range(len(grid)))\n        for k in range(min(n,h)):\n            out[h-1-k][c-left-1]=2\n    return out",
