    "program_source": "def transform(grid):\n    h,w=len(grid),len(grid[0])\n    out=[[0]*w for _ in range(h)]\n    seen=set()\n    directions={3:(-1,-1),6:(-1,1),4:(1,-1),8:(1,1)}\n    for r in range(h):\n        for c in range(w):\n            color=grid[r][c]\n            if not color or (r,c) in seen: continue\n            seen.add((r,c)); cells=[(r,c)]; stack=[(r,c)]\n            while stack:\n                y,x=stack.pop()\n                for dy,dx in [(1,0),(-1,0),(0,1),(0,-1)]:\n                    a,b=y+dy,x+dx\n                    if 0<=a<h and 0<=b<w and (a,b) not in seen and grid[a][b]==color:\n                        seen.add((a,b));cells.append((a,b));stack.append((a,b))\n            dy,dx=directions.get(color,(0,0))\n            n=0\n            if dy or dx:\n                while all(0<=y+(n+1)*dy<h and 0<=x+(n+1)*dx<w for y,x in cells): n+=1\n            for y,x in cells: out[y+n*dy][x+n*dx]=color\n    return out",
