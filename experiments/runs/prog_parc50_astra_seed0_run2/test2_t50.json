          {
            "arguments": "{\"code\":\"def transform(grid):\\n    h,w=len(grid),len(grid[0])\\n    nodes={(r,c) for r in range(h) for c in range(w) if grid[r][c] in (3,5)}\\n    starts=[p for p in nodes if grid[p[0]][p[1]]==3]\\n    nxt={}\\n    for r,c in nodes:\\n        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):\\n            rr,cc=r+dr,c+dc\\n            if 0<=rr<h and 0<=cc<w and grid[rr][cc]==7:\\n                while 0<=rr<h and 0<=cc<w:\\n                    if (rr,cc) in nodes:\\n                        nxt[(r,c)]=(rr,cc)\\n                        break\\n                    rr+=dr; cc+=dc\\n    out=[row[:] for row in grid]\\n    for start in starts:\\n        path=[]; seen={}; p=start\\n        while p not in seen and p in nxt:\\n            seen[p]=len(path); path.append(p); p=nxt[p]\\n        if p not in seen:\\n            continue\\n        out[start[0]][start[1]]=5\\n        for a in path[seen[p]:]:\\n            b=nxt[a]\\n            dr=(b[0]>a[0])-(b[0]<a[0]); dc=(b[1]>a[1])-(b[1]<a[1])\\n            r,c=a\\n            out[r][c]=3\\n            while (r,c)!=b:\\n                r+=dr; c+=dc; out[r][c]=3\\n    return out\"}",
