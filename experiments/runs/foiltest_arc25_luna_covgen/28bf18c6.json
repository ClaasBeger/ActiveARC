            "arguments": "{\"code\":\"import random\\n\\ndef generate(rng):\\n    # Sparse grid containing one compact colored pattern in its upper/left area;\\n    # vary canvas, bounding-box dimensions, color, and pattern.\\n    H = rng.randint(5, 12); W = rng.randint(5, 12)\\n    h = rng.randint(2, min(5, H-1)); w = rng.randint(2, min(5, W-1))\\n    color = rng.randint(1, 9)\\n    top = rng.randint(0, H-h); left = rng.randint(0, W-w)\\n    grid = [[0]*W for _ in range(H)]\\n    # ensure a connected-ish nonempty object, with occasional holes\\n    cells = {(0,0)}\\n    for r in range(h):\\n        for c in range(w):\\n            if rng.random() < 0.55:\\n                cells.add((r,c))\\n    for r,c in cells:\\n        grid[top+r][left+c] = color\\n    return grid\"}",
